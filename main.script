# --- LimitedTextField ---
class LimitedTextField(MDTextField):
    def __init__(self, max_length=100, **kwargs):
        super().__init__(**kwargs)
        self.max_length = max_length

    def insert_text(self, substring, from_undo=False):
        if len(self.text) >= self.max_length:
            return
        if len(self.text) + len(substring) > self.max_length:
            substring = substring[:self.max_length - len(self.text)]
        super().insert_text(substring, from_undo=from_undo)

class CustomMDBoxLayout(MDBoxLayout):
    opacity = NumericProperty(0)

    def add_widget(self, widget, *args, **kwargs):
        if widget.parent: widget.parent.remove_widget(widget)
        super().add_widget(widget, *args, **kwargs)
        widget.opacity = self.opacity
        self.bind(opacity=lambda instance, value: setattr(widget, 'opacity', value))

# ---------- Utils ----------

def stroke_in_viewport(stroke, vp):
    min_x = min(p[0] for p in stroke["points"])
    max_x = max(p[0] for p in stroke["points"])
    min_y = min(p[1] for p in stroke["points"])
    max_y = max(p[1] for p in stroke["points"])

    vx1, vy1, vx2, vy2 = vp
    return not (max_x < vx1 or min_x > vx2 or max_y < vy1 or min_y > vy2)


# ---------- Draw Board ----------
class InfiniteDrawBoard(Widget):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)

        self.strokes = []
        self.current_stroke = None

        self.cam_x = 0
        self.cam_y = 0

        self.active_touches = {}   # touch.id -> touch
        self.dragging = False
        self.last_touch = None     # cho chuột phải
        self.last_center = None    # cho 2 ngón

    # ---------- helpers ----------

    def get_touch_center(self):
        if len(self.active_touches) < 2:
            return None

        xs = [t.x for t in self.active_touches.values()]
        ys = [t.y for t in self.active_touches.values()]
        return (sum(xs) / len(xs), sum(ys) / len(ys))

    # ---------- Touch ----------

    def on_touch_down(self, touch):
        if not self.collide_point(*touch.pos):
            return False

        # 🖱 Chuột phải drag (GIỮ NGUYÊN)
        if touch.button == "right":
            self.dragging = True
            self.last_touch = touch.pos
            return True

        # 👆 Touch (cảm ứng)
        touch.grab(self)
        self.active_touches[touch.id] = touch

        # ✌️ 2 ngón → drag
        if len(self.active_touches) == 2:
            self.dragging = True
            self.last_center = self.get_touch_center()
            return True

        # 👆 1 ngón → vẽ
        if len(self.active_touches) == 1:
            wx = touch.x + self.cam_x
            wy = touch.y + self.cam_y
            self.current_stroke = {
                "points": [(wx, wy)],
                "width": 2,
                "color": (0, 0, 0, 1)
            }
            return True

        return True

    def on_touch_move(self, touch):
        # 🖱 Chuột phải drag
        if self.dragging and touch.button == "right":
            dx = touch.x - self.last_touch[0]
            dy = touch.y - self.last_touch[1]
            self.cam_x -= dx
            self.cam_y -= dy
            self.last_touch = touch.pos
            self.schedule_redraw()
            return True

        # ✌️ Drag bằng 2 ngón
        if self.dragging and len(self.active_touches) >= 2:
            center = self.get_touch_center()
            if center and self.last_center:
                dx = center[0] - self.last_center[0]
                dy = center[1] - self.last_center[1]
                self.cam_x -= dx
                self.cam_y -= dy
                self.last_center = center
                self.schedule_redraw()
            return True

        # 👆 Vẽ bằng 1 ngón
        if len(self.active_touches) == 1 and self.current_stroke:
            wx = touch.x + self.cam_x
            wy = touch.y + self.cam_y
            self.current_stroke["points"].append((wx, wy))
            self.schedule_redraw()
            return True

        return True

    def on_touch_up(self, touch):
        # 🖱 Chuột phải
        if touch.button == "right":
            self.dragging = False
            self.last_touch = None
            return True

        # 👆 Touch
        if touch.grab_current is self:
            touch.ungrab(self)
            self.active_touches.pop(touch.id, None)

        # Kết thúc drag 2 ngón
        if len(self.active_touches) < 2:
            self.dragging = False
            self.last_center = None

        # Kết thúc stroke
        if len(self.active_touches) == 0 and self.current_stroke:
            self.strokes.append(self.current_stroke)
            self.current_stroke = None
            self.schedule_redraw()

        return True

    # ---------- Render ----------

    def schedule_redraw(self):
        Clock.unschedule(self.redraw)
        Clock.schedule_once(self.redraw, 0)

    def flatten_points(self, points):
        out = []
        for x, y in points:
            out.extend([x, y])
        return out

    def redraw(self, *args):
        self.canvas.clear()

        vw, vh = Window.size
        viewport = (
            self.cam_x,
            self.cam_y,
            self.cam_x + vw,
            self.cam_y + vh
        )

        with self.canvas:
            PushMatrix()
            Translate(-self.cam_x, -self.cam_y, 0)

            for stroke in self.strokes:
                if stroke_in_viewport(stroke, viewport):
                    Color(*stroke["color"])
                    Line(
                        points=self.flatten_points(stroke["points"]),
                        width=stroke["width"]
                    )

            if self.current_stroke:
                Color(*self.current_stroke["color"])
                Line(
                    points=self.flatten_points(self.current_stroke["points"]),
                    width=self.current_stroke["width"]
                )

            PopMatrix()


class OverlayContainer(MDFloatLayout):
    pass

# --- ChatApp ---
class ChatApp(MDApp):
    def build(self):
        self.app_in_foreground = True

        self.icon="resources/img/Icon.png"
        self.title="luv"

        self.uid_button=MDFillRoundFlatButton(text="Menu", on_release=self.menu_open, md_bg_color=btn, text_color='white', pos_hint={"center_y": 0.5})
        self.last_date = None
        self.lookup = False
        self.lookup_date = datetime.strftime(datetime.now(), "%d/%m/%Y")
        if os.path.exists("uid.txt"):
            with open("uid.txt", "r") as f:
                self.user_id = f.read().strip()
            self.uid_button.text = self.user_id
        else:
            self.user_id = None
            Clock.schedule_once(lambda dt: self.show_uid_dialog())

        # Main layout with improved spacing and styling
        layout = MDBoxLayout(orientation="vertical", padding=[dp(20), dp(10), dp(20), dp(35)], spacing=dp(10), md_bg_color=bg)
        
        # Top bar with title
        self.top_bar = MDBoxLayout(size_hint=(1, None), height=dp(50), padding=dp(5), spacing=dp(10))
        self.top_icon = MDFillRoundFlatButton(
            text=format_text_with_fonts("\U0001F496 ngha và hmn", True),
            theme_text_color="Custom",
            text_color=primarycolor,
            md_bg_color=bg,
            on_release=self.update
        )
        self.top_label = MDFillRoundFlatButton(
            text="\u2600 <3 \u2B50",
            theme_text_color="Custom",
            line_color=btn,
            md_bg_color=boxbg,
            text_color=primarycolor,
            font_name="resources/fonts/seguiemj.ttf",
            on_release=self.change_text
        )
        self.top_bar.add_widget(self.top_icon)
        self.top_bar.add_widget(MDBoxLayout(size_hint=(1, 1)))
        self.top_bar.add_widget(self.top_label)
        self.top_bar.add_widget(self.uid_button)
        
        # Message scroll area with better styling
        self.msg_scroll = ScrollView(do_scroll_x=False, size_hint=(1, 1))
        self.msg_list = MDBoxLayout(orientation="vertical", size_hint=(1, None), spacing=dp(10), padding=[0, dp(10), 0, dp(10)])
        self.container = OverlayContainer(size_hint=(1, None))
        self.draw_canvas = InfiniteDrawBoard()
        self.msg_list.bind(minimum_height=self.msg_list.setter('height'))
        self.msg_list.bind(height=self.sync_overlay_height)
        self.container.add_widget(self.msg_list)
        self.msg_scroll.add_widget(self.container)
        
        # Input card with rounded design
        self.input_card = MDCard(
            orientation="vertical",
            size_hint=(1, None),
            height=dp(70),
            padding=[dp(10), dp(10), dp(10), dp(10)],
            spacing=dp(10),
            radius=[dp(25), dp(25), dp(25), dp(25)],
            md_bg_color=boxbg,
            elevation=0
        )
        
        # Text input layout
        self.text_input = MDBoxLayout(size_hint=(1, None), height=dp(50), spacing=dp(5))
        self.text_input.input = LimitedTextField(
            hint_text="Viết lời iu thương vào đây nề <3",
            line_color_normal=boxbg,
            line_color_focus=boxbg,
            hint_text_color=[0.75 - i for i in primarycolor],
            hint_text_color_focus=primarycolor,
            text_color_focus=primarycolor,
            fill_color_normal=boxbg,
            mode="round",
            size_hint=(1, None),
            pos_hint={'center_y': 0.5},
            height=dp(30),
            multiline=False,
            font_name="resources/fonts/segoeui.ttf",
            on_text_validate=self.send_msg
        )
        
        self.text_input.button = MDIconButton(
            icon='send-variant',
            disabled=True,
            theme_icon_color="Custom",
            icon_color=btn,
            size_hint=(None, None),
            size=(dp(48), dp(48)),
            pos_hint={"right": 1, "bottom": 0},
            on_release=self.send_msg
        )
        
        # Assemble input components
        self.text_input.add_widget(self.text_input.input)
        self.text_input.add_widget(self.text_input.button)
        self.input_card.add_widget(self.text_input)
        
        # Bind text changes for button enable/disable
        self.text_input.input.bind(text=self.on_text_change)

        self.noti=CustomMDBoxLayout(size_hint=(1, None), height=dp(0), padding=dp(5))
        self.noti.label=MDLabel(text="Có tin nhắn mới nề <3", pos_hint={"center_y": 0.5, "bottom": 0})
        self.noti.button=MDFillRoundFlatButton(text="Đọc thui", md_bg_color=btn, theme_text_color="Custom", text_color=bg, on_release=lambda instance: self.load_messages(instance=None), disabled=True)
        self.noti.add_widget(self.noti.label)
        self.noti.add_widget(self.noti.button)

        # Assemble main layout
        layout.add_widget(self.top_bar)
        layout.add_widget(MDBoxLayout(size_hint=(1, None), md_bg_color=btn, height=dp(2), pos_hint={"center_x": 0.5}))  # Spacer
        layout.add_widget(self.noti)    
        layout.add_widget(self.msg_scroll)
        layout.add_widget(self.input_card)

        self.load_messages()
        self.listen_realtime()

        return layout
    
    def sync_overlay_height(self, *args):
        self.container.height = self.msg_list.height

    def date_picker_open(self):
        self.menu.dismiss()
        date_dialog = MDDatePicker(title_input="Nhập ngày check", title="Chọn ngày check", primary_color=menubg, accent_color=bg, selector_color=btn, text_button_color="black", input_field_background_color_focus=boxbg, input_field_background_color_normal=boxbg[:-1]+(0.25,), input_field_text_color_focus="black", text_weekday_color=btn, helper_text="", text_current_color=menubg)
        date_dialog.bind(on_save=self.load_messages)
        date_dialog.open()
    
    def menu_open(self, instance):
        menu_items = [
            {
                "text": "Mở chế độ vẽ" if not draw_mode else "Tắt chế độ vẽ",
                "text_color": primarycolor,
                "trailing_icon": "brush",
                "theme_trailing_icon_color": "Custom",
                "trailing_icon_color": primarycolor,
                "on_release": self.draw_mode
            },
            {
                "text": "Check tin nhắn cũ",
                "text_color": primarycolor,
                "trailing_icon": "history",
                "theme_trailing_icon_color": "Custom",
                "trailing_icon_color": primarycolor,
                "on_release": self.date_picker_open
            },
            {
                "text": "Đổi UID",
                "text_color": primarycolor,
                "trailing_icon": "content-copy",
                "theme_trailing_icon_color": "Custom",
                "trailing_icon_color": primarycolor,
                "on_release": self.show_uid_dialog
            }
        ]
        
        self.menu=MDDropdownMenu(
            caller=self.uid_button,
            items=menu_items,               
            ver_growth="down",
            hor_growth="left",
            md_bg_color=menubg,
            position="bottom"
        )
        self.menu.open()

    def draw_mode(self, *args):
        global draw_mode
        self.msg_scroll.do_scroll, draw_mode=[True, False] if draw_mode else [False, True]
        self.menu.dismiss()

    def show_uid_dialog(self, *args):
        try: self.menu.dismiss()
        except: pass
        self.uid_input = MDTextField(hint_text="Đặt UID nề bbi <3",
                                    font_name="resources/fonts/segoeui.ttf",
                                    line_color_normal=boxbg,
                                    line_color_focus=boxbg,
                                    hint_text_color=[0.75 - i for i in primarycolor],
                                    hint_text_color_focus=primarycolor,
                                    text_color_focus=primarycolor,
                                    fill_color_normal=boxbg,
                                    size_hint=(1, None),
                                    pos_hint={'center_y': 0.5},
                                    height=dp(30),
                                    multiline=False)
        self.dialog = MDDialog(
            title="Nhập UID",
            type="custom",
            content_cls=self.uid_input,
            buttons=[MDFillRoundFlatButton(text="OK", on_release=self.save_uid, md_bg_color=btn)],
            md_bg_color=menubg
        )
        self.dialog.open()

    def save_uid(self, *args):
        uid = self.uid_input.text.strip()
        if uid:
            self.user_id = uid
            self.uid_button.text = uid
            with open("uid.txt", "w") as f:
                f.write(uid)
            self.dialog.dismiss()

    def on_text_change(self, instance, value):
        """Enable/disable send button based on text input"""
        self.text_input.button.disabled = not value.strip()

    def change_text(self, instance):
        if instance.text=="\u2600 <3 \u2B50":
            instance.text=str((datetime.now() - datetime.strptime("26/11/2025", "%d/%m/%Y")).days) + " ngày iu"
        else: instance.text="\u2600 <3 \u2B50"

    def send_msg(self, *args):
        if not self.user_id:
            self.show_uid_dialog()
            return
        
        if self.lookup and self.lookup_date != datetime.strftime(datetime.now(), "%d/%m/%Y"):
            self.lookup=False
            self.msg_list.clear_widgets()
            self.load_messages()

        msg = self.text_input.input.text
        if msg:
            url = f"{SUPABASE_URL}/rest/v1/messages"
            data = {"sender": self.user_id, "content": msg, "created_at": time.strftime("%H:%M"), "date": time.strftime("%d/%m/%Y")}
            res = requests.post(url, headers=headers, json=data)
            if res.status_code == 201:
                self.text_input.input.text = ""
                if 'iu' in msg.lower().translate(str.maketrans('', '', '.,?!')).split(): Clock.schedule_once(lambda x: self.spawn_emoji(multi=True))
            else:
                print("Error:", res.text)

    def load_messages(self, instance=None, date_str=datetime.strftime(datetime.now(), '%d/%m/%Y'), data_range=None):
        self.lookup_date=date_str
        if not self.noti.button.disabled:
            self.noti.button.disabled=True
            collapse_vertical(self.noti)
        if instance:
            date_str=datetime.strptime(str(date_str), "%Y-%m-%d").strftime("%d/%m/%Y")
            if date_str==self.lookup_date: return
            self.lookup=True
            self.msg_list.clear_widgets()
        url = f"{SUPABASE_URL}/rest/v1/messages?select=*&date=eq.{date_str}&order=created_at.asc"
        res = requests.get(url, headers=headers)
        if res.status_code == 200:
            rows = res.json()
            if rows:
                for row in rows:
                    self.display_message(row['sender'], row['content'], row['created_at'], row['date'])
            elif datetime.strptime(date_str, "%d/%m/%Y") < datetime.now() and self.lookup_date != datetime.strftime(datetime.now(), "%d/%m/%Y"): self.display_message('ngha' if self.user_id=='hmn' else 'hmn', 'Không có tin nhắn nào cho ngày này hết ;-;', '00:00', date_str)
            elif datetime.strptime(date_str, "%d/%m/%Y") > datetime.now() or self.lookup_date == datetime.strftime(datetime.now(), "%d/%m/%Y"): self.display_message('ngha' if self.user_id=='hmn' else 'hmn', 'Mong chờ những lời iu thương của {} qaaa :3'.format('hmn' if self.user_id=='hmn' else 'ngha'), '00:00', date_str)
            Clock.schedule_once(self.scroll_to_bottom)

    def scroll_to_bottom(self, *args):        
        if self.msg_scroll.viewport_size[1] > self.msg_scroll.height:
            Animation(scroll_y=0, transition="out_quad").start(self.msg_scroll)

    def display_message(self, sender, content, timestamp, date):            
        if self.last_date==None or self.last_date != date:
            date_label = MDLabel(
                text=f"[size={int(dp(12))}]{format_text_with_fonts(date)}[/size]",
                halign="center",
                theme_text_color="Custom",
                text_color=primarycolor,
                size_hint=(1, None),
                height=dp(30),
                markup=True
            )
            self.msg_list.add_widget(date_label)
            self.last_date = date

        """Display a message with modern UI styling"""
        
        # Check if last message is from same sender within 1 minute
        should_merge = False
        if len(self.msg_list.children) > 0:
            last_widget = self.msg_list.children[0]
            if hasattr(last_widget, 'sender') and last_widget.sender == sender:
                try:
                    current_time = datetime.strptime(timestamp, "%H:%M")
                    last_time = datetime.strptime(last_widget.last_timestamp, "%H:%M")
                    time_diff = abs((current_time - last_time).total_seconds())
                    if time_diff <= 60:
                        should_merge = True
                except:
                    pass
        
        if should_merge:
            # Append to existing card
            last_widget = self.msg_list.children[0]
            msg_label = MDLabel(
                text=format_text_with_fonts(content),
                halign="left",
                theme_text_color="Custom",
                text_color=primarycolor,
                size_hint=(1, None),
                markup=True
            )
            msg_label.bind(texture_size=msg_label.setter('texture_size'))
            msg_label.bind(texture_size=msg_label.setter('size'))
            last_widget.add_widget(msg_label)
            last_widget.last_timestamp = timestamp
        else:
            # Create new card
            msg_card = MDCard(
                orientation="vertical",
                size_hint=(1, None),
                padding=[dp(10), dp(10), dp(10), dp(10)],
                spacing=dp(5),
                md_bg_color=boxbg[:-1]+(0.25,),
                radius=[dp(10), dp(10), dp(10), dp(10)],
                elevation=0,
                on_release=lambda x: self.send_emoji(pos=Window.mouse_pos)
            )
            msg_card.sender = sender
            msg_card.last_timestamp = timestamp
            
            # Message header with sender name
            header_layout = MDBoxLayout(size_hint=(1, None), height=dp(25), spacing=dp(5))
            morning = datetime.strptime("05:00", "%H:%M").time()
            evening = datetime.strptime("18:00", "%H:%M").time()
            emoji = "\u2600" if morning <= datetime.strptime(timestamp, "%H:%M").time() <= evening else "\u2B50"
            symbol = "\u2022"
            sender_label = MDLabel(
                text=f"[size={int(dp(14))}]{format_text_with_fonts(f'{sender} {symbol} {timestamp} {emoji}', True)}[/size]",
                size_hint=(1, None),
                height=dp(25),
                theme_text_color="Custom",
                text_color=primarycolor,
                font_size=dp(14),
                markup=True
            )
            header_layout.add_widget(sender_label)
            
            # Message content
            msg_label = MDLabel(
                text=format_text_with_fonts(content),
                halign="left",
                theme_text_color="Custom",
                text_color=primarycolor,
                size_hint=(1, None),
                markup=True
            )
            msg_label.bind(texture_size=msg_label.setter('texture_size'))
            msg_label.bind(texture_size=msg_label.setter('size'))
            
            msg_card.add_widget(header_layout)
            msg_card.add_widget(msg_label)
            msg_card.bind(minimum_height=msg_card.setter('height'))
            
            self.msg_list.add_widget(msg_card)

    def spawn_emoji(self, emoji="\U0001F496", pos=(0, 0), multi=False):
        if not multi:
            label = MDLabel(
                text=format_text_with_fonts(emoji),
                font_size="32sp",
                size_hint=(None, None),
                pos=(pos[0] - 25, pos[1] - 25),
                markup=True
            )

            Window.add_widget(label)

            # animation bay lên + mờ dần
            anim = (
                Animation(y=label.y + 60, opacity=0, duration=0.8)
            )

            anim.bind(on_complete=lambda *x: Window.remove_widget(label))
            anim.start(label)
        else:
            count = random.randint(10, 15)

            win_w, win_h = Window.size

            for _ in range(count):
                # spawn ở đáy màn hình
                x = random.randint(0, int(win_w - 50))
                y = -50

                # đích đến random toàn màn hình
                target_y = random.randint(int(win_h * 0.3), int(win_h))

                label = MDLabel(
                    text=format_text_with_fonts(emoji),
                    font_size="32sp",
                    size_hint=(None, None),
                    pos=(x, y),
                    opacity=1,
                    markup=True
                )

                Window.add_widget(label)

                # bay nhẹ lên + fade
                dy = random.randint(40, 100)

                anim = Animation(
                    y=target_y,
                    opacity=0,
                    duration=random.uniform(3, 5),
                    t="out_quad"
                )

                anim.bind(on_complete=lambda *x: Window.remove_widget(label))
                anim.start(label)
    
    def send_emoji(self, pos=(0, 0)):
        self.spawn_emoji(pos=pos)

        def send():
            w, h = Window.size
            url = f"{SUPABASE_URL}/rest/v1/reaction"
            data = {
                "sender": self.user_id,
                "x": float(pos[0]) / w,
                "y": float(pos[1]) / h,
                "created_at": time.strftime("%H:%M"),
                "date": time.strftime("%d/%m/%Y")
            }
            requests.post(url, headers=headers, json=data)

        threading.Thread(target=send).start()

    def listen_realtime(self):
        async def realtime_loop():
            while True:  # 🔁 vòng reconnect
                try:
                    url = (
                        "wss://fjhakjrxbdiowjkppgzy.supabase.co/realtime/v1/websocket"
                        f"?apikey={SUPABASE_KEY}"
                        f"&vsn=1.0.0"
                    )

                    async with websockets.connect(
                        url,
                        ssl=ssl_context,
                        additional_headers={
                            "Authorization": f"Bearer {SUPABASE_KEY}"
                        },
                        ping_interval=20,
                        ping_timeout=20
                    ) as ws:

                        # Join channel
                        join_msg = {
                            "topic": "realtime:public:messages",
                            "event": "phx_join",
                            "payload": {},
                            "ref": 1
                        }
                        await ws.send(json.dumps(join_msg))

                        await ws.send(json.dumps({
                            "topic": "realtime:public:reaction",
                            "event": "phx_join",
                            "payload": {},
                            "ref": 2
                        }))

                        while True:
                            msg = await ws.recv()
                            data = json.loads(msg)

                            record = data.get("payload", {}).get("record", {})
                            if not record:
                                continue
                            if data.get("event") == "INSERT":
                                if data["topic"] == "realtime:public:reaction":
                                    w, h = Window.size
                                    if record["sender"] != self.user_id:
                                        Clock.schedule_once(lambda dt, r=record: self.spawn_emoji(pos=(r["x"] * w, r["y"] * h)))
                                else:
                                    sender = record["sender"]
                                    content = record["content"]
                                    timestamp = record["created_at"]
                                    date = record["date"]

                                    if self.lookup and self.lookup_date != datetime.strftime(datetime.now(), "%d/%m/%Y"):
                                        self.noti.button.disabled=False
                                        expand_vertical(self.noti, dp(40))
                                    else:
                                        Clock.schedule_once(
                                            lambda dt, s=sender, c=content, t=timestamp, d=date:
                                            self.display_message(s, c, t, d)
                                        )
                                        if 'iu' in content.lower().translate(str.maketrans('', '', '.,?!')).split(): Clock.schedule_once(lambda x: self.spawn_emoji(multi=True))

                                    if sender != self.user_id and (platform!="android" or not self.app_in_foreground):
                                        notify_message(
                                            "Tin nhắn mới",
                                            f"{sender}: {content}"
                                        )
                                

                except Exception as e:
                    print("Realtime socket died:", e)
                    await asyncio.sleep(3)  # ⏳ đợi rồi tự reconnect

        def start():
            asyncio.run(realtime_loop())
        threading.Thread(target=start, daemon=True).start()

    def show_updating_dialog(self):
        self.update_dialog = MDDialog(
            title="Đang cập nhật nề",
            text="Bạn iu chờ tẹo nhó...",
            md_bg_color=menubg,
        )
        self.update_dialog.open()

    def show_update_success(self):
        dialog = MDDialog(
            title="Ầu diaa",
            text="Cập nhật xong rùi <3",
            md_bg_color=menubg,
            buttons=[
                MDFillRoundFlatButton(
                    text="OK",
                    md_bg_color=btn,
                    on_release=lambda x: dialog.dismiss()
                )
            ]
        )
        dialog.open()

    def update(self, *args):
        self.show_updating_dialog()
        def worker():
            try:
                assets=["main.script"]
                for asset in assets:
                    download_file(repo="luv", file_path=asset, name=f"temp_{asset}")

                with open("main.script", "w", encoding="utf-8") as fo, open("temp_main.script", encoding="utf-8") as fi: fo.write(fi.read())
                os.remove("temp_main.script")

                # quay về UI thread khi xong
                Clock.schedule_once(lambda dt: self.finish_update())

            except Exception as e:
                print("Update error:", e)
                Clock.schedule_once(lambda dt: self.update_dialog.dismiss())

        threading.Thread(target=worker, daemon=True).start()

    def finish_update(self):
        if hasattr(self, "update_dialog"):
            self.update_dialog.dismiss()

        self.show_update_success()

    def on_start(self):
        global build

        url = f"{SUPABASE_URL}/rest/v1/version?select=*&date=eq.{datetime.strftime(datetime.now(), '%d/%m/%Y')}&order=build.asc"
        res = requests.get(url, headers=headers)
        if res.status_code == 200:
            rows = res.json()
            print(datetime.strftime(datetime.now(), '%d/%m/%Y'))
            print(rows and rows[-1]['build'])
            if rows and rows[-1]['build']!=build:
                with open('build.txt', "w", encoding='utf-8') as fo: fo.write(rows[-1]['build'])
                Clock.schedule_once(lambda dt: self.update())

    def on_pause(self):
        print("App paused")
        self.app_in_foreground = False
        return True

    def on_resume(self):
        global message_cache
        print("App resumed")
        self.app_in_foreground = True
        message_cache = []
        return True

