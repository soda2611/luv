    start_day = StringProperty('01/01/0001')

# ---------- Utils ----------

def stroke_in_viewport(stroke, vp):
    min_x = min(p[0] for p in stroke["points"])
    max_x = max(p[0] for p in stroke["points"])
    min_y = min(p[1] for p in stroke["points"])
    max_y = max(p[1] for p in stroke["points"])

    vx1, vy1, vx2, vy2 = vp
    return not (max_x < vx1 or min_x > vx2 or max_y < vy1 or min_y > vy2)

# ---------- Draw Board ----------
class DrawCanvas(MDAnchorLayout):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)

        # stroke_id -> stroke
        self.strokes = {}

        self.current_stroke = None
        self.tool = "pen"   # "pen" | "eraser"

        self.pen_color = (0, 0, 0, 1)
        self.pen_width = 2.5
        self.eraser_radius = 18

        self.on_stroke_finished = None
        self.on_stroke_deleted = None
        self.bind(size=self._apply_flip, pos=self._apply_flip)
        Clock.schedule_once(self._apply_flip, 0)
        
    def _apply_flip(self, *args):
        self.canvas.before.clear()
        self.canvas.after.clear()

        with self.canvas.before:
            PushMatrix()
            Translate(0, self.height)
            Scale(1, -1, 1)

        with self.canvas.after:
            PopMatrix()

    # --------------------------------------------------
    # PEN
    # --------------------------------------------------

    def on_touch_down(self, touch):
        if not draw_mode: return False

        if not self.collide_point(*touch.pos):
            return False

        wx, wy = self.to_local(*touch.pos)
        wy = self.height - wy

        if self.tool == "pen":
            self._start_stroke(wx, wy)
            return True

        if self.tool == "eraser":
            self._erase_at(wx, wy)
            return True

        return False

    def on_touch_move(self, touch):
        if not draw_mode: return False

        if not self.collide_point(*touch.pos):
            return False

        wx, wy = self.to_local(*touch.pos)
        wy = self.height - wy

        if self.tool == "pen" and self.current_stroke:
            self._extend_stroke(wx, wy)
            return True

        if self.tool == "eraser":
            self._erase_at(wx, wy)
            return True

        return False

    def on_touch_up(self, touch):
        if not draw_mode: return False

        if self.tool == "pen" and self.current_stroke:
            if self.on_stroke_finished:
                self.on_stroke_finished(self.current_stroke)
        self.current_stroke = None
        return False

    def _start_stroke(self, x, y):
        stroke_id = norm_uuid_hyphen(str(uuid4().hex))

        group = InstructionGroup()
        group.add(Color(*self.pen_color))
        line = Line(
            points=[x, y],
            width=self.pen_width,
            cap="round",
            joint="round"
        )
        group.add(line)

        stroke = {
            "id": stroke_id,
            "group": group,
            "line": line,
            "points": [(x, y)],
            "bbox": [x, y, x, y],  # minx, miny, maxx, maxy
        }

        self.strokes[stroke_id] = stroke
        self.canvas.add(group)
        self.current_stroke = stroke

    def _extend_stroke(self, x, y):
        st = self.current_stroke
        st["points"].append((x, y))
        st["line"].points += [x, y]

        bx = st["bbox"]
        bx[0] = min(bx[0], x)
        bx[1] = min(bx[1], y)
        bx[2] = max(bx[2], x)
        bx[3] = max(bx[3], y)

    # --------------------------------------------------
    # ERASER
    # --------------------------------------------------

    def _erase_at(self, cx, cy):
        r = self.eraser_radius

        # copy keys để remove an toàn
        for stroke_id in list(self.strokes.keys()):
            st = self.strokes[stroke_id]
            bx = st["bbox"]

            if not self._circle_hits_bbox(cx, cy, r, bx):
                continue

            self._remove_stroke(stroke_id)

    def _remove_stroke(self, stroke_id):
        st = self.strokes.pop(norm_uuid_hyphen(stroke_id), None)
        if not st:
            return
        
        self.canvas.remove(st["group"])

        if hasattr(self, "on_stroke_deleted") and self.on_stroke_deleted:
            self.on_stroke_deleted(stroke_id)
            
    @staticmethod
    def _circle_hits_bbox(cx, cy, r, bbox):
        minx, miny, maxx, maxy = bbox
        nx = max(minx, min(cx, maxx))
        ny = max(miny, min(cy, maxy))
        dx = cx - nx
        dy = cy - ny
        return dx * dx + dy * dy <= r * r

    # --------------------------------------------------
    # REALTIME API
    # --------------------------------------------------

    def draw_remote_stroke(self, payload):
        sid = norm_uuid_hyphen(payload["stroke_id"]) 

        if sid not in self.strokes:
            payload = dict(payload)
            payload["stroke_id"] = sid
            self._create_remote_stroke(payload)
            return

        st = self.strokes[sid]
        for x, y in payload["points"]:
            y = self.height - y
            st["points"].append((x, y))
            st["line"].points += [x, y]
            bx = st["bbox"]
            bx[0] = min(bx[0], x)
            bx[1] = min(bx[1], y)
            bx[2] = max(bx[2], x)
            bx[3] = max(bx[3], y)

    def _create_remote_stroke(self, payload):
        sid = norm_uuid_hyphen(payload["stroke_id"])
        pts = payload["points"]
        if not pts:
            return

        group = InstructionGroup()
        group.add(Color(*payload["color"]))
        fixed_pts = []
        for x, y in pts:
            fixed_pts.append((x, self.height - y))

        xs = [p[0] for p in fixed_pts]
        ys = [p[1] for p in fixed_pts]
        line = Line(
                points=[c for p in fixed_pts for c in p],
                width=payload["width"],
                cap="round",
                joint="round"
            )
        group.add(line)

        self.strokes[sid] = {
            "id": sid,
            "group": group,
            "line": line,
            "points": fixed_pts,
            "bbox": [min(xs), min(ys), max(xs), max(ys)],
        }

        self.canvas.add(group)

    def erase_remote_stroke(self, stroke_id):
        self._remove_stroke(norm_uuid_hyphen(stroke_id))

    def clear_all(self):
    # remove từng stroke khỏi canvas (KHÔNG canvas.clear)
        for st in list(self.strokes.values()):
            self.canvas.remove(st["group"])
        self.strokes.clear()
        self.current_stroke = None

class Whiteboard(MDAnchorLayout):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)

        # stroke_id -> stroke
        self.strokes = {}

        self.current_stroke = None
        self.tool = "pen"   # "pen" | "eraser"

        self.pen_color = (0, 0, 0, 1)
        self.pen_width = 2.5
        self.eraser_radius = 18
        self.md_bg_color='white'

        self.on_stroke_finished = None
        self.on_stroke_deleted = None
        self.bind(size=self._apply_flip, pos=self._apply_flip)
        Clock.schedule_once(self._apply_flip, 0)
        
    def _apply_flip(self, *args):
        self.canvas.before.clear()
        self.canvas.after.clear()

        with self.canvas.before:
            PushMatrix()
            Translate(0, self.height)
            Scale(1, -1, 1)

        with self.canvas.after:
            PopMatrix()

    # --------------------------------------------------
    # PEN
    # --------------------------------------------------

    def on_touch_down(self, touch):
        if not todo_draw_mode: return False

        if not self.collide_point(*touch.pos):
            return False

        wx, wy = self.to_local(*touch.pos)
        wy = self.height - wy

        if self.tool == "pen":
            self._start_stroke(wx, wy)
            return True

        if self.tool == "eraser":
            self._erase_at(wx, wy)
            return True

        return False

    def on_touch_move(self, touch):
        if not todo_draw_mode: return False
        
        if not self.collide_point(*touch.pos):
            return False

        wx, wy = self.to_local(*touch.pos)
        wy = self.height - wy

        if self.tool == "pen" and self.current_stroke:
            self._extend_stroke(wx, wy)
            return True

        if self.tool == "eraser":
            self._erase_at(wx, wy)
            return True

        return False

    def on_touch_up(self, touch):
        if not todo_draw_mode: return False

        if self.tool == "pen" and self.current_stroke:
            if self.on_stroke_finished:
                self.on_stroke_finished(self.current_stroke)
        self.current_stroke = None
        return False

    def _start_stroke(self, x, y):
        stroke_id = norm_uuid_hyphen(str(uuid4().hex))

        group = InstructionGroup()
        group.add(Color(*self.pen_color))
        line = Line(
            points=[x, y],
            width=self.pen_width,
            cap="round",
            joint="round"
        )
        group.add(line)

        stroke = {
            "id": stroke_id,
            "group": group,
            "line": line,
            "points": [(x, y)],
            "bbox": [x, y, x, y],  # minx, miny, maxx, maxy
        }

        self.strokes[stroke_id] = stroke
        self.canvas.add(group)
        self.current_stroke = stroke

    def _extend_stroke(self, x, y):
        st = self.current_stroke
        st["points"].append((x, y))
        st["line"].points += [x, y]

        bx = st["bbox"]
        bx[0] = min(bx[0], x)
        bx[1] = min(bx[1], y)
        bx[2] = max(bx[2], x)
        bx[3] = max(bx[3], y)

    # --------------------------------------------------
    # ERASER
    # --------------------------------------------------

    def _erase_at(self, cx, cy):
        r = self.eraser_radius

        # copy keys để remove an toàn
        for stroke_id in list(self.strokes.keys()):
            st = self.strokes[stroke_id]
            bx = st["bbox"]

            if not self._circle_hits_bbox(cx, cy, r, bx):
                continue

            self._remove_stroke(stroke_id)

    def _remove_stroke(self, stroke_id):
        st = self.strokes.pop(norm_uuid_hyphen(stroke_id), None)
        if not st:
            return
        
        self.canvas.remove(st["group"])

        if hasattr(self, "on_stroke_deleted") and self.on_stroke_deleted:
            self.on_stroke_deleted(stroke_id)
            
    @staticmethod
    def _circle_hits_bbox(cx, cy, r, bbox):
        minx, miny, maxx, maxy = bbox
        nx = max(minx, min(cx, maxx))
        ny = max(miny, min(cy, maxy))
        dx = cx - nx
        dy = cy - ny
        return dx * dx + dy * dy <= r * r

    # --------------------------------------------------
    # REALTIME API
    # --------------------------------------------------

    def draw_remote_stroke(self, payload):
        sid = norm_uuid_hyphen(payload["stroke_id"]) 

        if sid not in self.strokes:
            payload = dict(payload)
            payload["stroke_id"] = sid
            self._create_remote_stroke(payload)
            return

        st = self.strokes[sid]
        for x, y in payload["points"]:
            y = self.height - y
            st["points"].append((x, y))
            st["line"].points += [x, y]
            bx = st["bbox"]
            bx[0] = min(bx[0], x)
            bx[1] = min(bx[1], y)
            bx[2] = max(bx[2], x)
            bx[3] = max(bx[3], y)

    def _create_remote_stroke(self, payload):
        sid = norm_uuid_hyphen(payload["stroke_id"])
        pts = payload["points"]
        if not pts:
            return

        group = InstructionGroup()
        group.add(Color(*payload["color"]))
        fixed_pts = []
        for x, y in pts:
            fixed_pts.append((x, self.height - y))

        xs = [p[0] for p in fixed_pts]
        ys = [p[1] for p in fixed_pts]
        line = Line(
                points=[c for p in fixed_pts for c in p],
                width=payload["width"],
                cap="round",
                joint="round"
            )
        group.add(line)

        self.strokes[sid] = {
            "id": sid,
            "group": group,
            "line": line,
            "points": fixed_pts,
            "bbox": [min(xs), min(ys), max(xs), max(ys)],
        }

        self.canvas.add(group)

    def erase_remote_stroke(self, stroke_id):
        self._remove_stroke(norm_uuid_hyphen(stroke_id))

    def clear_all(self):
    # remove từng stroke khỏi canvas (KHÔNG canvas.clear)
        for st in list(self.strokes.values()):
            self.canvas.remove(st["group"])
        self.strokes.clear()
        self.current_stroke = None

class OverlayContainer(MDAnchorLayout):
    pass

class ToolButton(MDIconButton):
    tool = StringProperty('')

