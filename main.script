            pos_hint={"center_y": 0.5},
            ripple_color=boxbg,
            on_release=lambda instance: self.add_new_todo_widget()  # ✅ chọn luôn sau khi tạo
        )
        self.todo_more_button = MDIconButton(
            icon="dots-horizontal",
            theme_icon_color="Custom",
            md_bg_color=[0, 0, 0, 0],
            icon_color='white',
            size_hint=(None, None),
            pos_hint={"center_y": 0.5},
            ripple_color=boxbg,
        )

        self.last_todo_tool=self.todo_cursor_button

        self.todo_toolbar.add_widget(self.todo_toolbar_background_overlay)
        self.todo_toolbar_background_overlay.add_widget(self.todo_toolbar_button_background)
        self.todo_toolbar_background_overlay.add_widget(self.todo_toolbar_button_overlay)
        self.todo_toolbar_button_overlay.add_widget(self.todo_cursor_button)
        self.todo_toolbar_button_overlay.add_widget(self.todo_pen_button)
        self.todo_toolbar_button_overlay.add_widget(self.todo_eraser_button)
        self.todo_toolbar_button_overlay.add_widget(self.todo_text_box_button)
        self.todo_toolbar_button_overlay.add_widget(self.todo_scroll_lock_button)
        self.todo_toolbar_button_overlay.add_widget(self.todo_more_button)

        todo_layout.add_widget(self.todo_top_bar)
        todo_layout.add_widget(MDBoxLayout(size_hint=(1, None), md_bg_color=btn, height=dp(2), pos_hint={"center_x": 0.5}))  # Spacer
        todo_layout.add_widget(self.todo_scroll)
        todo_layout.add_widget(self.todo_new_whiteboard_button)

        Clock.schedule_once(lambda dt: self.set_ttbgo_width(), 0)
        Clock.schedule_once(lambda dt: self.sync_overlay_height(), 0)
        Clock.schedule_once(lambda dt: self.load_messages(), 0)
        Clock.schedule_once(lambda dt: self.load_todo_list(), 0)
        Clock.schedule_interval(self._flush_draw_queue, 1 / 60)
        Clock.schedule_interval(self._flush_todo_draw_queue, 1 / 60)
        self.listen_realtime()

        self.sm = MDScreenManager(transition=MDFadeSlideTransition())
        todo = MDScreen(name="to-do")
        chat = MDScreen(name="chat")
        chat.add_widget(layout)
        todo.add_widget(todo_layout)
        self.sm.add_widget(chat)
        self.sm.add_widget(todo)

        return self.sm

    def open_color_picker(self, instance):
        def set_whiteboard_pen_color(color):
            color_picker.dismiss()
            self.set_pen_color_button.md_bg_color=color
            self.todo_board.pen_color = color
            if self.todo_board.tool == 'pen':
                self.todo_board.deselect_all()

        color_picker = ProColorPickerPopup(on_select=set_whiteboard_pen_color)
        
        default = self.todo_board.pen_color
        r, g, b, _ = default
        h, s, v = colorsys.rgb_to_hsv(r, g, b)

        p = color_picker.picker  # shortcut

        p.hue = h
        p.saturation = s
        p.value = v

        p.sv_area.hue = h
        p.sv_area.saturation = s
        p.sv_area.value = v

        p.update_color()
        p.sv_area._update_pointer()
        p.hue_slider.hue = h
        p.hue_slider.update_pointer()

        color_picker.open()

    def add_new_todo_widget(self, *args):
        if not todo_draw_mode:
            return

        w = DraggableResizableWidget(
            norm_uuid_hyphen(str(uuid4().hex)),
            pos=(dp(100), self.todo_board.height - dp(200))
        )
        self.todo_board.add_widget(w)
        if hasattr(self.todo_board, "set_selected_widget"):
            self.todo_board.set_selected_widget(w)
    
    def enable_todo(self, instance):
        global todo_draw_mode
        instance.icon = "lock-open" if not todo_draw_mode else "lock"
        self.todo_scroll.do_scroll, todo_draw_mode = [True, False] if todo_draw_mode else [False, True]
        self.todo_board.deselect_all()
    
    def switch_todo_tool(self, instance):
        self.last_todo_tool.icon_color='white'
        instance.icon_color='black'
        self.todo_toolbar_button_background.pos_hint={"center_y": 0.5}
        Animation(x=instance.x, duration=0.3, transition='out_quart').start(self.todo_toolbar_button_background)
        self.last_todo_tool=instance
        self.todo_board.tool=instance.tool
        if self.todo_board.tool != 'cursor':
            self.todo_board.deselect_all()
        if self.todo_board.tool == 'pen':
            self.todo_top_bar.remove_widget(self.set_pen_color_button)
            self.todo_top_bar.add_widget(self.set_pen_color_button)
        else:
            self.todo_top_bar.remove_widget(self.set_pen_color_button)

    def set_ttbgo_width(self, *args):
        self.todo_toolbar_background_overlay.width=self.todo_toolbar_button_overlay.width
        self.todo_toolbar_button_background.x=self.last_todo_tool.x
    
    def stroke_to_norm_points(self, stroke):
        cw, ch = self.draw_canvas.width, self.draw_canvas.height
        norm_pts = []

        for x, y in stroke["points"]:
            nx = x / cw
            ny = y / ch
            norm_pts.append((nx, ny))

        return norm_pts
    
    def update_stroke_to_db(self, stroke):
        stroke_id = norm_uuid_hyphen(stroke["id"])
        points = self.stroke_to_norm_points(stroke)

        data = {
            "points": points
        }

        def send():
            url = f"{SUPABASE_URL}/rest/v1/draw?id=eq.{stroke_id}"
            res = requests.patch(url, headers=headers, json=data)
            if res.status_code not in (200, 204):
                print("STROKE UPDATE FAIL:", res.text)

        threading.Thread(target=send, daemon=True).start()
    
    def _on_local_stroke_deleted(self, stroke_id):
        def send():
            url = f"{SUPABASE_URL}/rest/v1/draw?id=eq.{norm_uuid_hyphen(stroke_id)}"
            requests.delete(url, headers=headers)

        threading.Thread(target=send, daemon=True).start()

    def _on_local_stroke_finished(self, stroke):
        points = []
        cw, ch = self.draw_canvas.width, self.draw_canvas.height

        for x, y in stroke["points"]:
            nx = x / cw
            ny = y / ch
            points.append((nx, ny))

        data = {
            "id": norm_uuid_hyphen(stroke["id"]),
            "sender": self.user_id,
            "points": points,
            "width": self.draw_canvas.pen_width,  # scale theo canvas
            "color": list(self.draw_canvas.pen_color),
            "created_at": time.strftime("%H:%M"),
            "date": normalize_date(self.lookup_date)
        }

        def send():
            url = f"{SUPABASE_URL}/rest/v1/draw"
            res = requests.post(url, headers=headers, json=data)
            if res.status_code not in (200, 201):
                print("DRAW INSERT FAIL:", res.text)

        threading.Thread(target=send, daemon=True).start()
    
    def _on_local_todo_stroke_deleted(self, stroke_id):
        def send():
            url = f"{SUPABASE_URL}/rest/v1/draw?id=eq.{norm_uuid_hyphen(stroke_id)}"
            requests.delete(url, headers=headers)

        threading.Thread(target=send, daemon=True).start()

    def _on_local_todo_stroke_finished(self, stroke):
        points = []
        cw, ch = self.todo_board.width, self.todo_board.height

        for x, y in stroke["points"]:
            nx = x / cw
            ny = y / ch
            points.append((nx, ny))

        data = {
            "id": norm_uuid_hyphen(stroke["id"]),
            "sender": self.user_id,
            "points": points,
            "width": self.todo_board.pen_width,  # scale theo canvas
            "color": list(self.todo_board.pen_color),
            "created_at": time.strftime("%H:%M"),
            "date": normalize_date(self.lookup_date),
            "file": self.current_open_board
        }

        def send():
            url = f"{SUPABASE_URL}/rest/v1/draw"
            res = requests.post(url, headers=headers, json=data)
            if res.status_code not in (200, 201):
                print("DRAW INSERT FAIL:", res.text)

        threading.Thread(target=send, daemon=True).start()

    def _debounced_reload(self, date_str, delay=0.25):
        if self._reload_timer:
            try: self._reload_timer.cancel()
            except: pass
            self._reload_timer = None
        self._reload_timer = Clock.schedule_once(lambda dt: self.load_strokes(date_str), delay) 

    def on_scroll(self, scroll, value):
        return

    def status(self, instance, value):
        if value:
            text=format_text_with_fonts(f"Chúng mình đã xa nhau {(datetime.now() - datetime.strptime(self.far_day.start_day, '%d/%m/%Y')).days} ngày 😭")
            self.far_day.text=f'[size={int(dp(12))}]{text}[/size]'
    
    def sync_overlay_height(self, *args):
        paper_height = max(self.msg_list.height, self.msg_scroll.height)
        todo_paper_height = max(self.todo_browse.height, self.todo_scroll.height)

        old_h = self.draw_canvas.height

        self.todo_container.height=todo_paper_height
        self.container.height = paper_height
        self.draw_canvas.width = self.container.width
        self.draw_canvas.height = paper_height

        if old_h != paper_height:
            self.update_all_strokes_after_resize()

    def update_all_strokes_after_resize(self):
        if hasattr(self, "_resize_timer") and self._resize_timer:
            self._resize_timer.cancel()

        self._resize_timer = Clock.schedule_once(
            lambda dt: self._commit_stroke_resize(),
            0.3
        )

    def _commit_stroke_resize(self):
        for stroke in self.draw_canvas.strokes.values():
            self.update_stroke_to_db(stroke)

    def date_picker_open(self):
        self.menu.dismiss()
        date_dialog = MDDatePicker(title_input="Nhập ngày check", title="Chọn ngày check", primary_color=menubg, accent_color=bg, selector_color=btn, text_button_color="black", input_field_background_color_focus=boxbg, input_field_background_color_normal=boxbg[:-1]+(0.25,), input_field_text_color_focus="black", text_weekday_color=btn, helper_text="", text_current_color=menubg)
        date_dialog.bind(on_save=self.load_messages)
        date_dialog.open()
    
    def menu_open(self, instance):
        menu_items = [
            {
                "text": "Mở chế độ vẽ" if not draw_mode else "Tắt chế độ vẽ",
                "text_color": primarycolor,
                "trailing_icon": "brush",
                "theme_trailing_icon_color": "Custom",
                "trailing_icon_color": primarycolor,
                "on_release": self.draw_mode
            },
            {
                "text": "Whiteboard",
                "text_color": primarycolor,
                "trailing_icon": "drawing",
                "theme_trailing_icon_color": "Custom",
                "trailing_icon_color": primarycolor,
                "on_release": self.open_todo_board,
                "disabled": True if draw_mode else False
            },
            {
                "text": "Check tin nhắn cũ",
                "text_color": primarycolor,
                "trailing_icon": "history",
                "theme_trailing_icon_color": "Custom",
                "trailing_icon_color": primarycolor,
                "on_release": self.date_picker_open,
                "disabled": True if draw_mode else False
            },
            {
                "text": "Đổi UID",
                "text_color": primarycolor,
                "trailing_icon": "account",
                "theme_trailing_icon_color": "Custom",
                "trailing_icon_color": primarycolor,
                "on_release": self.show_uid_dialog
            }
        ]

        if draw_mode: menu_items=menu_items[:1]+[
            {
                "text": "Chọn Bút" if not self.draw_canvas.tool=="pen" else"Chọn Tẩy",
                "text_color": primarycolor,
                "trailing_icon": "pencil" if not self.draw_canvas.tool=="pen" else "eraser",
                "theme_trailing_icon_color": "Custom",
                "trailing_icon_color": primarycolor,
                "on_release": self.set_tool_pen if not self.draw_canvas.tool=="pen" else self.set_tool_eraser,
                "disabled": False
            }]+menu_items[1:]
        
        self.menu=MDDropdownMenu(
            caller=self.uid_button,
            items=menu_items,               
            ver_growth="down",
            hor_growth="left",
            md_bg_color=menubg,
            position="bottom"
        )
        self.menu.open()

    def open_todo_board(self, *args):
        self.menu.dismiss()
        self.sm.current='to-do'

    def set_tool_pen(self, *args):
        try: self.menu.dismiss()
        except: pass
        self.draw_canvas.tool = "pen"

    def set_tool_eraser(self, *args):
        try: self.menu.dismiss()
        except: pass
        self.draw_canvas.tool = "eraser"

    def draw_mode(self, *args):
        global draw_mode
        self.menu.dismiss()
        self.set_tool_pen()
        self.msg_scroll.do_scroll, draw_mode = [True, False] if draw_mode else [False, True]

    def show_uid_dialog(self, *args):
        try: self.menu.dismiss()
        except: pass
        self.uid_input = MDTextField(hint_text="Đặt UID nề bbi <3",
                                    font_name="resources/fonts/segoeui.ttf",
                                    line_color_normal=boxbg,
                                    line_color_focus=boxbg,
                                    hint_text_color=[0.75 - i for i in primarycolor],
                                    hint_text_color_focus=primarycolor,
                                    text_color_focus=primarycolor,
                                    fill_color_normal=boxbg,
                                    size_hint=(1, None),
                                    pos_hint={'center_y': 0.5},
                                    height=dp(30),
                                    multiline=False)
        self.dialog = MDDialog(
            title="Nhập UID",
            type="custom",
            content_cls=self.uid_input,
            buttons=[MDFillRoundFlatButton(text="OK", on_release=self.save_uid, md_bg_color=btn)],
            md_bg_color=menubg
        )
        self.dialog.open()

    def show_whiteboard_dialog(self, *args):
        try: self.menu.dismiss()
        except: pass
        self.whiteboard_input = MDTextField(hint_text="Đặt tên whiteboard nề bbi <3",
                                    font_name="resources/fonts/segoeui.ttf",
                                    line_color_normal=boxbg,
                                    line_color_focus=boxbg,
                                    hint_text_color=[0.75 - i for i in primarycolor],
                                    hint_text_color_focus=primarycolor,
                                    text_color_focus=primarycolor,
                                    fill_color_normal=boxbg,
                                    size_hint=(1, None),
                                    pos_hint={'center_y': 0.5},
                                    height=dp(30),
                                    multiline=False,
                                    on_text_validate=self.create_whiteboard)
        self.dialog = MDDialog(
            title="Nhập tên whiteboard",
            type="custom",
            content_cls=self.whiteboard_input,
            buttons=[MDFillRoundFlatButton(text="OK", on_release=self.create_whiteboard, md_bg_color=btn)],
            md_bg_color=menubg
        )
        self.dialog.open()

    def save_uid(self, *args):
        uid = self.uid_input.text.strip()
        if uid:
            self.user_id = uid
            self.uid_button.text = uid
            with open("uid.txt", "w") as f:
                f.write(uid)
            self.dialog.dismiss()

    def on_text_change(self, instance, value):
        """Enable/disable send button based on text input"""
        self.text_input.button.disabled = not value.strip()

    def change_text(self, instance):
        if instance.text=="\u2600 <3 \u2B50":
            instance.text=str((datetime.now() - datetime.strptime("26/11/2025", "%d/%m/%Y")).days) + " ngày iu"
        else: instance.text="\u2600 <3 \u2B50"

    def send_msg(self, *args):
        if not self.user_id:
            self.show_uid_dialog()
            return
        
        if self.lookup and normalize_date(self.lookup_date) != datetime.strftime(datetime.now(), "%d/%m/%Y"):
            self.lookup=False
            self.msg_list.clear_widgets()
            self.load_messages()
        
        try: self.msg_list.remove_widget(msg_id_list['0000'].parent)
        except: pass

        msg = self.text_input.input.text
        if msg:
            url = f"{SUPABASE_URL}/rest/v1/messages"
            data = {"sender": self.user_id, "content": msg, "created_at": time.strftime("%H:%M"), "date": time.strftime("%d/%m/%Y")}
            res = requests.post(url, headers=headers, json=data)
            if res.status_code == 201:
                self.text_input.input.text = ""
                if 'iu' in msg.lower().translate(str.maketrans('', '', '.,?!')).split(): Clock.schedule_once(lambda x: self.spawn_emoji(multi=True))
            else:
                print("Error:", res.text)

    def create_whiteboard(self, *args):
        if not self.user_id:
            self.show_uid_dialog()
            return
        
        if hasattr(self.todo_scroll.children[0], 'text'):
            if self.todo_scroll.children[0].text=='Chưa có whiteboard nào được tạo hết ;-;': self.todo_scroll.remove_widget(self.todo_scroll.children[0])

        name_ = self.whiteboard_input.text
        if name_:
            url = f"{SUPABASE_URL}/rest/v1/todo"
            data = {"whiteboard_name": name_, "created_at": time.strftime("%d/%m/%Y")}
            requests.post(url, headers=headers, json=data)
            self.dialog.dismiss()

    def delete_whiteboard(self, file_id, name):
        def send():
            url = f"{SUPABASE_URL}/rest/v1/todo?id=eq.{norm_uuid_hyphen(file_id)}"
            requests.delete(url, headers=headers)

            url = f"{SUPABASE_URL}/rest/v1/draw?&file=eq.{name}"
            requests.delete(url, headers=headers)

        threading.Thread(target=send, daemon=True).start()

    def load_messages(self, instance=None, date_str=datetime.strftime(datetime.now(), '%d/%m/%Y'), data_range=None):
        self.lookup_date=date_str
        self.draw_canvas.clear_all()
        self.msg_list.clear_widgets()
        if not self.noti.button.disabled:
            self.noti.button.disabled=True
            collapse_vertical(self.noti)
        if instance:
            date_str=datetime.strptime(str(date_str), "%Y-%m-%d").strftime("%d/%m/%Y")
            if date_str==self.lookup_date: return
            self.lookup=True
        url = f"{SUPABASE_URL}/rest/v1/messages?select=*&date=eq.{date_str}&order=created_at.asc"
        res = requests.get(url, headers=headers)
        if res.status_code == 200:
            rows = res.json()
            if rows:
                for row in rows:
                    self.display_message(row['sender'], row['content'], row['created_at'], row['date'], row['id'])
            elif datetime.strptime(date_str, "%d/%m/%Y") < datetime.now() and normalize_date(self.lookup_date) != datetime.strftime(datetime.now(), "%d/%m/%Y"): self.display_message('ngha' if self.user_id=='hmn' else 'hmn', 'Không có tin nhắn nào cho ngày này hết ;-;', '00:00', date_str, msg_id='0000')
            elif datetime.strptime(date_str, "%d/%m/%Y") > datetime.now() or normalize_date(self.lookup_date) == datetime.strftime(datetime.now(), "%d/%m/%Y"): self.display_message('ngha' if self.user_id=='hmn' else 'hmn', 'Mong chờ những lời iu thương của {} qaaa :3'.format('hmn' if self.user_id=='hmn' else 'ngha'), '00:00', date_str, msg_id='0000')
            Clock.schedule_once(self.scroll_to_bottom)
        
        Clock.schedule_once(self.load_far)
        Clock.schedule_once(lambda dt: self.load_strokes(date_str), 0)

    def load_todo_list(self, instance=None):
        self.todo_scroll.clear_widgets()
        self.todo_scroll.add_widget(self.todo_browse)
        if self.todo_top_icon not in self.todo_top_bar.children: self.todo_top_bar.add_widget(self.todo_top_icon, index=-1)
        if self.todo_new_whiteboard_button not in self.sm.get_screen("to-do").children[0].children: self.sm.get_screen("to-do").children[0].add_widget(self.todo_new_whiteboard_button)
        self.sm.get_screen("to-do").children[0].remove_widget(self.todo_toolbar)
        self.todo_top_bar.remove_widget(self.todo_top_back)
        self.todo_top_bar.remove_widget(self.set_pen_color_button)
        self.current_open_board=None
        self.todo_browse.clear_widgets()
        url = f"{SUPABASE_URL}/rest/v1/todo?select=*&order=created_at.asc"
        res = requests.get(url, headers=headers)
        if res.status_code == 200:
            rows = res.json()
            if rows:
                for row in rows[-10:]:
                    self.display_file(row['whiteboard_name'], row['created_at'], row['id'])
            else:
                self.todo_scroll.clear_widgets()
                self.todo_scroll.add_widget(MDLabel(text="Chưa có whiteboard nào được tạo hết ;-;", halign='center', valign='center', size_hint=(1, 1)))
        
        Clock.schedule_once(self.load_far)

    def load_strokes(self, date_str):
        url = (
            f"{SUPABASE_URL}/rest/v1/draw"
            f"?select=id,points,width,color,file"
            f"&date=eq.{date_str}"
            f"&order=created_at.asc"
        )
        res = requests.get(url, headers=headers)
        if res.status_code != 200:
            print("LOAD STROKES FAIL:", res.text)
            return

        self.draw_canvas.clear_all()

        cw, ch = self.draw_canvas.width, self.draw_canvas.height

        for row in res.json():
            if row["file"]: continue
            pts = []
            for nx, ny in row["points"]:
                x = nx * cw
                y = ch - (ny * ch)
                pts.append((x, y))

            self.draw_canvas.draw_remote_stroke({
                "stroke_id": norm_uuid_hyphen(row["id"]),
                "points": pts,
                "width": dp(row["width"]),
                "color": tuple(row["color"]),
            })

    def load_todo_strokes(self, name):
        self.todo_scroll.clear_widgets()
        self.todo_scroll.add_widget(self.todo_board)
        self.todo_top_bar.add_widget(self.todo_top_back, index=-1)
        self.todo_top_bar.remove_widget(self.todo_top_icon)
        self.current_open_board=name
        self.sm.get_screen("to-do").children[0].add_widget(self.todo_toolbar)
        self.sm.get_screen("to-do").children[0].remove_widget(self.todo_new_whiteboard_button)
        if todo_draw_mode: self.enable_todo(self.todo_scroll_lock_button)
        if self.last_todo_tool!=self.todo_cursor_button: self.switch_todo_tool(self.todo_cursor_button)

        url = (
            f"{SUPABASE_URL}/rest/v1/draw"
            f"?select=id,points,width,color"
            f"&file=eq.{name}"
            f"&order=created_at.asc"
        )
        res = requests.get(url, headers=headers)
        if res.status_code != 200:
            print("LOAD STROKES FAIL:", res.text)
            return

        self.todo_board.clear_all()
        self.todo_board.clear_widgets()

        cw, ch = self.todo_board.width, self.todo_board.height

        for row in res.json():
            pts = []
            for nx, ny in row["points"]:
                x = nx * cw
                y = ch - (ny * ch)
                pts.append((x, y))

            self.todo_board.draw_remote_stroke({
                "stroke_id": norm_uuid_hyphen(row["id"]),
                "points": pts,
                "width": dp(row["width"]),
                "color": tuple(row["color"]),
            })

    def load_far(self, *args):
        url = f"{SUPABASE_URL}/rest/v1/far?select=*&order=start.asc"
        res = requests.get(url, headers=headers)
        if res.status_code == 200:
            rows = res.json()
            self.far_day.start_day=rows[-1]['start']
            self.far_day.is_far=rows[-1]['status']

    def scroll_to_bottom(self, *args):        
        Animation(scroll_y=0, transition="out_quad").start(self.msg_scroll)

    def display_message(self, sender, content, timestamp, date, msg_id):
        global msg_id_list
        if self.last_date==None or self.last_date != date:
            date_label = MDLabel(
                text=f"[size={int(dp(12))}]{format_text_with_fonts(date)}[/size]",
                halign="center",
                theme_text_color="Custom",
                text_color=primarycolor,
                size_hint=(1, None),
                height=dp(30),
                markup=True
            )
            self.msg_list.add_widget(date_label)
            self.last_date = date

        """Display a message with modern UI styling"""
        
        # Check if last message is from same sender within 1 minute
        should_merge = False
        if len(self.msg_list.children) > 0:
            last_widget = self.msg_list.children[0]
            if hasattr(last_widget, 'sender') and last_widget.sender == sender:
                try:
                    current_time = datetime.strptime(timestamp, "%H:%M")
                    last_time = datetime.strptime(last_widget.last_timestamp, "%H:%M")
                    time_diff = abs((current_time - last_time).total_seconds())
                    if time_diff <= 60:
                        should_merge = True
                except:
                    pass
        
        if should_merge:
            # Append to existing card
            last_widget = self.msg_list.children[0]
            msg_label = MDLabel(
                text=format_text_with_fonts(content),
                halign="left",
                theme_text_color="Custom",
                text_color=primarycolor,
                size_hint=(1, None),
                markup=True
            )
            msg_label.bind(texture_size=msg_label.setter('texture_size'))
            msg_label.bind(texture_size=msg_label.setter('size'))
            last_widget.add_widget(msg_label)
            last_widget.last_timestamp = timestamp
        else:
            # Create new card
            msg_card = MDCard(
                orientation="vertical",
                size_hint=(1, None),
                padding=[dp(10), dp(10), dp(10), dp(10)],
                spacing=dp(5),
                md_bg_color=boxbg[:-1]+(0.25,),
                radius=[dp(10), dp(10), dp(10), dp(10)],
                elevation=0,
                on_release=lambda x: self.send_emoji(pos=Window.mouse_pos)
            )
            msg_card.sender = sender
            msg_card.last_timestamp = timestamp
            
            # Message header with sender name
            header_layout = MDBoxLayout(size_hint=(1, None), height=dp(25), spacing=dp(5))
            morning = datetime.strptime("05:00", "%H:%M").time()
            evening = datetime.strptime("18:00", "%H:%M").time()
            emoji = "\u2600" if morning <= datetime.strptime(timestamp, "%H:%M").time() <= evening else "\u2B50"
            symbol = "\u2022"
            sender_label = MDLabel(
                text=f"[size={int(dp(14))}]{format_text_with_fonts(f'{sender} {symbol} {timestamp} {emoji}', True)}[/size]",
                size_hint=(1, None),
                height=dp(25),
                theme_text_color="Custom",
                text_color=primarycolor,
                font_size=dp(14),
                markup=True
            )
            header_layout.add_widget(sender_label)
            
            # Message content
            msg_label = MDLabel(
                text=format_text_with_fonts(content),
                halign="left",
                theme_text_color="Custom",
                text_color=primarycolor,
                size_hint=(1, None),
                markup=True
            )
            msg_label.bind(texture_size=msg_label.setter('texture_size'))
            msg_label.bind(texture_size=msg_label.setter('size'))
            
            msg_card.add_widget(header_layout)
            msg_card.add_widget(msg_label)
            msg_card.bind(minimum_height=msg_card.setter('height'))
            
            self.msg_list.add_widget(msg_card)
        
        msg_id_list[msg_id]=msg_label

    def display_file(self, file, timestamp, file_id):
        global file_id_list
        """Display a message with modern UI styling"""
        
        # Create new card
        file_card = MDCard(
            orientation="vertical",
            size_hint=(1, None),
            padding=[dp(10), dp(10), dp(10), dp(10)],
            spacing=dp(5),
            md_bg_color=boxbg[:-1]+(0.25,),
            radius=[dp(10), dp(10), dp(10), dp(10)],
            elevation=0,
            on_release=lambda dt: Clock.schedule_once(lambda x: self.load_todo_strokes(file))
        )
        
        # Message header with file name
        header_layout = MDBoxLayout(size_hint=(1, None), height=dp(25), spacing=dp(5))
        symbol = "\u2022"
        file_label = MDLabel(
            text=f"[size={int(dp(14))}]{format_text_with_fonts(f'{file} {symbol} {timestamp}', True)}[/size]",
            size_hint=(1, None),
            height=dp(25),
            theme_text_color="Custom",
            text_color=primarycolor,
            font_size=dp(14),
            markup=True
        )
        file_delete_button=MDIconButton(icon="delete", theme_icon_color="Custom", icon_color="red", pos_hint={"center_y": 0.5}, on_release=lambda dt: self.delete_whiteboard(file_id, file))
        header_layout.add_widget(file_label)
        header_layout.add_widget(file_delete_button)
        
        file_card.add_widget(header_layout)
        file_card.bind(minimum_height=file_card.setter('height'))
        
        self.todo_browse.add_widget(file_card)
        
        file_id_list[file_id]=file_card

    def spawn_emoji(self, emoji="\U0001F496", pos=(0, 0), multi=False):
        if not multi:
            label = MDLabel(
                text=format_text_with_fonts(emoji),
                font_size="32sp",
                size_hint=(None, None),
                pos=(pos[0] - 25, pos[1] - 25),
                markup=True
            )

            Window.add_widget(label)

            # animation bay lên + mờ dần
            anim = (
                Animation(y=label.y + 60, opacity=0, duration=0.8)
            )

            anim.bind(on_complete=lambda *x: Window.remove_widget(label))
            anim.start(label)
        else:
            count = random.randint(10, 15)

            win_w, win_h = Window.size

            for _ in range(count):
                # spawn ở đáy màn hình
                x = random.randint(0, int(win_w - 50))
                y = -50

                # đích đến random toàn màn hình
                target_y = random.randint(int(win_h * 0.3), int(win_h))

                label = MDLabel(
                    text=format_text_with_fonts(emoji),
                    font_size="32sp",
                    size_hint=(None, None),
                    pos=(x, y),
                    opacity=1,
                    markup=True
                )

                Window.add_widget(label)

                # bay nhẹ lên + fade
                dy = random.randint(40, 100)

                anim = Animation(
                    y=target_y,
                    opacity=0,
                    duration=random.uniform(3, 5),
                    t="out_quad"
                )

                anim.bind(on_complete=lambda *x: Window.remove_widget(label))
                anim.start(label)
    
    def send_emoji(self, pos=(0, 0)):
        self.spawn_emoji(pos=pos)

        def send():
            w, h = Window.size
            url = f"{SUPABASE_URL}/rest/v1/reaction"
            data = {
                "sender": self.user_id,
                "x": float(pos[0]) / w,
                "y": float(pos[1]) / h,
                "created_at": time.strftime("%H:%M"),
                "date": time.strftime("%d/%m/%Y")
            }
            requests.post(url, headers=headers, json=data)

        threading.Thread(target=send).start()

    def _flush_draw_queue(self, dt):
        if not self._draw_queue:
            return

        with self._draw_lock:
            batch = self._draw_queue[:]
            self._draw_queue.clear()
        
        for r in batch:
            pts = []
            for nx, ny in r.get("points", []):
                cw, ch = self.draw_canvas.width, self.draw_canvas.height
                x = nx * cw
                y = ch - (ny * ch)
                pts.append((x, y))
            if not pts:
                continue
            self.draw_canvas.draw_remote_stroke({
                "stroke_id": norm_uuid_hyphen(r["id"]),
                "points": pts,
                "width": dp(r["width"]),
                "color": tuple(r.get("color", (0,0,0,1)))
            })

    def _flush_todo_draw_queue(self, dt):
        if not self._todo_draw_queue:
            return

        with self._todo_draw_lock:
            batch = self._todo_draw_queue[:]
            self._todo_draw_queue.clear()
        
        for r in batch:
            pts = []
            for nx, ny in r.get("points", []):
                cw, ch = self.todo_board.width, self.todo_board.height
                x = nx * cw
                y = ch - (ny * ch)
                pts.append((x, y))
            if not pts:
                continue
            self.todo_board.draw_remote_stroke({
                "stroke_id": norm_uuid_hyphen(r["id"]),
                "points": pts,
                "width": dp(r["width"]),
                "color": tuple(r.get("color", (0,0,0,1)))
            })

    def listen_realtime(self):
        async def realtime_loop():
            while True:  # 🔁 vòng reconnect
                try:
                    url = (
                        "wss://fjhakjrxbdiowjkppgzy.supabase.co/realtime/v1/websocket"
                        f"?apikey={SUPABASE_KEY}"
                        f"&vsn=1.0.0"
                    )

                    async with websockets.connect(
                        url,
                        ssl=ssl_context,
                        additional_headers={
                            "Authorization": f"Bearer {SUPABASE_KEY}"
                        },
                        ping_interval=20,
                        ping_timeout=20
                    ) as ws:
                        # Join channel
                        await ws.send(json.dumps({
                            "topic": "realtime:public:messages",
                            "event": "phx_join",
                            "payload": {},
                            "ref": 1
                        }))

                        await ws.send(json.dumps({
                            "topic": "realtime:public:reaction",
                            "event": "phx_join",
                            "payload": {},
                            "ref": 2
                        }))

                        await ws.send(json.dumps({
                            "topic": "realtime:public:draw",
                            "event": "phx_join",
                            "payload": {},
                            "ref": 3
                        }))

                        await ws.send(json.dumps({
                            "topic": "realtime:public:far",
                            "event": "phx_join",
                            "payload": {},
                            "ref": 4
                        }))

                        await ws.send(json.dumps({
                            "topic": "realtime:public:version",
                            "event": "phx_join",
                            "payload": {},
                            "ref": 5
                        }))

                        await ws.send(json.dumps({
                            "topic": "realtime:public:todo",
                            "event": "phx_join",
                            "payload": {},
                            "ref": 6
                        }))

                        while True:
                            msg = await ws.recv()
                            data = json.loads(msg)
                            record = data.get("payload", {}).get("record", {})
                            if not record:
                                record = data.get("payload", {}).get("old_record", {})
                                if data.get("event") == "DELETE":
                                    if data.get("topic") == "realtime:public:messages":
                                        msg_id = record.get("id")
                                        if msg_id and msg_id in msg_id_list:
                                            msg_id_list[msg_id].text = f"[size={int(dp(14))}][i]Tin nhắn đã thu hồi ;-;[/i][/size]"
                                    elif data.get("topic") == "realtime:public:draw":
                                        stroke_id = norm_uuid_hyphen(record.get("id"))
                                        Clock.schedule_once(
                                            lambda dt, sid=stroke_id: self.draw_canvas.erase_remote_stroke(sid)
                                        )
                                        Clock.schedule_once(
                                            lambda dt, sid=stroke_id: self.todo_board.erase_remote_stroke(sid)
                                        )
                                    elif data.get("topic") == "realtime:public:todo":
                                        if len(self.todo_browse.children)==1:
                                            Clock.schedule_once(lambda dt: self.todo_scroll.clear_widgets())
                                            Clock.schedule_once(lambda dt: self.todo_scroll.add_widget(MDLabel(text="Chưa có whiteboard nào được tạo hết ;-;", halign='center', valign='center', size_hint=(1, 1))))
                                        Clock.schedule_once(lambda dt: self.todo_browse.remove_widget(file_id_list[record["id"]]))
                                continue

                            if data.get("event") == "UPDATE" and data["topic"] == "realtime:public:version" and datetime.strptime(record["date"], "%d/%m/%Y").date() >= datetime.now().date() and build!=record["build"]:
                                    with open('build.txt', "w", encoding='utf-8') as fo: fo.write(record['build'])
                                    Clock.schedule_once(lambda dt: self.update())

                            if data.get("event") == "INSERT":
                                if data["topic"] == "realtime:public:reaction":
                                    w, h = Window.size
                                    if record["sender"] != self.user_id:
                                        Clock.schedule_once(lambda dt, r=record: self.spawn_emoji(pos=(r["x"] * w, r["y"] * h)))
                                elif data["topic"] == "realtime:public:draw":
                                    if record["file"] and record["file"] == self.current_open_board and record["sender"] != self.user_id:
                                        with self._todo_draw_lock:
                                            self._todo_draw_queue.append(record)
                                    elif record["sender"] != self.user_id and normalize_date(record["date"]) == normalize_date(self.lookup_date):
                                        with self._draw_lock:
                                            self._draw_queue.append(record)
                                elif data["topic"] == "realtime:public:far":
                                    self.far_day.start_day=record["start"]
                                    self.far_day.is_far=record["status"]
                                elif data["topic"] == "realtime:public:todo":
                                    Clock.schedule_once(lambda dt: self.todo_scroll.clear_widgets())
                                    Clock.schedule_once(lambda dt: self.todo_scroll.add_widget(self.todo_browse))
                                    Clock.schedule_once(lambda dt: self.display_file(record["whiteboard_name"], record["created_at"], record["id"]))
                                else:
                                    sender = record["sender"]
                                    content = record["content"]
                                    timestamp = record["created_at"]
                                    date = record["date"]
                                    msg_id = record["id"]

                                    if self.lookup and normalize_date(self.lookup_date) != datetime.strftime(datetime.now(), "%d/%m/%Y"):
                                        self.noti.button.disabled=False
                                        expand_vertical(self.noti, dp(40))
                                    else:
                                        if msg_id_list.get('0000'): Clock.schedule_once(lambda dt: self.msg_list.remove_widget(msg_id_list['0000'].parent))
                                        Clock.schedule_once(
                                            lambda dt, s=sender, c=content, t=timestamp, d=date, msg_id=msg_id:
                                            self.display_message(s, c, t, d, msg_id)
                                        )
                                        if 'iu' in content.lower().translate(str.maketrans('', '', '.,?!')).split(): Clock.schedule_once(lambda x: self.spawn_emoji(multi=True))

                                    if sender != self.user_id and (platform!="android" or not self.app_in_foreground):
                                        notify_message(
                                            "Tin nhắn mới",
                                            f"{sender}: {content}"
                                        )

                except Exception as e:
                    print("Realtime socket died:", e)
                    await asyncio.sleep(3)  # ⏳ đợi rồi tự reconnect

        def start():
            asyncio.run(realtime_loop())
        threading.Thread(target=start, daemon=True).start()

    def show_updating_dialog(self):
        self.update_dialog = MDDialog(
            title="Đang cập nhật nề",
            text="Bạn iu chờ tẹo nhó...",
            md_bg_color=menubg,
            auto_dismiss=False,
        )
        self.update_dialog.open()

    def show_update_success(self):
        dialog = MDDialog(
            title="Ầu diaa",
            text="Cập nhật xong rùi <3",
            md_bg_color=menubg,
            buttons=[
                MDFillRoundFlatButton(
                    text="OK",
                    md_bg_color=btn,
                    on_release=self.stop
                )
            ],
            auto_dismiss=False,
        )
        dialog.open()

    def update(self, *args):
        self.show_updating_dialog()
        def worker():
            try:
                assets=["main.script"]
                for asset in assets:
                    download_file(repo="luv", file_path=asset, name=f"temp_{asset}")

                with open("main.script", "w", encoding="utf-8") as fo, open("temp_main.script", encoding="utf-8") as fi: fo.write(fi.read())
                os.remove("temp_main.script")

                # quay về UI thread khi xong
                Clock.schedule_once(lambda dt: self.finish_update())

            except Exception as e:
                print("Update error:", e)
                Clock.schedule_once(lambda dt: self.update_dialog.dismiss())

        threading.Thread(target=worker, daemon=True).start()

    def finish_update(self):
        if hasattr(self, "update_dialog"):
            self.update_dialog.dismiss()

        self.show_update_success()

    def on_start(self):
        global build

        url = f"{SUPABASE_URL}/rest/v1/version?select=*&date=eq.{datetime.strftime(datetime.now(), '%d/%m/%Y')}&order=build.asc"
        res = requests.get(url, headers=headers)
        if res.status_code == 200:
            rows = res.json()
            if rows and rows[-1]['build']!=build:
                with open('build.txt', "w", encoding='utf-8') as fo: fo.write(rows[-1]['build'])
                Clock.schedule_once(lambda dt: self.update())

    def on_pause(self):
        print("App paused")
        self.app_in_foreground = False
        return True

    def on_resume(self):
        global message_cache
        print("App resumed")
        self.app_in_foreground = True
        message_cache = []
        return True

ChatApp().run()