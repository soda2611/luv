def run_bg(fn, *args, **kwargs):
    """Chạy fn ở background thread, tự catch exception để không chết app."""
    def _wrap():
        try:
            fn(*args, **kwargs)
        except Exception as e:
            print("BG error:", e)
    threading.Thread(target=_wrap, daemon=True).start()

