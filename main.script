        self.far_day.bind(is_far=self.status)
        self.far_day.bind(texture_size=self.far_day.setter("texture_size"))
        self.far_day.bind(texture_size=self.far_day.setter("size"))
        self.text_input.input.bind(text=self.on_text_change)

        self.noti=CustomMDBoxLayout(size_hint=(1, None), height=dp(0), padding=dp(5))
        self.noti.label=MDLabel(text="Có tin nhắn mới nề <3", pos_hint={"center_y": 0.5, "bottom": 0})
        self.noti.button=MDFillRoundFlatButton(text="Đọc thui", md_bg_color=btn, theme_text_color="Custom", text_color=bg, on_release=lambda instance: self.load_messages(instance=None), disabled=True)
        self.noti.add_widget(self.noti.label)
        self.noti.add_widget(self.noti.button)

        layout.add_widget(self.top_bar)
        layout.add_widget(MDBoxLayout(size_hint=(1, None), md_bg_color=btn, height=dp(2), pos_hint={"center_x": 0.5}))  # Spacer
        layout.add_widget(self.noti)    
        layout.add_widget(self.msg_scroll)
        layout.add_widget(self.input_card)
        layout.add_widget(self.far_day)

        #-------------------------------------------------------------
        #                           To-Do                            |
        #-------------------------------------------------------------

        self.todo_top_bar = MDBoxLayout(size_hint=(1, None), height=dp(50), padding=dp(5), spacing=dp(10))
        self.todo_top_icon = MDFillRoundFlatIconButton(
            icon="arrow-left",
            text=format_text_with_fonts("\U0001F496 ngha và hmn", True),
            theme_text_color="Custom",
            text_color=primarycolor,
            theme_icon_color="Custom",
            icon_color=primarycolor,
            md_bg_color=bg,
            on_release=lambda instance: setattr(self.sm, 'current', 'chat'),
            pos_hint={"center_y": 0.5}
        )
        self.todo_top_back = MDFillRoundFlatIconButton(
            icon="arrow-left",
            text=format_text_with_fonts("\U0001F496 ngha và hmn", True),
            theme_text_color="Custom",
            text_color=primarycolor,
            theme_icon_color="Custom",
            icon_color=primarycolor,
            md_bg_color=bg,
            on_release=self.load_todo_list,
            pos_hint={"center_y": 0.5}
        )
        self.todo_top_bar.add_widget(self.todo_top_icon)
        self.todo_top_bar.add_widget(MDBoxLayout(size_hint=(1, 1)))

        self.todo_new_whiteboard_button = MDFillRoundFlatIconButton(
            icon="plus",
            text="Thêm whiteboard mới",
            theme_text_color="Custom",
            text_color='white',
            theme_icon_color="Custom",
            icon_color='white',
            md_bg_color=btn,
            pos_hint={"center_x": 0.5},
            on_release=self.show_whiteboard_dialog
        )
        self.todo_scroll = ScrollView(size_hint=(1, 1), scroll_type=['bars', 'content'])
        self.todo_board = Whiteboard()
        self.todo_board.size_hint=(None, None)
        self.todo_board.height=dp(100000)
        self.todo_board.width=dp(100000)
        self.todo_board.on_stroke_finished = self._on_local_todo_stroke_finished
        self.todo_board.on_stroke_deleted = self._on_local_todo_stroke_deleted
        self.todo_browse = MDBoxLayout(orientation="vertical", size_hint=(1, None), spacing=dp(10), padding=[0, dp(10), 0, dp(10)])
        self.todo_container = OverlayContainer(size_hint=(1, None), anchor_y='top')
        self.set_pen_color_button = MDCard(size_hint=(None, None), width=dp(20), height=dp(20), radius=dp(100), md_bg_color=self.todo_board.pen_color, pos_hint={"center_y": 0.5}, line_width=dp(1), line_color='black', on_release=self.open_color_picker)
        self.todo_browse.bind(minimum_height=self.todo_browse.setter('height'))
        self.todo_browse.bind(size=self.sync_overlay_height)
        self.todo_scroll.add_widget(self.todo_browse)

        self.todo_toolbar = MDCard(
            md_bg_color=btn,
            size_hint=(None, None),
            height=dp(60),
            padding=dp(5),
            radius=dp(30),
            pos_hint={"center_x": 0.5}
        )

        self.todo_toolbar_background_overlay = MDFloatLayout(
            size_hint=(None, 1),
            pos_hint={"center_x": 0.5, "center_y": 0.5},
        )

        self.todo_toolbar_button_background = MDCard(
            md_bg_color=boxbg,
            size_hint=(None, None),
            height=dp(50),
            width=dp(50),
            radius=dp(25),
            pos_hint={"center_y": 0.5, "x": 0}
        )

        self.todo_toolbar_button_overlay = MDBoxLayout(
            size_hint=(1, 1),
            pos_hint={"center_x": 0.5, "center_y": 0.5}
        )

        self.todo_toolbar.bind(minimum_width=self.todo_toolbar.setter("width"))
        self.todo_toolbar_button_overlay.bind(minimum_width=self.todo_toolbar_button_overlay.setter("width"))
        Window.bind(width=self.set_ttbgo_width)

        self.todo_cursor_button = ToolButton(
            icon="cursor-default",
            theme_icon_color="Custom",
            md_bg_color=[0, 0, 0, 0],
            icon_color='black',
            size_hint=(None, None),
            pos_hint={"center_y": 0.5},
            on_release=self.switch_todo_tool,
            ripple_color=boxbg,
            tool='cursor'
        )
        
        self.todo_pen_button = ToolButton(
            icon="pencil",
            theme_icon_color="Custom",
            md_bg_color=[0, 0, 0, 0],
            icon_color='white',
            size_hint=(None, None),
            pos_hint={"center_y": 0.5},
            on_release=self.switch_todo_tool,
            ripple_color=boxbg,
            tool='pen'
        )
        self.todo_eraser_button = ToolButton(
            icon="eraser",
            theme_icon_color="Custom",
            md_bg_color=[0, 0, 0, 0],
            icon_color='white',
            size_hint=(None, None),
            pos_hint={"center_y": 0.5},
            on_release=self.switch_todo_tool,
            ripple_color=boxbg,
            tool='eraser'
        )
        self.todo_scroll_lock_button = ToolButton(
            icon="lock",
            theme_icon_color="Custom",
            md_bg_color=[0, 0, 0, 0],
            icon_color='white',
            size_hint=(None, None),
            pos_hint={"center_y": 0.5},
            ripple_color=boxbg,
            on_release=self.enable_todo
        )
        self.todo_text_box_button = MDIconButton(
            icon="format-textbox",
            theme_icon_color="Custom",
            md_bg_color=[0, 0, 0, 0],
            icon_color='white',
