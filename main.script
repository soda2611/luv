def is_emoji(char):
    cp = ord(char)
    
    if cp in EMOJI_LIKE:
        return True

    return (
        0x2194 <= cp <= 0x2199 or 0x21A9 <= cp <= 0x21AA or 0x231A <= cp <= 0x231B or 0x23E8 <= cp <= 0x23EF or 0x23F0 <= cp <= 0x23F3 or 0x23F8 <= cp <= 0x23FA or 0x25AA <= cp <= 0x25AB or 0x25FB <= cp <= 0x25FE or
        0x2600 <= cp <= 0x2604 or 0x2614 <= cp <= 0x2615 or 0x2622 <= cp <= 0x2623 or 0x262E <= cp <= 0x262F or 0x2638 <= cp <= 0x263A or 0x2648 <= cp <= 0x2653 or 0x2665 <= cp <= 0x2666 or 0x267E <= cp <= 0x267F or
        0x2692 <= cp <= 0x2697 or 0x269B <= cp <= 0x269C or 0x26A0 <= cp <= 0x26A1 or 0x26AA <= cp <= 0x26AB or 0x26B0 <= cp <= 0x26B1 or 0x26BD <= cp <= 0x26BE or 0x26C4 <= cp <= 0x26C5 or 0x26CE <= cp <= 0x26CF or
        0x26E9 <= cp <= 0x26EA or 0x26F0 <= cp <= 0x26F5 or 0x26F7 <= cp <= 0x26FA or 0x2708 <= cp <= 0x270D or 0x2733 <= cp <= 0x2734 or 0x2753 <= cp <= 0x2755 or 0x2763 <= cp <= 0x2764 or 0x2795 <= cp <= 0x2797 or
        0x2934 <= cp <= 0x2935 or 0x2B05 <= cp <= 0x2B07 or 0x2B1B <= cp <= 0x2B1C or 0x26D3 <= cp <= 0x26D4 or 0x1F0CF <= cp <= 0x1F171 or 0x1F17E <= cp <= 0x1F17F or 0x1F191 <= cp <= 0x1F19A or 0x1F201 <= cp <= 0x1F202 or
        0x1F232 <= cp <= 0x1F23A or 0x1F250 <= cp <= 0x1F251 or 0x1F300 <= cp <= 0x1F31F or 0x1F320 <= cp <= 0x1F321 or 0x1F324 <= cp <= 0x1F393 or 0x1F396 <= cp <= 0x1F397 or 0x1F399 <= cp <= 0x1F39B or 0x1F39E <= cp <= 0x1F3F0 or
        0x1F3F3 <= cp <= 0x1F3F5 or 0x1F3F7 <= cp <= 0x1F4FD or 0x1F500 <= cp <= 0x1F53D or 0x1F549 <= cp <= 0x1F54E or 0x1F550 <= cp <= 0x1F567 or 0x1F56F <= cp <= 0x1F570 or 0x1F573 <= cp <= 0x1F57A or 0x1F58A <= cp <= 0x1F58D or
        0x1F595 <= cp <= 0x1F596 or 0x1F5A4 <= cp <= 0x1F5A5 or 0x1F5B1 <= cp <= 0x1F5B2 or 0x1F5C2 <= cp <= 0x1F5C4 or 0x1F5D1 <= cp <= 0x1F5D3 or 0x1F5DC <= cp <= 0x1F5DE or 0x1F5FA <= cp <= 0x1F6C5 or 0x1F6CB <= cp <= 0x1F6D2 or
        0x1F6D5 <= cp <= 0x1F6D8 or 0x1F6DC <= cp <= 0x1F6E5 or 0x1F6EB <= cp <= 0x1F6EC or 0x1F6F3 <= cp <= 0x1F6FC or 0x1F7E0 <= cp <= 0x1F7EB or 0x1F90C <= cp <= 0x1F93A or 0x1F93C <= cp <= 0x1F945 or 0x1F947 <= cp <= 0x1FA7C or
        0x1FA80 <= cp <= 0x1FA8A or 0x1FA8E <= cp <= 0x1FAC6 or 0x1FACD <= cp <= 0x1FADC or 0x1FADF <= cp <= 0x1FAEA or 0x1FAEF <= cp <= 0x1FAF8
    )

def format_text_with_fonts(text, bold=False):
    if not text:
        return ""

    normal_font = "resources/fonts/segoeuib.ttf" if bold else "resources/fonts/segoeui.ttf"
    emoji_font = "resources/fonts/seguiemj.ttf"

    parts = []
    buffer = []
    buffer_is_emoji = None

    for ch in text:
        ch_is_emoji = is_emoji(ch)

        # lần đầu
        if buffer_is_emoji is None:
            buffer.append(ch)
            buffer_is_emoji = ch_is_emoji
            continue

        # cùng loại → gom
        if ch_is_emoji == buffer_is_emoji:
            buffer.append(ch)
        else:
            # khác loại → flush buffer
            font = emoji_font if buffer_is_emoji else normal_font
            parts.append(f"[font={font}]{''.join(buffer)}[/font]")
            buffer = [ch]
            buffer_is_emoji = ch_is_emoji

    # flush phần còn lại
    font = emoji_font if buffer_is_emoji else normal_font
    parts.append(f"[font={font}]{''.join(buffer)}[/font]")

    return "".join(parts)

def android_notify(title, message):
    global message_cache

    from jnius import autoclass
    from kivy.clock import Clock

    def _notify(dt):
        global message_cache

        PythonActivity = autoclass("org.kivy.android.PythonActivity")
        Context = autoclass("android.content.Context")
        NotificationManager = autoclass("android.app.NotificationManager")
        NotificationChannel = autoclass("android.app.NotificationChannel")
        NotificationBuilder = autoclass("android.app.Notification$Builder")
        InboxStyle = autoclass("android.app.Notification$InboxStyle")
        Intent = autoclass("android.content.Intent")
        PendingIntent = autoclass("android.app.PendingIntent")
        Build_VERSION = autoclass("android.os.Build$VERSION")

        context = PythonActivity.mActivity
        nm = context.getSystemService(Context.NOTIFICATION_SERVICE)

        CHANNEL_ID = "chat_message"

        if Build_VERSION.SDK_INT >= 26:
            channel = NotificationChannel(
                CHANNEL_ID,
                "Chat messages",
                NotificationManager.IMPORTANCE_HIGH
            )
            nm.createNotificationChannel(channel)
            builder = NotificationBuilder(context, CHANNEL_ID)
        else:
            builder = NotificationBuilder(context)

        # cache tin nhắn
        message_cache.append(message)
        message_cache = message_cache[-5:]  # giữ tối đa 5 dòng

        style = InboxStyle()
        for msg in message_cache:
            style.addLine(msg)

        style.setSummaryText(f"{len(message_cache)} tin nhắn mới")

        intent = Intent(context, PythonActivity)
        flags = PendingIntent.FLAG_UPDATE_CURRENT
        if Build_VERSION.SDK_INT >= 23:
            flags |= PendingIntent.FLAG_IMMUTABLE

        pending_intent = PendingIntent.getActivity(
            context, 0, intent, flags
        )

        builder.setContentTitle(title)
        builder.setContentText(message)
        builder.setStyle(style)
        builder.setSmallIcon(context.getApplicationInfo().icon)
        builder.setAutoCancel(True)
        builder.setContentIntent(pending_intent)

        nm.notify(1001, builder.build())  # ID CỐ ĐỊNH

    _notify(0)

# --- Notification wrapper ---
def notify_message(title, message):
    if platform == "android":
        android_notify(title, message)
    else:
        notification.notify(title=title, message=message, timeout=5)

def expand_vertical(w, height):
    anim=Animation(height=height, opacity=1, duration=0.3, transition='in_quart')
    anim.start(w)

def collapse_vertical(w):
    anim=Animation(height=0, opacity=0, duration=0.3, transition='out_quart')
    anim.start(w)

