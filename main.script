    def _priority_icon(self, p):
        if p >= 5: return format_text_with_fonts("😍")
        if p == 4: return format_text_with_fonts("🤩")
        if p == 3: return format_text_with_fonts("🌹")
        if p == 2: return format_text_with_fonts("🤔")
        if p == 1: return format_text_with_fonts("💭")

    def switch_text_align(self, instance):
        alignments = ["left", "center", "right", "justify"]
        current_index = alignments.index(self.todo_board.selecting_widget.text_align)
        new_index = (current_index + 1) % len(alignments)
        new_align = alignments[new_index]
        self.todo_board.selecting_widget.text_align = new_align
        self.set_text_align_button.icon = "format-align-{}".format(new_align)

    def toolbar_return(self):
        if self.current_widget_format is not None:
            self.current_widget_format.md_bg_color = bg
        self.todo_toolbar.clear_widgets()
        self.todo_toolbar.add_widget(self.todo_toolbar_background_overlay)

    def open_text_size_slider(self, instance):
        if self.set_text_size_slider.parent is None:
            self.toolbar_return()
            self.todo_toolbar.clear_widgets()
            self.todo_toolbar.add_widget(self.set_text_size_slider)
            self.current_widget_format = self.set_text_size_button
            self.set_text_size_button.md_bg_color = boxbg
            Clock.schedule_once(lambda dt: setattr(self.set_text_size_slider.slider, 'value', self.todo_board.selecting_widget.text_size))
        else:
            self.toolbar_return()

    def open_widget_rotation_slider(self, instance):
        if self.set_widget_rotation_slider.parent is None:
            self.toolbar_return()
            self.todo_toolbar.clear_widgets()
            self.todo_toolbar.add_widget(self.set_widget_rotation_slider)
            self.current_widget_format = self.set_widget_rotation_button
            self.set_widget_rotation_button.md_bg_color = boxbg
            Clock.schedule_once(lambda dt: setattr(self.set_widget_rotation_slider.slider, 'value', self.todo_board.selecting_widget.angle))
        else:
            self.toolbar_return()

    def format_widget_toolbar(self, instance, value):
        if value:
            self.todo_top_bar.add_widget(self.widget_format_toolbar)
            Clock.schedule_once(lambda dt: setattr(self.set_widget_color_button, 'md_bg_color', self.todo_board.selecting_widget.md_bg_color))
            Clock.schedule_once(lambda dt: setattr(self.set_widget_line_color_button, 'md_bg_color', self.todo_board.selecting_widget.line_color))
            Clock.schedule_once(lambda dt: setattr(self.set_widget_text_color_button, 'md_bg_color', self.todo_board.selecting_widget.text_color))
            Clock.schedule_once(lambda dt: setattr(self.set_widget_rotation_slider.slider, 'value', self.todo_board.selecting_widget.angle))
            Clock.schedule_once(lambda dt: setattr(self.set_text_size_slider.slider, 'value', self.todo_board.selecting_widget.text_size))
            Clock.schedule_once(lambda dt: setattr(self.set_text_align_button, 'icon', "format-align-{}".format(self.todo_board.selecting_widget.text_align)))
        else:
            self.todo_top_bar.remove_widget(self.widget_format_toolbar)

    def update_width_value(self, instance, value):
        self.todo_board.pen_width=value
        self.set_pen_width_slider.children[1].text=f"Độ dày bút: {value:.1f}"

    def update_text_size_value(self, instance, value):
        self.todo_board.selecting_widget.text_size=value
        self.set_text_size_slider.children[1].text=f"Cỡ chữ: {value:.1f}"

    def update_widget_rotation_value(self, instance, value):
        self.todo_board.selecting_widget.angle=value
        self.set_widget_rotation_slider.children[1].text=f"Góc xoay: {value:.1f}"

    def open_color_picker(self, instance, obj):
        def set_whiteboard_widget_color(color):
            color_picker.dismiss()
            self.set_widget_color_button.md_bg_color=color
            self.todo_board.selecting_widget.md_bg_color = color

        def set_whiteboard_pen_color(color):
            color_picker.dismiss()
            self.set_pen_color_button.md_bg_color=color
            self.todo_board.pen_color = color
            if self.todo_board.tool == 'pen':
                self.todo_board.deselect_all()

        def set_whiteboard_widget_text_color(color):
            color_picker.dismiss()
            self.set_widget_text_color_button.md_bg_color=color
            self.todo_board.selecting_widget.text_color = color

        def set_whiteboard_widget_line_color(color):
            color_picker.dismiss()
            self.set_widget_line_color_button.md_bg_color=color
            self.todo_board.selecting_widget.line_color = color

        mode={"widget": set_whiteboard_widget_color, "pen": set_whiteboard_pen_color, "text": set_whiteboard_widget_text_color, "line": set_whiteboard_widget_line_color}
        default_color = {"widget": self.todo_board.selecting_widget.md_bg_color if self.todo_board.selecting_widget else (0, 0, 0, 1), "pen": self.todo_board.pen_color, "text": self.todo_board.selecting_widget.text_color if self.todo_board.selecting_widget else (0, 0, 0, 1), "line": self.todo_board.selecting_widget.line_color if self.todo_board.selecting_widget else (0, 0, 0, 1)}

        color_picker = ProColorPickerPopup(on_select=mode[obj])
        
        default = default_color[obj]
        r, g, b, _ = default
        h, s, v = colorsys.rgb_to_hsv(r, g, b)

        p = color_picker.picker

        p.hue = h
        p.saturation = s
        p.value = v

        p.sv_area.hue = h
        p.sv_area.saturation = s
        p.sv_area.value = v

        p.opacity_slider.slider.value = default[3]

        p.update_color()
        p.sv_area._update_pointer()
        p.hue_slider.hue = h
        p.hue_slider.update_pointer()

        color_picker.open()

    def add_new_todo_widget(self, *args):
        if not todo_draw_mode:
            return
        # tạo id cố định để sync realtime (đừng để server tự sinh)
        wid = norm_uuid_hyphen(str(uuid4().hex))
        w = DraggableResizableWidget(
            wid,
            pos=(0 ,0)
        )
        self.todo_board.add_widget(w)

        def _place(_dt):
            w.pos = (self.todo_scroll.scroll_x * dp(100000) + dp(50), self.todo_scroll.scroll_y * dp(100000) - dp(250))
            w.size = (dp(200), dp(150))

        Clock.schedule_once(_place, 0)

        # Đảm bảo board đang mở có name
        if not self.current_open_board:
            # bạn có thể show toast ở đây, mình chỉ print
            print("No whiteboard is open; cannot insert widget.")
            return

        # Đưa vào map + bind + insert
        self.todo_widget_by_id[wid] = w
        self.todo_board.set_selected_widget(w)  # (giữ UX như cũ)
        self._attach_widget_bindings(w)
        # Gửi INSERT lên DB
        threading.Thread(target=lambda: self._insert_widget_to_db(w), daemon=True).start()
    
    def enable_todo(self, instance):
        global todo_draw_mode
        instance.icon = "lock-open" if not todo_draw_mode else "lock"
        self.todo_scroll.do_scroll, todo_draw_mode = [True, False] if todo_draw_mode else [False, True]
        self.todo_board.deselect_all()
        self.switch_todo_tool(self.last_todo_tool)
        self.todo_cursor_button.disabled = not todo_draw_mode
        self.todo_pen_button.disabled = not todo_draw_mode
        self.todo_eraser_button.disabled = not todo_draw_mode
    
    def switch_todo_tool(self, instance):
        self.last_todo_tool.icon_color='white'
        instance.icon_color='black'
        self.todo_toolbar_button_background.pos_hint={"center_y": 0.5}
        Animation(x=instance.x, duration=0.3, transition='out_quart').start(self.todo_toolbar_button_background)
        self.last_todo_tool=instance
        self.todo_board.tool=instance.tool
        if self.todo_board.tool != 'cursor':
            self.todo_board.deselect_all()
            self.todo_text_box_button.disabled = True
        else: self.todo_text_box_button.disabled = not todo_draw_mode
        if self.todo_board.tool == 'pen':
            self.todo_top_bar.remove_widget(self.set_pen_color_button)
            self.todo_top_bar.remove_widget(self.set_pen_width_slider)
            self.todo_top_bar.add_widget(self.set_pen_color_button)
            self.todo_top_bar.add_widget(self.set_pen_width_slider)
        else:
            self.todo_top_bar.remove_widget(self.set_pen_color_button)
            self.todo_top_bar.remove_widget(self.set_pen_width_slider)

    def set_ttbgo_width(self, *args):
        self.todo_toolbar_background_overlay.width=self.todo_toolbar_button_overlay.width
        self.todo_toolbar_button_background.x=self.last_todo_tool.x
    
    def stroke_to_norm_points(self, stroke):
        cw, ch = self.draw_canvas.width, self.draw_canvas.height
        norm_pts = []

        for x, y in stroke["points"]:
            nx = x / cw
            ny = y / ch
            norm_pts.append((nx, ny))

        return norm_pts
    
    def update_stroke_to_db(self, stroke):
        stroke_id = norm_uuid_hyphen(stroke["id"])
        points = self.stroke_to_norm_points(stroke)

        data = {
            "points": points
        }

        def send():
            url = f"{SUPABASE_URL}/rest/v1/draw?id=eq.{stroke_id}"
            res = requests.patch(url, headers=headers, json=data)
            if res.status_code not in (200, 204):
                print("STROKE UPDATE FAIL:", res.text)

        threading.Thread(target=send, daemon=True).start()
    
    def _on_local_stroke_deleted(self, stroke_id):
        def send():
            url = f"{SUPABASE_URL}/rest/v1/draw?id=eq.{norm_uuid_hyphen(stroke_id)}"
            requests.delete(url, headers=headers)

        threading.Thread(target=send, daemon=True).start()

    def _on_local_stroke_finished(self, stroke):
        points = []
        cw, ch = self.draw_canvas.width, self.draw_canvas.height

        for x, y in stroke["points"]:
            nx = x / cw
            ny = y / ch
            points.append((nx, ny))

        data = {
            "id": norm_uuid_hyphen(stroke["id"]),
            "sender": self.user_id,
            "points": points,
            "width": self.draw_canvas.pen_width,  # scale theo canvas
            "color": list(self.draw_canvas.pen_color),
            "created_at": time.strftime("%H:%M"),
            "date": normalize_date(self.lookup_date)
        }

        def send():
            url = f"{SUPABASE_URL}/rest/v1/draw"
            res = requests.post(url, headers=headers, json=data)
            if res.status_code not in (200, 201):
                print("DRAW INSERT FAIL:", res.text)

        threading.Thread(target=send, daemon=True).start()
    
    def _on_local_todo_stroke_deleted(self, stroke_id):
        def send():
            url = f"{SUPABASE_URL}/rest/v1/draw?id=eq.{norm_uuid_hyphen(stroke_id)}"
            requests.delete(url, headers=headers)

        threading.Thread(target=send, daemon=True).start()

    def _on_local_todo_stroke_finished(self, stroke):
        points = []
        cw, ch = self.todo_board.width, self.todo_board.height

        for x, y in stroke["points"]:
            nx = x / cw
            ny = y / ch
            points.append((nx, ny))

        data = {
            "id": norm_uuid_hyphen(stroke["id"]),
            "sender": self.user_id,
            "points": points,
            "width": self.todo_board.pen_width,  # scale theo canvas
            "color": list(self.todo_board.pen_color),
            "created_at": time.strftime("%H:%M"),
            "date": normalize_date(self.lookup_date),
            "file": self.current_open_board
        }

        def send():
            url = f"{SUPABASE_URL}/rest/v1/draw"
            res = requests.post(url, headers=headers, json=data)
            if res.status_code not in (200, 201):
                print("DRAW INSERT FAIL:", res.text)

        threading.Thread(target=send, daemon=True).start()

    def _on_local_widget_deleted(self, widget_id: str):
        # Gửi DELETE
        threading.Thread(target=lambda: self._delete_widget_in_db(widget_id), daemon=True).start()

    def load_widgets(self, name):
        self.todo_widget_by_id.clear()
        for child in list(self.todo_board.children):
            if isinstance(child, DraggableResizableWidget):
                self.todo_board.remove_widget(child)

        try:
            url = (f"{SUPABASE_URL}/rest/v1/widgets"
                f"?select=*&file=eq.{name}"
                f"&order=created_at.asc")
            res = _api.get(url, timeout=_api_timeout)
            res.raise_for_status()
            rows = res.json() or []
        except Exception as e:
            print("LOAD WIDGETS ERR:", e)
            rows = []

        def _apply(_dt):
            for rec in rows:
                self._apply_widget_record(rec, is_update=False)
        Clock.schedule_once(_apply, 0)

    def _debounced_reload(self, date_str, delay=0.25):
        if self._reload_timer:
            try: self._reload_timer.cancel()
            except: pass
            self._reload_timer = None
        self._reload_timer = Clock.schedule_once(lambda dt: self.load_strokes(date_str), delay) 

    def on_scroll(self, scroll, value):
        return
    
    def sync_overlay_height(self, *args):
        paper_height = max(self.msg_list.height, self.msg_scroll.height)
        todo_paper_height = max(self.todo_browse.height, self.todo_scroll.height)

        old_h = self.draw_canvas.height

        self.todo_container.height=todo_paper_height
        self.container.height = paper_height
        self.draw_canvas.width = self.container.width
        self.draw_canvas.height = paper_height

        if old_h != paper_height:
            self.update_all_strokes_after_resize()

    def update_all_strokes_after_resize(self):
        if hasattr(self, "_resize_timer") and self._resize_timer:
            self._resize_timer.cancel()

        self._resize_timer = Clock.schedule_once(
            lambda dt: self._commit_stroke_resize(),
            0.3
        )

    def _commit_stroke_resize(self):
        for stroke in self.draw_canvas.strokes.values():
            self.update_stroke_to_db(stroke)

    # ==============================
    # Widgets: serialize/deserialize
    # ==============================
    def _serialize_widget(self, w: DraggableResizableWidget):
        cw, ch = self.todo_board.width, self.todo_board.height
        # chuẩn hoá 0..1 theo gốc dưới-trái
        nx = float(w.x) / float(cw) if cw else 0.0
        ny = float(w.y) / float(ch) if ch else 0.0
        nw = float(w.width) / float(cw) if cw else 0.0
        nh = float(w.height) / float(ch) if ch else 0.0
        return {
            "id": w.widget_id,
            "file": self.current_open_board,
            "sender": self.user_id,
            "x": nx, "y": ny, "w": nw, "h": nh,
            "angle": float(getattr(w, "angle", 0.0)),
            "bg_color": list(w.md_bg_color),
            "line_color": list(w.line_color) if hasattr(w, "line_color") else [0,0,0,0],
            "text_color": list(w.text_color) if hasattr(w, "text_color") else [0,0,0,1],
            "text": w.text,
            "text_size": float(w.text_size),
            "text_align": w.text_align or "center",
        }

    def _apply_widget_record(self, rec, *, is_update=False):
        if not self.current_open_board or rec.get("file") != self.current_open_board:
            return  # chỉ áp cho whiteboard đang mở

        wid =  norm_uuid_hyphen(rec["id"])
        cw, ch = self.todo_board.width, self.todo_board.height
        x = float(rec["x"]) * cw
        y = float(rec["y"]) * ch
        w = max(1.0, float(rec["w"]) * cw)
        h = max(1.0, float(rec["h"]) * ch)
        angle = float(rec.get("angle", 0.0))
        bg = list(rec.get("bg_color", [1,1,1,1]))
        lc = list(rec.get("line_color", [0,0,0,0]))
        tc = list(rec.get("text_color", [0,0,0,1]))
        text = rec.get("text", "Double-click để chỉnh sửa") or ""
        tsz  = float(rec.get("text_size", 14))
        talign = rec.get("text_align", "center") or "center"

        # Tắt phát lại PATCH khi set thuộc tính (tránh vòng lặp)
        self._suppress_widget_events.add(wid)
        try:
            if wid not in self.todo_widget_by_id:
                # tạo mới
                wdg = DraggableResizableWidget(widget_id=wid)
                # kích thước + style + text
                wdg.pos = (x, y)
                wdg.angle = angle
                wdg.size = (w, h)
                wdg.md_bg_color = bg
                wdg.line_color = lc
                wdg.text_color = tc
                wdg.text_size = tsz
                wdg.text_align = talign
                wdg.text = text
                # cập nhật label hiển thị
                # (Widget class đã tự bind _update_content_text, nên gán text/text_size/text_align đủ)
                self.todo_board.add_widget(wdg)
                self.todo_widget_by_id[wid] = wdg
                # gắn các binding để gửi UPDATE khi user sửa
                self._attach_widget_bindings(wdg)
            else:
                wdg = self.todo_widget_by_id[wid]
                # cập nhật thuộc tính
                wdg.pos = (x, y)
                wdg.size = (w, h)
                wdg.angle = angle
                wdg.md_bg_color = bg
                wdg.line_color = lc
                wdg.text_color = tc
                wdg.text_size = tsz
                wdg.text_align = talign
                wdg.text = text
        finally:
            Clock.schedule_once(lambda dt: self._suppress_widget_events.discard(wid), 0)

    def _attach_widget_bindings(self, wdg: DraggableResizableWidget):
        # Debounce update theo ID
        def _schedule_update(*args):
            if wdg.widget_id in self._suppress_widget_events:
                return
            # gom dữ liệu hiện tại và gửi PATCH sau 100ms

            def get_patch():
                payload = self._serialize_widget(wdg)
                url = f"{SUPABASE_URL}/rest/v1/widgets?id=eq.{payload['id']}"
                try:
                    res = requests.patch(url, headers=headers, json=payload)
                    if res.status_code not in (200, 204):
                        print("WIDGET PATCH FAIL:", res.text)
                except Exception as e:
                    print("WIDGET PATCH ERR:", e)

            def _do_patch(__dt):
                threading.Thread(target=get_patch).start()

            # huỷ timer cũ nếu có, rồi đặt lại
            if wdg.widget_id in self._widget_update_timers:
                try: self._widget_update_timers[wdg.widget_id].cancel()
                except: pass
            self._widget_update_timers[wdg.widget_id] = Clock.schedule_once(_do_patch, 0.1)

        # vị trí/kích thước/góc
        wdg.bind(pos=_schedule_update, size=_schedule_update, angle=_schedule_update)
        # nội dung & style
        wdg.bind(text=_schedule_update, text_size=_schedule_update, text_align=_schedule_update)
        wdg.bind(text_color=_schedule_update, line_color=_schedule_update)
        # bg color của widget là md_bg_color (thuộc tính MDCard) → phải bind thông qua on_...
        # KivyMD không luôn phát sự kiện property cho md_bg_color, nên bọc lại bằng schedule nhỏ:
        def _on_bg_color_change(*_):
            _schedule_update()
        # gọi khi bạn đổi màu qua color picker
        # (ở chỗ set pen/widget color bạn có thao tác gán md_bg_color trực tiếp)
        wdg.bind(md_bg_color=lambda *_: Clock.schedule_once(lambda __: _on_bg_color_change(), 0))

    def _insert_widget_to_db(self, wdg: DraggableResizableWidget):
        payload = self._serialize_widget(wdg)
        url = f"{SUPABASE_URL}/rest/v1/widgets"
        try:
            res = requests.post(url, headers=headers, json=payload)
            if res.status_code not in (200, 201):
                print("WIDGET INSERT FAIL:", res.text)
        except Exception as e:
            print("WIDGET INSERT ERR:", e)

    def _delete_widget_in_db(self, widget_id: str):
        url = f"{SUPABASE_URL}/rest/v1/widgets?id=eq.{widget_id}"
        try:
            res = requests.delete(url, headers=headers)
            if res.status_code not in (200, 204):
                print("WIDGET DELETE FAIL:", res.text)
        except Exception as e:
            print("WIDGET DELETE ERR:", e)

    def date_picker_open(self):
        self.menu.dismiss()
        date_dialog = MDDatePicker(title_input="Nhập ngày check", title="Chọn ngày check", primary_color=menubg, accent_color=bg, selector_color=btn, text_button_color="black", input_field_background_color_focus=boxbg, input_field_background_color_normal=boxbg[:-1]+(0.25,), input_field_text_color_focus="black", text_weekday_color=btn, helper_text="", text_current_color=menubg)
        date_dialog.bind(on_save=self.load_messages)
        date_dialog.open()
    
    def menu_open(self, instance):
        menu_items = [
            {
                "text": "Mở chế độ vẽ" if not draw_mode else "Tắt chế độ vẽ",
                "text_color": primarycolor,
                "trailing_icon": "brush",
                "theme_trailing_icon_color": "Custom",
                "trailing_icon_color": primarycolor,
                "on_release": self.draw_mode
            },
            {
                "text": "Whiteboard",
                "text_color": primarycolor,
                "trailing_icon": "drawing",
                "theme_trailing_icon_color": "Custom",
                "trailing_icon_color": primarycolor,
                "on_release": self.open_todo_board,
                "disabled": True if draw_mode else False
            },
            {
                "text": "Wishlist",
                "text_color": primarycolor,
                "trailing_icon": "creation",
                "theme_trailing_icon_color": "Custom",
                "trailing_icon_color": primarycolor,
                "on_release": self.open_wishlist_screen,
                "disabled": True if draw_mode else False
            },
            {
                "text": "Check tin nhắn cũ",
                "text_color": primarycolor,
                "trailing_icon": "history",
                "theme_trailing_icon_color": "Custom",
                "trailing_icon_color": primarycolor,
                "on_release": self.date_picker_open,
                "disabled": True if draw_mode else False
            },
            {
                "text": "Đổi UID",
                "text_color": primarycolor,
                "trailing_icon": "account",
                "theme_trailing_icon_color": "Custom",
                "trailing_icon_color": primarycolor,
                "on_release": self.show_uid_dialog
            }
        ]

        if draw_mode: menu_items=menu_items[:1]+[
            {
                "text": "Chọn Bút" if not self.draw_canvas.tool=="pen" else"Chọn Tẩy",
                "text_color": primarycolor,
                "trailing_icon": "pencil" if not self.draw_canvas.tool=="pen" else "eraser",
                "theme_trailing_icon_color": "Custom",
                "trailing_icon_color": primarycolor,
                "on_release": self.set_tool_pen if not self.draw_canvas.tool=="pen" else self.set_tool_eraser,
                "disabled": False
            }]+menu_items[1:]
        
        self.menu=MDDropdownMenu(
            caller=self.uid_button,
            items=menu_items,               
            ver_growth="down",
            hor_growth="left",
            md_bg_color=menubg,
            position="bottom"
        )
        self.menu.open()

    def open_todo_board(self, *args):
        self.menu.dismiss()
        self.sm.current='to-do'

    def set_tool_pen(self, *args):
        try: self.menu.dismiss()
        except: pass
        self.draw_canvas.tool = "pen"

    def set_tool_eraser(self, *args):
        try: self.menu.dismiss()
        except: pass
        self.draw_canvas.tool = "eraser"

    def draw_mode(self, *args):
        global draw_mode
        self.menu.dismiss()
        self.set_tool_pen()
        self.msg_scroll.do_scroll, draw_mode = [True, False] if draw_mode else [False, True]

    def show_uid_dialog(self, *args):
        try: self.menu.dismiss()
        except: pass
        self.uid_input = MDTextField(hint_text="Đặt UID nề bbi <3",
                                    font_name="resources/fonts/segoeui.ttf",
                                    line_color_normal=boxbg,
                                    line_color_focus=boxbg,
                                    hint_text_color=[0.75 - i for i in primarycolor],
                                    hint_text_color_focus=primarycolor,
                                    text_color_focus=primarycolor,
                                    fill_color_normal=boxbg,
                                    size_hint=(1, None),
                                    pos_hint={'center_y': 0.5},
                                    height=dp(30),
                                    multiline=False)
        self.dialog = MDDialog(
            title="Nhập UID",
            type="custom",
            content_cls=self.uid_input,
            buttons=[MDFillRoundFlatButton(text="OK", on_release=self.save_uid, md_bg_color=btn)],
            md_bg_color=menubg
        )
        self.dialog.open()

    def show_whiteboard_dialog(self, *args):
        try: self.menu.dismiss()
        except: pass
        self.whiteboard_input = MDTextField(hint_text="Đặt tên whiteboard nề bbi <3",
                                    font_name="resources/fonts/segoeui.ttf",
                                    line_color_normal=boxbg,
                                    line_color_focus=boxbg,
                                    hint_text_color=[0.75 - i for i in primarycolor],
                                    hint_text_color_focus=primarycolor,
                                    text_color_focus=primarycolor,
                                    fill_color_normal=boxbg,
                                    size_hint=(1, None),
                                    pos_hint={'center_y': 0.5},
                                    height=dp(30),
                                    multiline=False,
                                    on_text_validate=self.create_whiteboard)
        self.dialog = MDDialog(
            title="Nhập tên whiteboard",
            type="custom",
            content_cls=self.whiteboard_input,
            buttons=[MDFillRoundFlatButton(text="OK", on_release=self.create_whiteboard, md_bg_color=btn)],
            md_bg_color=menubg
        )
        self.dialog.open()

    def save_uid(self, *args):
        uid = self.uid_input.text.strip()
        if uid:
            self.user_id = uid
            self.uid_button.text = uid
            with open("uid.txt", "w") as f:
                f.write(uid)
            self.dialog.dismiss()

    def on_text_change(self, instance, value):
        """Enable/disable send button based on text input"""
        self.text_input.button.disabled = not value.strip()

    def change_text(self, instance):
        if instance.text=="\u2600 <3 \u2B50":
            instance.text=str((datetime.now() - datetime.strptime("26/11/2025", "%d/%m/%Y")).days) + " ngày iu"
        else: instance.text="\u2600 <3 \u2B50"

    def send_msg(self, *args):
        if not self.user_id:
            self.show_uid_dialog()
            return
        
        if self.lookup and normalize_date(self.lookup_date) != datetime.strftime(datetime.now(), "%d/%m/%Y"):
            self.lookup=False
            self.msg_list.clear_widgets()
            self.load_messages()
        
        try: self.msg_list.remove_widget(msg_id_list['0000'].parent)
        except: pass

        msg = self.text_input.input.text
        if msg:
            url = f"{SUPABASE_URL}/rest/v1/messages"
            data = {"sender": self.user_id, "content": msg, "created_at": time.strftime("%H:%M"), "date": time.strftime("%d/%m/%Y")}
            res = requests.post(url, headers=headers, json=data)
            if res.status_code == 201:
                self.text_input.input.text = ""
                if 'iu' in msg.lower().translate(str.maketrans('', '', '.,?!')).split(): Clock.schedule_once(lambda x: self.spawn_emoji(multi=True))
            else:
                print("Error:", res.text)

    def create_whiteboard(self, *args):
        if not self.user_id:
            self.show_uid_dialog()
            return
        
        if hasattr(self.todo_scroll.children[0], 'text'):
            if self.todo_scroll.children[0].text=='Chưa có whiteboard nào được tạo hết ;-;': self.todo_scroll.remove_widget(self.todo_scroll.children[0])

        name_ = self.whiteboard_input.text
        if name_:
            url = f"{SUPABASE_URL}/rest/v1/todo"
            data = {"whiteboard_name": name_, "created_at": time.strftime("%d/%m/%Y")}
            requests.post(url, headers=headers, json=data)
            self.dialog.dismiss()

    def delete_whiteboard(self, file_id, name):
        def send():
            url = f"{SUPABASE_URL}/rest/v1/todo?id=eq.{norm_uuid_hyphen(file_id)}"
            requests.delete(url, headers=headers)

            url = f"{SUPABASE_URL}/rest/v1/draw?&file=eq.{name}"
            requests.delete(url, headers=headers)

        threading.Thread(target=send, daemon=True).start()

    def load_messages(self, instance=None, date_str=datetime.strftime(datetime.now(), '%d/%m/%Y'), data_range=None):
        self.lookup_date = date_str
        self.draw_canvas.clear_all()
        self.msg_list.clear_widgets()

        if not self.noti.button.disabled:
            self.noti.button.disabled = True
            collapse_vertical(self.noti)

        if instance:
            date_str = datetime.strptime(str(date_str), "%Y-%m-%d").strftime("%d/%m/%Y")

        def _fetch():
            url = f"{SUPABASE_URL}/rest/v1/messages?select=*&date=eq.{date_str}&order=created_at.asc"
            rows = []
            try:
                res = _api.get(url, timeout=_api_timeout)
                res.raise_for_status()
                rows = res.json() or []
            except Exception as e:
                print("LOAD_MESSAGES ERR:", e)

            def _apply(_dt):
                self.lookup = (date_str != datetime.strftime(datetime.now(), "%d/%m/%Y"))
                if rows:
                    for row in rows:
                        self.display_message(row['sender'], row['content'], row['created_at'], row['date'], row['id'])
                else:
                    if datetime.strptime(date_str, "%d/%m/%Y") < datetime.now() and self.lookup:
                        self.display_message('ngha' if self.user_id == 'hmn' else 'hmn',
                                            'Không có tin nhắn nào cho ngày này hết ;-;',
                                            '00:00', date_str, msg_id='0000')
                    else:
                        self.display_message('ngha' if self.user_id == 'hmn' else 'hmn',
                                            f"Mong chờ những lời iu thương của {'hmn' if self.user_id=='hmn' else 'ngha'} qaaa :3",
                                            '00:00', date_str, msg_id='0000')
                Clock.schedule_once(self.scroll_to_bottom)
                Clock.schedule_once(lambda dt: self.load_strokes(date_str), 0)

            Clock.schedule_once(_apply, 0)

        run_bg(_fetch)

    def load_todo_list(self, instance=None):
        self.todo_scroll.clear_widgets()
        self.todo_scroll.add_widget(self.todo_browse)
        if self.todo_top_icon not in self.todo_top_bar.children: self.todo_top_bar.add_widget(self.todo_top_icon, index=-1)
        if self.todo_new_whiteboard_button not in self.sm.get_screen("to-do").children[0].children: self.sm.get_screen("to-do").children[0].add_widget(self.todo_new_whiteboard_button)
        self.sm.get_screen("to-do").children[0].remove_widget(self.todo_toolbar)
        self.todo_top_bar.remove_widget(self.todo_top_back)
        self.todo_top_bar.remove_widget(self.set_pen_color_button)
        self.todo_top_bar.remove_widget(self.set_pen_width_slider)
        self.todo_top_bar.remove_widget(self.widget_format_toolbar)
        self.current_open_board=None
        self.todo_browse.clear_widgets()

        def _fetch():
            rows = []
            try:
                url = f"{SUPABASE_URL}/rest/v1/todo?select=*"
                res = _api.get(url, timeout=_api_timeout)
                res.raise_for_status()
                rows = res.json() or []
            except Exception as e:
                print("LOAD_TODO_LIST ERR:", e)

            def _apply(_dt):
                self.todo_browse.clear_widgets()
                if rows:
                    for row in rows[-10:]:
                        if row['created_at'] == "06/03/2026" and (self.user_id != "hmn" and datetime.now() < datetime.strptime("06/03/2026", "%d/%m/%Y")):
                            continue
                        self.display_file(row['whiteboard_name'], row['created_at'], row['id'])
                else:
                    self.todo_scroll.clear_widgets()
                    self.todo_scroll.add_widget(MDLabel(
                        text="Chưa có whiteboard nào được tạo hết ;-;", halign='center', valign='center', size_hint=(1, 1)
                    ))

            Clock.schedule_once(_apply, 0)

        run_bg(_fetch)

    def load_strokes(self, date_str):
        def _fetch():
            try:
                url = (
                    f"{SUPABASE_URL}/rest/v1/draw"
                    f"?select=id,points,width,color,file"
                    f"&date=eq.{date_str}"
                    f"&order=created_at.asc"
                )
                res = _api.get(url, timeout=_api_timeout)
                res.raise_for_status()
                rows = res.json() or []
            except Exception as e:
                print("LOAD STROKES FAIL:", e)
                rows = []

            def _apply(_dt):
                self.draw_canvas.clear_all()
                cw, ch = self.draw_canvas.width, self.draw_canvas.height
                for row in rows:
                    if row["file"]:
                        continue
                    pts = []
                    for nx, ny in row["points"]:
                        x = nx * cw
                        y = ch - (ny * ch)
                        pts.append((x, y))
                    if pts:
                        self.draw_canvas.draw_remote_stroke({
                            "stroke_id": norm_uuid_hyphen(row["id"]),
                            "points": pts,
                            "width": row["width"],
                            "color": tuple(row["color"]),
                        })
            Clock.schedule_once(_apply, 0)

        run_bg(_fetch)

    def load_todo_strokes(self, name):
        self.todo_scroll.clear_widgets()
        self.todo_scroll.add_widget(self.todo_board)
        self.todo_top_bar.add_widget(self.todo_top_back, index=-1)
        self.todo_top_bar.remove_widget(self.todo_top_icon)
        self.current_open_board=name
        self.sm.get_screen("to-do").children[0].add_widget(self.todo_toolbar)
        self.sm.get_screen("to-do").children[0].remove_widget(self.todo_new_whiteboard_button)
        if todo_draw_mode: self.enable_todo(self.todo_scroll_lock_button)
        if self.last_todo_tool!=self.todo_cursor_button: self.switch_todo_tool(self.todo_cursor_button)

        def _fetch():
            rows = []
            try:
                url = (
                    f"{SUPABASE_URL}/rest/v1/draw"
                    f"?select=id,points,width,color"
                    f"&file=eq.{name}"
                    f"&order=created_at.asc"
                )
                res = _api.get(url, timeout=_api_timeout)
                res.raise_for_status()
                rows = res.json() or []
            except Exception as e:
                print("LOAD TODO STROKES FAIL:", e)

            def _apply(_dt):
                self.todo_board.clear_all()
                self.todo_board.clear_widgets()
                cw, ch = self.todo_board.width, self.todo_board.height
                for row in rows:
                    pts = []
                    for nx, ny in row["points"]:
                        x = nx * cw
                        y = ch - (ny * ch)
                        pts.append((x, y))
                    if pts:
                        self.todo_board.draw_remote_stroke({
                            "stroke_id": norm_uuid_hyphen(row["id"]),
                            "points": pts,
                            "width": row["width"],
                            "color": tuple(row["color"])
                        })
                # tải widgets ở nền
                run_bg(lambda: self.load_widgets(name))
            Clock.schedule_once(_apply, 0)

        run_bg(_fetch)

    def scroll_to_bottom(self, *args):        
        Animation(scroll_y=0, transition="out_quad").start(self.msg_scroll)

    def display_message(self, sender, content, timestamp, date, msg_id):
        global msg_id_list
        if self.last_date==None or self.last_date != date:
            date_label = MDLabel(
                text=f"[size={int(dp(12))}]{format_text_with_fonts(date)}[/size]",
                halign="center",
                theme_text_color="Custom",
                text_color=primarycolor,
                size_hint=(1, None),
                height=dp(30),
                markup=True
            )
            self.msg_list.add_widget(date_label)
            self.last_date = date

        """Display a message with modern UI styling"""
        
        # Check if last message is from same sender within 1 minute
        should_merge = False
        if len(self.msg_list.children) > 0:
            last_widget = self.msg_list.children[0]
            if hasattr(last_widget, 'sender') and last_widget.sender == sender:
                try:
                    current_time = datetime.strptime(timestamp, "%H:%M")
                    last_time = datetime.strptime(last_widget.last_timestamp, "%H:%M")
                    time_diff = abs((current_time - last_time).total_seconds())
                    if time_diff <= 60:
                        should_merge = True
                except:
                    pass
        
        if should_merge:
            # Append to existing card
            last_widget = self.msg_list.children[0]
            msg_label = MDLabel(
                text=format_text_with_fonts(content),
                halign="left",
                theme_text_color="Custom",
                text_color=primarycolor,
                size_hint=(1, None),
                markup=True
            )
            msg_label.bind(texture_size=msg_label.setter('texture_size'))
            msg_label.bind(texture_size=msg_label.setter('size'))
            last_widget.add_widget(msg_label)
            last_widget.last_timestamp = timestamp
        else:
            # Create new card
            msg_card = MDCard(
                orientation="vertical",
                size_hint=(1, None),
                padding=[dp(10), dp(10), dp(10), dp(10)],
                spacing=dp(5),
                md_bg_color=boxbg[:-1]+(0.25,),
                radius=[dp(10), dp(10), dp(10), dp(10)],
                elevation=0,
                on_release=lambda x: self.send_emoji(pos=Window.mouse_pos)
            )
            msg_card.sender = sender
            msg_card.last_timestamp = timestamp
            
            # Message header with sender name
            header_layout = MDBoxLayout(size_hint=(1, None), height=dp(25), spacing=dp(5))
            morning = datetime.strptime("05:00", "%H:%M").time()
            evening = datetime.strptime("18:00", "%H:%M").time()
            emoji = "\u2600" if morning <= datetime.strptime(timestamp, "%H:%M").time() <= evening else "\u2B50"
            symbol = "\u2022"
            sender_label = MDLabel(
                text=f"[size={int(dp(14))}]{format_text_with_fonts(f'{sender} {symbol} {timestamp} {emoji}', True)}[/size]",
                size_hint=(1, None),
                height=dp(25),
                theme_text_color="Custom",
                text_color=primarycolor,
                font_size=dp(14),
                markup=True
            )
            header_layout.add_widget(sender_label)
            
            # Message content
            msg_label = MDLabel(
                text=format_text_with_fonts(content),
                halign="left",
                theme_text_color="Custom",
                text_color=primarycolor,
                size_hint=(1, None),
                markup=True
            )
            msg_label.bind(texture_size=msg_label.setter('texture_size'))
            msg_label.bind(texture_size=msg_label.setter('size'))
            
            msg_card.add_widget(header_layout)
            msg_card.add_widget(msg_label)
            msg_card.bind(minimum_height=msg_card.setter('height'))
            
            self.msg_list.add_widget(msg_card)
        
        msg_id_list[msg_id]=msg_label

    def display_file(self, file, timestamp, file_id):
        global file_id_list
        """Display a message with modern UI styling"""
        
        # Create new card
        file_card = MDCard(
            orientation="vertical",
            size_hint=(1, None),
            padding=[dp(10), dp(10), dp(10), dp(10)],
            spacing=dp(5),
            md_bg_color=boxbg[:-1]+(0.25,),
            radius=[dp(10), dp(10), dp(10), dp(10)],
            elevation=0,
            on_release=lambda dt: Clock.schedule_once(lambda x: self.load_todo_strokes(file))
        )
        
        # Message header with file name
        header_layout = MDBoxLayout(size_hint=(1, None), height=dp(25), spacing=dp(5))
        symbol = "\u2022"
        file_label = MDLabel(
            text=f"[size={int(dp(14))}]{format_text_with_fonts(f'{file} {symbol} {timestamp}', True)}[/size]",
            size_hint=(1, None),
            height=dp(25),
            theme_text_color="Custom",
            text_color=primarycolor,
            font_size=dp(14),
            markup=True
        )
        file_delete_button=MDIconButton(icon="delete", theme_icon_color="Custom", icon_color="red", pos_hint={"center_y": 0.5}, on_release=lambda dt: self.delete_whiteboard(file_id, file))
        header_layout.add_widget(file_label)
        header_layout.add_widget(file_delete_button)
        
        file_card.add_widget(header_layout)
        file_card.bind(minimum_height=file_card.setter('height'))
        
        self.todo_browse.add_widget(file_card)
        
        file_id_list[file_id]=file_card

    def spawn_emoji(self, emoji="\U0001F496", pos=(0, 0), multi=False):
        if not multi:
            label = MDLabel(
                text=format_text_with_fonts(emoji),
                font_size="32sp",
                size_hint=(None, None),
                pos=(pos[0] - 25, pos[1] - 25),
                markup=True
            )

            Window.add_widget(label)

            # animation bay lên + mờ dần
            anim = (
                Animation(y=label.y + 60, opacity=0, duration=0.8)
            )

            anim.bind(on_complete=lambda *x: Window.remove_widget(label))
            anim.start(label)
        else:
            count = random.randint(10, 15)

            win_w, win_h = Window.size

            for _ in range(count):
                # spawn ở đáy màn hình
                x = random.randint(0, int(win_w - 50))
                y = -50

                # đích đến random toàn màn hình
                target_y = random.randint(int(win_h * 0.3), int(win_h))

                label = MDLabel(
                    text=format_text_with_fonts(emoji),
                    font_size="32sp",
                    size_hint=(None, None),
                    pos=(x, y),
                    opacity=1,
                    markup=True
                )

                Window.add_widget(label)

                # bay nhẹ lên + fade
                dy = random.randint(40, 100)

                anim = Animation(
                    y=target_y,
                    opacity=0,
                    duration=random.uniform(3, 5),
                    t="out_quad"
                )

                anim.bind(on_complete=lambda *x: Window.remove_widget(label))
                anim.start(label)
    
    def send_emoji(self, pos=(0, 0)):
        self.spawn_emoji(pos=pos)

        def send():
            w, h = Window.size
            url = f"{SUPABASE_URL}/rest/v1/reaction"
            data = {
                "sender": self.user_id,
                "x": float(pos[0]) / w,
                "y": float(pos[1]) / h,
                "created_at": time.strftime("%H:%M"),
                "date": time.strftime("%d/%m/%Y")
            }
            requests.post(url, headers=headers, json=data)

        threading.Thread(target=send).start()

    def _flush_draw_queue(self, dt):
        if not self._draw_queue:
            return

        with self._draw_lock:
            batch = self._draw_queue[:]
            self._draw_queue.clear()
        
        for r in batch:
            pts = []
            for nx, ny in r.get("points", []):
                cw, ch = self.draw_canvas.width, self.draw_canvas.height
                x = nx * cw
                y = ch - (ny * ch)
                pts.append((x, y))
            if not pts:
                continue
            self.draw_canvas.draw_remote_stroke({
                "stroke_id": norm_uuid_hyphen(r["id"]),
                "points": pts,
                "width": r["width"],
                "color": tuple(r.get("color", (0,0,0,1)))
            })

    def _flush_todo_draw_queue(self, dt):
        if not self._todo_draw_queue:
            return

        with self._todo_draw_lock:
            batch = self._todo_draw_queue[:]
            self._todo_draw_queue.clear()
        
        for r in batch:
            pts = []
            for nx, ny in r.get("points", []):
                cw, ch = self.todo_board.width, self.todo_board.height
                x = nx * cw
                y = ch - (ny * ch)
                pts.append((x, y))
            if not pts:
                continue
            self.todo_board.draw_remote_stroke({
                "stroke_id": norm_uuid_hyphen(r["id"]),
                "points": pts,
                "width": r["width"],
                "color": tuple(r.get("color", (0,0,0,1)))
            })

    def listen_realtime(self):
        async def realtime_loop():
            while True:  # 🔁 vòng reconnect
                try:
                    url = (
                        "wss://fjhakjrxbdiowjkppgzy.supabase.co/realtime/v1/websocket"
                        f"?apikey={SUPABASE_KEY}"
                        f"&vsn=1.0.0"
                    )

                    async with websockets.connect(
                        url,
                        ssl=ssl_context,
                        additional_headers={
                            "Authorization": f"Bearer {SUPABASE_KEY}"
                        },
                        ping_interval=20,
                        ping_timeout=20
                    ) as ws:
                        # Join channel
                        await ws.send(json.dumps({
                            "topic": "realtime:public:messages",
                            "event": "phx_join",
                            "payload": {},
                            "ref": 1
                        }))

                        await ws.send(json.dumps({
                            "topic": "realtime:public:reaction",
                            "event": "phx_join",
                            "payload": {},
                            "ref": 2
                        }))

                        await ws.send(json.dumps({
                            "topic": "realtime:public:draw",
                            "event": "phx_join",
                            "payload": {},
                            "ref": 3
                        }))

                        await ws.send(json.dumps({
                            "topic": "realtime:public:version",
                            "event": "phx_join",
                            "payload": {},
                            "ref": 4
                        }))

                        await ws.send(json.dumps({
                            "topic": "realtime:public:todo",
                            "event": "phx_join",
                            "payload": {},
                            "ref": 5
                        }))

                        await ws.send(json.dumps({
                            "topic": "realtime:public:widgets",
                            "event": "phx_join",
                            "payload": {},
                            "ref": 6
                        }))

                        await ws.send(json.dumps({
                            "topic": "realtime:public:wishlist",
                            "event": "phx_join",
                            "payload": {},
                            "ref": 7
                        }))

                        while True:
                            msg = await ws.recv()
                            data = json.loads(msg)
                            record = data.get("payload", {}).get("record", {})

                            if not record:
                                record = data.get("payload", {}).get("old_record", {})
                                if data.get("event") == "DELETE":
                                    if data.get("topic") == "realtime:public:messages":
                                        msg_id = record.get("id")
                                        if msg_id and msg_id in msg_id_list:
                                            msg_id_list[msg_id].text = f"[size={int(dp(14))}][i]Tin nhắn đã thu hồi ;-;[/i][/size]"
                                    if data.get("topic") == "realtime:public:draw":
                                        stroke_id = norm_uuid_hyphen(record.get("id"))
                                        Clock.schedule_once(
                                            lambda dt, sid=stroke_id: self.draw_canvas.erase_remote_stroke(sid)
                                        )
                                        Clock.schedule_once(
                                            lambda dt, sid=stroke_id: self.todo_board.erase_remote_stroke(sid)
                                        )
                                    if data.get("topic") == "realtime:public:todo":
                                        if len(self.todo_browse.children)==1:
                                            Clock.schedule_once(lambda dt: self.todo_scroll.clear_widgets())
                                            Clock.schedule_once(lambda dt: self.todo_scroll.add_widget(MDLabel(text="Chưa có whiteboard nào được tạo hết ;-;", halign='center', valign='center', size_hint=(1, 1))))
                                        Clock.schedule_once(lambda dt: self.todo_browse.remove_widget(file_id_list[record["id"]]))
                                    if data.get("topic") == "realtime:public:widgets":
                                        rec = record  # old_record
                                        wid = norm_uuid_hyphen(record.get("id"))
                                        def _remove(*args):
                                            wdg = self.todo_widget_by_id.pop(wid, None)
                                            if wdg:
                                                if wdg == self.todo_board.selecting_widget: self.todo_board.deselect_all()
                                                self.todo_board.remove_widget(wdg)

                                        Clock.schedule_once(_remove, 0)
                                    if data["topic"] == "realtime:public:wishlist":
                                        item=wishlist_id.pop(record["id"], None)
                                        if len(wishlist_id)==0: Clock.schedule_once(lambda dt: self.load_wishlist())
                                        else: Clock.schedule_once(lambda dt: self.wishlist_list.remove_widget(item))
                                continue

                            if data.get("event") == "UPDATE":
                                if data.get("topic") == "realtime:public:wishlist":
                                    def apply(*args):
                                        wishlist_id[record["id"]].toggle_btn.icon = "check-circle" if bool(record["finished"]) else "checkbox-blank-circle-outline"
                                        wishlist_id[record["id"]].finished = bool(record["finished"])
                                        wishlist_id[record["id"]].opacity = 0.75 if wishlist_id[record["id"]].finished else 1

                                    Clock.schedule_once(apply)

                            if data.get("event") in ("INSERT", "UPDATE"):
                                if data.get("topic") == "realtime:public:widgets":
                                    rec = record
                                    # Bỏ qua echo của chính mình (nếu muốn)
                                    if rec.get("sender") == self.user_id:
                                        continue
                                    # Áp vào UI (nếu là UPDATE, _apply_widget_record sẽ cập nhật thuộc tính)
                                    Clock.schedule_once(lambda dt, r=rec: self._apply_widget_record(r, is_update=(data.get("event")=="UPDATE")), 0)
                                    continue

                                if data["topic"] == "realtime:public:version" and datetime.strptime(record["date"], "%d/%m/%Y").date() >= datetime.now().date() and build!=record["build"]:
                                    with open('build.txt', "w", encoding='utf-8') as fo: fo.write(record['build'])
                                    Clock.schedule_once(lambda dt: self.update())

                            if data.get("event") == "INSERT":
                                if data["topic"] == "realtime:public:wishlist":
                                    if len(wishlist_id)==0: Clock.schedule_once(lambda dt: self.load_wishlist())
                                    else: Clock.schedule_once(lambda dt: self.display_wishlist_item(record))
                                if data["topic"] == "realtime:public:reaction":
                                    w, h = Window.size
                                    if record["sender"] != self.user_id:
                                        Clock.schedule_once(lambda dt, r=record: self.spawn_emoji(pos=(r["x"] * w, r["y"] * h)))
                                if data["topic"] == "realtime:public:draw":
                                    if record["file"] and record["file"] == self.current_open_board and record["sender"] != self.user_id:
                                        with self._todo_draw_lock:
                                            self._todo_draw_queue.append(record)
                                    elif record["sender"] != self.user_id and normalize_date(record["date"]) == normalize_date(self.lookup_date):
                                        with self._draw_lock:
                                            self._draw_queue.append(record)
                                if data["topic"] == "realtime:public:todo":
                                    Clock.schedule_once(lambda dt: self.todo_scroll.clear_widgets())
                                    Clock.schedule_once(lambda dt: self.todo_scroll.add_widget(self.todo_browse))
                                    Clock.schedule_once(lambda dt: self.display_file(record["whiteboard_name"], record["created_at"], record["id"]))
                                if data["topic"] == "realtime:public:messages":
                                    sender = record["sender"]
                                    content = record["content"]
                                    timestamp = record["created_at"]
                                    date = record["date"]
                                    msg_id = record["id"]

                                    if self.lookup and normalize_date(self.lookup_date) != datetime.strftime(datetime.now(), "%d/%m/%Y"):
                                        self.noti.button.disabled=False
                                        expand_vertical(self.noti, dp(40))
                                    else:
                                        if msg_id_list.get('0000'): Clock.schedule_once(lambda dt: self.msg_list.remove_widget(msg_id_list['0000'].parent))
                                        Clock.schedule_once(
                                            lambda dt, s=sender, c=content, t=timestamp, d=date, msg_id=msg_id:
                                            self.display_message(s, c, t, d, msg_id)
                                        )
                                        if 'iu' in content.lower().translate(str.maketrans('', '', '.,?!')).split(): Clock.schedule_once(lambda x: self.spawn_emoji(multi=True))

                                    if sender != self.user_id and (platform!="android" or not self.app_in_foreground):
                                        notify_message(
                                            "Tin nhắn mới",
                                            f"{sender}: {content}"
                                        )

                except Exception as e:
                    print("Realtime socket died:", e)
                    await asyncio.sleep(3)  # ⏳ đợi rồi tự reconnect

        def start():
            asyncio.run(realtime_loop())
        threading.Thread(target=start, daemon=True).start()

    def show_updating_dialog(self):
        self.update_dialog = MDDialog(
            title="Đang cập nhật nề",
            text="Bạn iu chờ tẹo nhó...",
            md_bg_color=menubg,
            auto_dismiss=False,
        )
        self.update_dialog.open()

    def show_update_success(self):
        dialog = MDDialog(
            title="Ầu diaa",
            text="Cập nhật xong rùi <3",
            md_bg_color=menubg,
            buttons=[
                MDFillRoundFlatButton(
                    text="OK",
                    md_bg_color=btn,
                    on_release=self.stop
                )
            ],
            auto_dismiss=False,
        )
        dialog.open()

    def update(self, *args):
        self.show_updating_dialog()
        def worker():
            try:
                assets=["main.script"]
                for asset in assets:
                    download_file(repo="luv", file_path=asset, name=f"temp_{asset}")

                with open("main.script", "w", encoding="utf-8") as fo, open("temp_main.script", encoding="utf-8") as fi: fo.write(fi.read())
                os.remove("temp_main.script")

                # quay về UI thread khi xong
                Clock.schedule_once(lambda dt: self.finish_update())

            except Exception as e:
                print("Update error:", e)
                Clock.schedule_once(lambda dt: self.update_dialog.dismiss())

        threading.Thread(target=worker, daemon=True).start()

    def finish_update(self):
        if hasattr(self, "update_dialog"):
            self.update_dialog.dismiss()

        self.show_update_success()

    def on_start(self):
        global build

        if not check_connection(): return

        url = f"{SUPABASE_URL}/rest/v1/version?select=*&date=eq.{datetime.strftime(datetime.now(), '%d/%m/%Y')}&order=build.asc"
        res = requests.get(url, headers=headers)
        if res.status_code == 200:
            rows = res.json()
            if rows and rows[-1]['build']!=build:
                with open('build.txt', "w", encoding='utf-8') as fo: fo.write(rows[-1]['build'])
                Clock.schedule_once(lambda dt: self.update())

        def _update_build():
            try:
                if not os.path.exists("build.txt"):
                    download_file('luv', 'build.txt', 'build.txt')
            except Exception as e:
                print("Fetch build.txt error:", e)

        run_bg(_update_build)

        # phần kiểm tra version Supabase của bạn có thể giữ, nhưng bọc network:
        def _check_version():
            try:
                url = f"{SUPABASE_URL}/rest/v1/version?select=*&date=eq.{datetime.strftime(datetime.now(), '%d/%m/%Y')}&order=build.asc"
                res = _api.get(url, timeout=_api_timeout)
                if res.status_code == 200:
                    rows = res.json()
                    if rows and rows[-1]['build'] != build:
                        with open('build.txt', "w", encoding='utf-8') as fo:
                            fo.write(rows[-1]['build'])
                        Clock.schedule_once(lambda dt: self.update())
            except Exception as e:
                print("Version check error:", e)

        run_bg(_check_version)

    def on_pause(self):
        print("App paused")
        self.app_in_foreground = False
        return True

    def on_resume(self):
        global message_cache
        print("App resumed")
        self.app_in_foreground = True
        message_cache = []
        return True

    def open_wishlist_screen(self):
        self.menu.dismiss()
        self.sm.current='wishlist'
        Clock.schedule_once(lambda dt: self.load_wishlist())

    def load_wishlist(self):
        self.wishlist_list.clear_widgets()
        def _fetch():
            rows = []
            try:
                url = (f"{SUPABASE_URL}/rest/v1/wishlist"
                       f"?select=*&order=finished.asc&order=category.asc&order=priority.desc")
                res = _api.get(url, timeout=_api_timeout)
                res.raise_for_status()
                rows = res.json() or []
            except Exception as e:
                print("LOAD_WISHLIST ERR:", e)
            def _apply(_dt):
                self.wishlist_list.clear_widgets()
                if not rows:
                    self.wishlist_list.add_widget(MDLabel(text="Chưa có mục wishlist nào ;-;",
                                                          halign='center', valign='center',
                                                          size_hint=(1, None), height=dp(50)))
                else:
                    for r in rows:
                        self.display_wishlist_item(r)

            Clock.schedule_once(_apply, 0)

        run_bg(_fetch)

    def display_wishlist_item(self, row):
        global wishlist_id

        item_id = row.get("id")
        content = (row.get("content") or "").strip()
        category = (row.get("category") or "").strip()
        note = (row.get("note") or "").strip()
        link = (row.get("link") or "").strip()
        priority = int(row.get("priority") or 1)

        def _priority_color(p):
            if p >= 5: return (1, 0.25, 0.25, 1)
            if p == 4: return (1, 0.5, 0.2, 1)
            if p == 3: return (1, 0.8, 0.2, 1)
            if p == 2: return (0.3, 0.75, 0.35, 1)
            if p == 1: return (0.25, 0.6, 1, 1)

        pr_color = _priority_color(priority)
        card = MDCard(orientation="vertical", size_hint=(1, None),
                      padding=[dp(10), dp(10), dp(10), dp(10)], spacing=dp(5),
                      md_bg_color=boxbg[:-1]+(0.25,), radius=[dp(10), dp(10), dp(10), dp(10)],
                      elevation=0)
        
        card.bind(minimum_height=card.setter("height"))

        card.finished = bool(row.get("finished"))
        status_icon = "check-circle" if card.finished else "checkbox-blank-circle-outline"
        header = MDBoxLayout(size_hint=(1, None), height=dp(28), spacing=dp(8))
        header_btn = MDBoxLayout(size_hint=(1, None), height=dp(28), spacing=dp(8))
        left = MDBoxLayout(size_hint=(1, 1))
        card.toggle_btn = MDIconButton(icon=status_icon, theme_icon_color="Custom", icon_color=pr_color,
                                  pos_hint={"center_y": 0.5},
                                  on_release=lambda *_: self.toggle_wishlist_finished(item_id, not card.finished))

        title = MDLabel(text=format_text_with_fonts(content if content else "(Không có nội dung)"),
                        theme_text_color="Custom", text_color=primarycolor, markup=True,
                        halign="left", size_hint=(1, None), height=dp(24), shorten=True, pos_hint={"center_y": 0.5})

        del_btn = MDIconButton(icon="delete", theme_icon_color="Custom", icon_color=(1, 0.2, 0.2, 1),
                               pos_hint={"center_y": 0.5},
                               on_release=lambda *_: self.delete_wishlist_item(item_id))

        left.add_widget(card.toggle_btn)
        left.add_widget(title)
        
        pr_chip = MDCard(size_hint=(None, 1), padding=[dp(8), dp(2), dp(8), dp(2)],
                         radius=dp(11), md_bg_color=pr_color)

        pr_chip.bind(minimum_width=pr_chip.setter("width"))

        pr_chip.add_widget(MDLabel(text=f"[size={int(dp(14))}]{self._priority_icon(priority)}[/size] Mức ưu tiên: {priority}", theme_text_color="Custom", text_color=(1,1,1,1),
                                   size_hint=(None, 1), width=dp(140), halign="center", valign="center", markup=True))

        header.add_widget(left)
        header_btn.add_widget(pr_chip)
        
        if link:
            link_btn = MDFillRoundFlatIconButton(icon="link-variant", text="Link", size_hint=(None, 1),
                                pos_hint={"center_y": 0.5}, md_bg_color=btn,
                                on_release=lambda *_: copy_text(link))
            header_btn.add_widget(link_btn)

        header_btn.add_widget(del_btn)
        meta = MDBoxLayout(size_hint=(1, None), height=dp(26), spacing=dp(15))

        if category:
            chip=MDLabel(text=format_text_with_fonts(f"{category}"), markup=True,
                                    theme_text_color="Custom", text_color=primarycolor[:-1]+tuple([0.75]),
                                    size_hint=(1, 1), shorten=True)
            chip.bind(texture_size=chip.setter("texture_size"))
            chip.bind(texture_size=chip.setter("size"))

            meta.add_widget(MDIcon(icon="tag", theme_text_color="Custom", text_color=pr_color))
            meta.add_widget(chip)
            card.add_widget(meta)

        accent = MDBoxLayout(size_hint=(1, None), height=dp(2))
        accent.md_bg_color = pr_color
        card.add_widget(header)
        card.add_widget(header_btn)
        card.add_widget(accent)

        if note:
            note_label = MDLabel(text=format_text_with_fonts(f"{note}"),
                            theme_text_color="Custom", text_color="gray", markup=True,
                            halign="left", size_hint=(1, None), shorten=False, pos_hint={"center_x": 0.5})
            
            note_label.bind(texture_size=note_label.setter("texture_size"))
            note_label.bind(texture_size=note_label.setter("size"))
            card.add_widget(note_label)

        if card.finished:
            card.opacity = 0.75

        self.wishlist_list.add_widget(card)
        wishlist_id[item_id] = card

    def clear_wishlist_form(self):
        self.wl_content.text = ""
        self.wl_category.text = ""
        self.wl_note.text = ""
        self.wl_link.text = ""
        self.wl_pr_slider.value = 3

    def save_new_wishlist(self):
        payload = {
            "content": (self.wl_content.text or "").strip(),
            "category": (self.wl_category.text or "").strip(),
            "priority": int(self.wl_pr_slider.value),
            "note": (self.wl_note.text or "").strip(),
            "link": (self.wl_link.text or "").strip(),
            "finished": False,
        }

        if not payload["content"]:
            print("Vui lòng nhập nội dung wishlist.")
            return

        def send():
            try:
                url = f"{SUPABASE_URL}/rest/v1/wishlist"
                res = requests.post(url, headers=headers, json=payload)
                if res.status_code not in (200, 201):
                    print("WISHLIST CREATE FAIL:", res.text)
            except Exception as e:
                print("WISHLIST CREATE ERR:", e)
            finally:
                Clock.schedule_once(lambda dt: self.clear_wishlist_form())

        threading.Thread(target=send, daemon=True).start()

    def toggle_wishlist_finished(self, item_id: int, new_value: bool):
        def send():
            try:
                url = f"{SUPABASE_URL}/rest/v1/wishlist?id=eq.{item_id}"
                res = requests.patch(url, headers=headers, json={"finished": new_value})
                if res.status_code not in (200, 204):
                    print("WISHLIST TOGGLE FAIL:", res.text)
            except Exception as e:
                print("WISHLIST TOGGLE ERR:", e)

        threading.Thread(target=send, daemon=True).start()

    def delete_wishlist_item(self, item_id: int):
        def send():
            try:
                url = f"{SUPABASE_URL}/rest/v1/wishlist?id=eq.{item_id}"
                res = requests.delete(url, headers=headers)
                if res.status_code not in (200, 204):
                    print("WISHLIST DELETE FAIL:", res.text)
            except Exception as e:
                print("WISHLIST DELETE ERR:", e)

        threading.Thread(target=send, daemon=True).start()

ChatApp().run()