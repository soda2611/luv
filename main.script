org_textfield = MDTextField

class MDTextField(MDTextField):
    def __init__(self, **kwargs):
        super(MDTextField, self).__init__(**kwargs)

        self.bind(focus=self._on_focus)

    def _on_focus(self, instance, value):
        if value:
            self.focus = False
            self.preview = org_textfield(
                text=self.text,
                hint_text="Nhập ở đây",
                line_color_normal=btn,
                line_color_focus=btn,
                hint_text_color=[0.8 - i for i in [1, 1, 1, 1]],
                hint_text_color_focus=[1, 1, 1, 1],
                text_color_focus=[1, 1, 1, 1],
                fill_color_normal=boxbg[:-1] + (0.25,),
                pos_hint={"center_y": 0.5},
                multiline = self.multiline,
                on_text_validate=self.set_new_text
            )
            self.overlay = MDCard(size_hint=(1, 1), radius=[0, 0, 0, 0], md_bg_color=[0, 0, 0, 0.5], padding=[dp(50), dp(50), dp(50), dp(50)], on_release=self.set_new_text)
            self.overlay.add_widget(self.preview)
            MDApp.get_running_app().root.current_screen.add_widget(self.overlay)
            Clock.schedule_once(lambda d: setattr(self.preview, "focus", True))

    def set_new_text(self, *args):
        self.text = self.preview.text
        MDApp.get_running_app().root.current_screen.remove_widget(self.overlay)

# --- LimitedTextField ---
class LimitedTextField(MDTextField):
    def __init__(self, max_length=100, **kwargs):
        super().__init__(**kwargs)
        self.max_length = max_length

    def insert_text(self, substring, from_undo=False):
        if len(self.text) >= self.max_length:
            return
        if len(self.text) + len(substring) > self.max_length:
            substring = substring[:self.max_length - len(self.text)]
        super().insert_text(substring, from_undo=from_undo)

class CustomMDBoxLayout(MDBoxLayout):
    opacity = NumericProperty(0)

    def add_widget(self, widget, *args, **kwargs):
        if widget.parent: widget.parent.remove_widget(widget)
        super().add_widget(widget, *args, **kwargs)
        widget.opacity = self.opacity
        self.bind(opacity=lambda instance, value: setattr(widget, 'opacity', value))

class DraggableResizableWidget(MDCard):
    """Widget có thể kéo và thay đổi kích thước"""
    widget_id = StringProperty('')
    selected = BooleanProperty(False)  # ✅ trạng thái được chọn
    text_color = ListProperty([0, 0, 0, 1])
    text_size = NumericProperty(14)
    text_align = StringProperty("center")
    text = StringProperty("Double-click để chỉnh sửa")
    angle = NumericProperty(0)
    
    def __init__(self, widget_id, **kwargs):
        super().__init__(**kwargs)
        self.widget_id = widget_id
        self.orientation = "vertical"
        self.size_hint = (None, None)
        self.size = (dp(0), dp(0))
        self.md_bg_color = boxbg
        self.padding = dp(5)
        self.spacing = dp(5)
        self.radius = [dp(10)]
        self.line_color = [0, 0, 0, 0]
        self.line_width = dp(1)
        
        # Resize handle
        self.resize_active = False
        self.resize_start_pos = (0, 0)
        self.resize_start_size = (0, 0)
        self.resize_start_pos_widget = (0, 0)
        self.active_handle = None  # 'tl', 'tr', 'bl', 'br', 't', 'b', 'l', 'r', 'header'
        
        # Double-click tracking
        self.last_touch_time = 0
        self.is_editing = False
        
        # Content area
        self.content_box = MDBoxLayout(size_hint=(1, 1), orientation="vertical", padding=dp(5), spacing=dp(5))
        self.content_label = MDLabel(
            text=f"[size={int(dp(self.text_size))}]{format_text_with_fonts(self.text)}[/size]",
            halign=self.text_align,
            valign="center",
            theme_text_color="Custom",
            text_color=self.text_color,
            markup=True,
        )
        self.content_box.add_widget(self.content_label)
        self.add_widget(self.content_box)
        
        # --- FIX STENCIL: dùng InstructionGroup riêng cho handles ---
        self._handles_group = InstructionGroup()
        self.canvas.after.add(self._handles_group)

        # Vẽ resize handles ở các góc khi pos/size đổi
        self.bind(angle=self._update_handles, size=self._update_handles, pos=self._update_handles)
        self.bind(angle=self._update_angle, size=self._update_angle, pos=self._update_angle)
        # Khi selected đổi → cập nhật visual/handles
        self.bind(selected=self._on_selected_change)
        self.bind(text=self._update_content_text)
        self.bind(text_size=self._update_content_text)
        self.bind(text_color=self._update_content_text_color)
        self.bind(text_align=self._update_content_text)

    def _update_angle(self, *args):
        self.canvas.before.clear()
        self.canvas.after.clear()
        self.content_box.canvas.before.clear()
        self.content_box.canvas.after.clear()
        self.content_label.canvas.before.clear()
        self.content_label.canvas.after.clear()
        with self.canvas.before, self.content_box.canvas.before, self.content_label.canvas.before:
            PushMatrix()
            Rotate(angle=self.angle, origin=self.center)

        with self.canvas.after, self.content_box.canvas.after, self.content_label.canvas.after:
            PopMatrix()

        self.canvas.after.add(self._handles_group)

    def _update_content_text(self, *args):
        self.content_label.text = f"[size={int(dp(self.text_size))}]{format_text_with_fonts(self.text)}[/size]"
        self.content_label.halign = self.text_align

    def _update_content_text_color(self, *args):
        self.content_label.text_color = self.text_color
    
    def _on_selected_change(self, instance, value):
        self._update_handles()

    def _get_handle_at(self, touch_pos):
        """Kiểm tra touch có ở handle nào không"""
        handle_size = dp(10)
        x, y = touch_pos
        wx, wy = self.pos
        ww, wh = self.size
        
        # Tolerance area
        tol = dp(15)
        
        # Top-left
        if wx - tol <= x <= wx + handle_size + tol and wy + wh - handle_size - tol <= y <= wy + wh + tol:
            return 'tl'
        # Top-right
        if wx + ww - handle_size - tol <= x <= wx + ww + tol and wy + wh - handle_size - tol <= y <= wy + wh + tol:
            return 'delete'
        # Bottom-left
        if wx - tol <= x <= wx + handle_size + tol and wy - tol <= y <= wy + handle_size + tol:
            return 'bl'
        # Bottom-right
        if wx + ww - handle_size - tol <= x <= wx + ww + tol and wy - tol <= y <= wy + handle_size + tol:
            return 'br'
        # Top edge
        if wx + handle_size <= x <= wx + ww - handle_size and wy + wh - handle_size <= y <= wy + wh + tol:
            return 't'
        # Bottom edge
        if wx + handle_size <= x <= wx + ww - handle_size and wy - tol <= y <= wy + handle_size:
            return 'b'
        # Left edge
        if wx - tol <= x <= wx + handle_size and wy + handle_size <= y <= wy + wh - handle_size:
            return 'l'
        # Right edge
        if wx + ww - handle_size <= x <= wx + ww + tol and wy + handle_size <= y <= wy + wh - handle_size:
            return 'r'
        
        return None
    
    def _update_handles(self, *args):
        self._handles_group.clear()
        if not self.selected:
            return

        wx, wy = self.pos
        ww, wh = self.size

        pill_long = dp(22)
        pill_short = dp(18)

        def draw_pill(x, y, w, h, draw_x=False):
            # nền trắng
            self._handles_group.add(Color(1, 1, 1, 1))
            self._handles_group.add(RoundedRectangle(
                pos=(x, y),
                size=(w, h),
                radius=[h/2]
            ))

            # viền xám
            self._handles_group.add(Color(0.75, 0.75, 0.75, 1))
            self._handles_group.add(Line(
                rounded_rectangle=(x, y, w, h, h/2),
                width=dp(1)
            ))

            if draw_x:
                # vẽ dấu X ở giữa
                cx = x + w/2
                cy = y + h/2
                size = min(w, h) * .25

                self._handles_group.add(Color(1, 0.2, 0.2, 1))
                self._handles_group.add(Line(
                    points=[cx - size/2, cy - size/2,
                            cx + size/2, cy + size/2],
                    width=dp(1.5)
                ))
                self._handles_group.add(Line(
                    points=[cx - size/2, cy + size/2,
                            cx + size/2, cy - size/2],
                    width=dp(1.5)
                ))

        # ---- TOP ----
        draw_pill(
            wx + ww/2 - pill_long/2,
            wy + wh - dp(8)/2,
            pill_long,
            dp(8)
        )

        # ---- BOTTOM ----
        draw_pill(
            wx + ww/2 - pill_long/2,
            wy - dp(8)/2,
            pill_long,
            dp(8)
        )

        # ---- LEFT ----
        draw_pill(
            wx - dp(8)/2,
            wy + wh/2 - pill_long/2,
            dp(8),
            pill_long
        )

        # ---- RIGHT ----
        draw_pill(
            wx + ww - dp(8)/2,
            wy + wh/2 - pill_long/2,
            dp(8),
            pill_long
        )

        # ---- TOP LEFT ----
        draw_pill(
            wx - pill_short/2,
            wy + wh - pill_short/2,
            pill_short,
            pill_short
        )

        # ---- TOP RIGHT (DELETE) ----
        draw_pill(
            wx + ww - pill_short/2,
            wy + wh - pill_short/2,
            pill_short,
            pill_short,
            draw_x=True
        )

        # ---- BOTTOM LEFT ----
        draw_pill(
            wx - pill_short/2,
            wy - pill_short/2,
            pill_short,
            pill_short
        )

        # ---- BOTTOM RIGHT ----
        draw_pill(
            wx + ww - pill_short/2,
            wy - pill_short/2,
            pill_short,
            pill_short
        )
        
    def _check_double_click(self, touch_pos):
        """Kiểm tra double-click"""
        import time
        current_time = time.time()
        
        if current_time - self.last_touch_time < 0.3:
            if not hasattr(self, '_last_touch_pos'):
                self._last_touch_pos = touch_pos
                return False
            
            if (abs(touch_pos[0] - self._last_touch_pos[0]) < dp(30) and 
                abs(touch_pos[1] - self._last_touch_pos[1]) < dp(30)):
                self.last_touch_time = 0
                return True
        
        self.last_touch_time = current_time
        self._last_touch_pos = touch_pos
        return False
    
    def _show_edit_dialog(self):
        edit_input = MDTextField(
            hint_text="Nhập nội dung mới",
            text=self.text if self.text != "Double-click để chỉnh sửa" else "",
            font_name="resources/fonts/segoeui.ttf",
            line_color_normal=boxbg,
            line_color_focus=boxbg,
            hint_text_color=[0.75 - i for i in primarycolor],
            hint_text_color_focus=primarycolor,
            text_color_focus=primarycolor,
            fill_color_normal=boxbg,
            height=dp(40),
            multiline=True
        )
        
        def save_content(instance):
            new_text = edit_input.text.strip()
            if new_text:
                self.text = new_text  # cập nhật property để lưu
            dialog.dismiss()
        
        def cancel_edit(instance):
            dialog.dismiss()
        
        dialog = MDDialog(
            title="Chỉnh sửa Widget",
            type="custom",
            content_cls=edit_input,
            buttons=[
                MDFillRoundFlatButton(
                    text="Lưu",
                    md_bg_color=btn,
                    text_color='white',
                    on_release=save_content
                ),
                MDFillRoundFlatButton(
                    text="Hủy",
                    md_bg_color=menubg,
                    text_color='white',
                    on_release=cancel_edit
                ),
            ],
            md_bg_color=boxbg,
        )
        dialog.open()

    def _is_widget_mode(self):
        """
        Widget chỉ hoạt động khi tool của todo_board là 'cursor'.
        Không phụ thuộc trạng thái lock (để bạn có thể chỉnh ngay khi chuyển sang cursor).
        """
        parent = self.parent
        if not parent:
            return False
        tool = getattr(parent, "tool", "cursor")
        return (tool == "cursor") and globals().get("todo_draw_mode", False)
    
    def on_touch_down(self, touch):
        if not self._is_widget_mode():
            return False

        # Click trong widget => chọn widget
        if self.collide_point(*touch.pos):
            if hasattr(self.parent, "set_selected_widget"):
                self.parent.set_selected_widget(self)

        # Kiểm tra content area double-click
        if (self.content_box.collide_point(*touch.pos) and 
            not self._get_handle_at(touch.pos)):
            
            if self._check_double_click(touch.pos):
                self._show_edit_dialog()
                return True
        
        # Kiểm tra resize handle
        handle = self._get_handle_at(touch.pos)

        if handle == 'delete':
            self.parent.deselect_all()
            if hasattr(self.parent, 'on_widget_deleted'):
                self.parent.on_widget_deleted(self.widget_id)
            if self.parent:
                self.parent.remove_widget(self)
            return True

        if handle:
            self.resize_active = True
            self.active_handle = handle
            # **Lưu trạng thái ban đầu**
            self.resize_start_pos = (touch.x, touch.y)
            self.resize_start_size = self.size
            self.resize_start_pos_widget = self.pos
            touch.grab(self)
            return True
        
        # Kiểm tra header (drag)
        if self.children[0].collide_point(*touch.pos):
            touch.grab(self)
            self.active_handle = 'header'
            return True
        
        return super().on_touch_down(touch)

    def on_touch_move(self, touch):
        if not self._is_widget_mode():
            return False
        
        # Drag widget
        if touch.grab_current is self and self.active_handle == 'header':
            self.pos = (self.pos[0] + touch.dx, self.pos[1] + touch.dy)
            return True
        
        # Resize widget
        if touch.grab_current is self and self.resize_active and self.active_handle:
            wx, wy = self.resize_start_pos_widget
            ww, wh = self.resize_start_size

            left   = wx
            right  = wx + ww
            bottom = wy
            top    = wy + wh

            min_w = dp(100)
            min_h = dp(50)

            mx, my = touch.pos
            handle = self.active_handle

            if handle == 'br':
                right = max(left + min_w, mx)
                bottom = min(top - min_h, my)

            elif handle == 'bl':
                left = min(right - min_w, mx)
                bottom = min(top - min_h, my)

            elif handle == 'tr':
                right = max(left + min_w, mx)
                top = max(bottom + min_h, my)

            elif handle == 'tl':
                left = min(right - min_w, mx)
                top = max(bottom + min_h, my)

            elif handle == 'r':
                right = max(left + min_w, mx)

            elif handle == 'l':
                left = min(right - min_w, mx)

            elif handle == 't':
                top = max(bottom + min_h, my)

            elif handle == 'b':
                bottom = min(top - min_h, my)

            new_w = right - left
            new_h = top - bottom

            self.pos = (left, bottom)
            self.size = (new_w, new_h)
            return True
        
        return super().on_touch_move(touch)

    def on_touch_up(self, touch):
        if not self._is_widget_mode():
            return False
        
        if touch.grab_current is self:
            touch.ungrab(self)
            self.active_handle = None
            return True
        
        if self.resize_active:
            self.resize_active = False
            self.active_handle = None
            return True
        
        return super().on_touch_up(touch)

class SVArea(Widget):
    hue = NumericProperty(0.0)
    saturation = NumericProperty(1.0)
    value = NumericProperty(1.0)

    def __init__(self, **kwargs):
        super().__init__(**kwargs)

        with self.canvas:
            Color(1, 1, 1, 1)
            self.rect = Rectangle(pos=self.pos, size=self.size)

        with self.canvas.after:
            Color(1, 1, 1, 1)
            self.pointer = Line(circle=(0, 0, dp(7)), width=dp(1.2))

        self.bind(pos=self._update_rect, size=self._update_rect)
        self.bind(hue=self._rebuild_texture)
        self.bind(saturation=self._update_pointer)
        self.bind(value=self._update_pointer)

        Clock.schedule_once(lambda dt: self._rebuild_texture())

    def _update_rect(self, *args):
        self.rect.pos = self.pos
        self.rect.size = self.size
        self._update_pointer()

    def _update_pointer(self, *args):
        x = self.x + self.saturation * self.width
        y = self.y + self.value * self.height
        self.pointer.circle = (x, y, dp(7))

    def _rebuild_texture(self, *args):
        w, h = int(self.width), int(self.height)
        if w < 5 or h < 5:
            return

        import numpy as np

        # Pure hue color (full saturation+value)
        Rh, Gh, Bh = colorsys.hsv_to_rgb(self.hue, 1, 1)

        # S axis
        S = np.linspace(0, 1, w, dtype=np.float32)

        # V axis
        V = np.linspace(0, 1, h, dtype=np.float32)

        S, V = np.meshgrid(S, V)

        # WHITE blend
        R = V * ((1 - S) + S * Rh)
        G = V * ((1 - S) + S * Gh)
        B = V * ((1 - S) + S * Bh)

        rgb = (np.dstack((R, G, B)) * 255).astype(np.uint8)

        tex = Texture.create(size=(w, h), colorfmt='rgb')
        tex.blit_buffer(rgb.tobytes(), colorfmt='rgb', bufferfmt='ubyte')
        tex.wrap = "clamp_to_edge"

        self.rect.texture = tex

    def on_touch_down(self, touch):
        if self.collide_point(*touch.pos):
            self._pick(touch)
            return True

    def on_touch_move(self, touch):
        if self.collide_point(*touch.pos):
            self._pick(touch)
            return True

    def _pick(self, touch):
        s = (touch.x - self.x) / self.width
        v = (touch.y - self.y) / self.height
        self.saturation = max(0.0, min(1.0, s))
        self.value      = max(0.0, min(1.0, v))
        self.parent.parent.update_sv(self.saturation, self.value)
        self._update_pointer()

class HueSlider(Widget):
    hue = NumericProperty(0)

    def __init__(self, **kwargs):
        super().__init__(**kwargs)

        with self.canvas:
            self.rect = Rectangle(pos=self.pos, size=self.size)

            # Pointer
            Color(1, 1, 1, 1)
            self.pointer = Line(circle=(0, 0, dp(6)), width=(dp(1.2)))

        self.bind(pos=self.update_rect, size=self.update_texture)
        self.bind(hue=self.update_pointer)

    def update_rect(self, *args):
        self.rect.pos = self.pos
        self.rect.size = self.size
        self.update_pointer()

    def update_pointer(self, *args):
        y = self.y + self.hue * self.height
        self.pointer.circle = (self.center_x, y, dp(6))

    def update_texture(self, *args):
        w, h = int(self.width), int(self.height)
        if h < 5:
            return

        import numpy as np

        y = np.linspace(0, 1, h)
        hues = y.reshape(h, 1)

        HSV = np.concatenate([hues, np.ones((h, 1)), np.ones((h, 1))], axis=1)

        RGB = np.array([colorsys.hsv_to_rgb(*c) for c in HSV]) * 255
        RGB = RGB.astype(np.uint8)
        RGB = np.repeat(RGB, w, axis=0)

        texture = Texture.create(size=(w, h), colorfmt='rgb')
        texture.blit_buffer(RGB.tobytes(), colorfmt='rgb', bufferfmt='ubyte')
        self.rect.texture = texture

    def on_touch_down(self, touch):
        if self.collide_point(*touch.pos):
            self.pick(touch)
            return True

    def on_touch_move(self, touch):
        if self.collide_point(*touch.pos):
            self.pick(touch)
            return True

    def pick(self, touch):
        self.hue = (touch.y - self.y) / self.height
        self.hue = min(max(self.hue, 0), 1)
        self.parent.parent.update_hue(self.hue)
        self.update_pointer()

class ProColorPicker(MDCard):
    current_color = ListProperty([1, 0, 0, 1])
    hue = NumericProperty(0.0)
    saturation = NumericProperty(1.0)
    value = NumericProperty(1.0)
    alpha = NumericProperty(1.0)

    def __init__(self, on_select=None, **kwargs):
        super().__init__(**kwargs)

        self.on_select = on_select
        self.orientation = "vertical"
        self.padding = dp(20)
        self.spacing = dp(20)
        self.size_hint = (None, None)
        self.size = (dp(650), dp(320))
        self.radius = [dp(20)]
        self.md_bg_color = boxbg

        self.sv_area = SVArea(size_hint=(1, 1))
        self.hue_slider = HueSlider(size_hint=(None, 1), width=dp(30))
        self.color_select_area = MDBoxLayout(spacing=dp(15), size_hint=(1, 1))

        self.opacity_slider = MDBoxLayout(size_hint=(1, None), height=dp(35))
        self.opacity_slider.slider = MDSlider(step=0.1, hint=False, color=menubg, thumb_color_active=btn, thumb_color_inactive=btn, show_off=False, pos_hint={"center_y": 0.5}, min=0, max=1, value=self.alpha)
        self.opacity_slider.slider.bind(value=self.update_alpha)
        self.opacity_slider.add_widget(MDLabel(text=f"Độ trong suốt: {self.alpha}", theme_text_color="Custom", text_color=primarycolor, size_hint=(None, None), width=dp(120), height=dp(35), font_style="Caption", halign="center", valign="center"))
        self.opacity_slider.add_widget(self.opacity_slider.slider)

        right = MDBoxLayout(spacing=dp(15), size_hint=(1, None), height=dp(35))
        self.preview = MDCard(size_hint=(1, 1), line_color=btn, radius=[dp(16)], pos_hint={"center_y": 0.5})
        right.add_widget(self.preview)

        self.hex_input = MDTextField(
            hint_text="HEX",
            size_hint_x=None,
            width=dp(120),
            line_color_normal=btn,
            line_color_focus=btn,
            hint_text_color=[0.75 - i for i in primarycolor],
            hint_text_color_focus=primarycolor,
            text_color_focus=primarycolor,
            fill_color_normal=boxbg[:-1] + (0.25,),
            pos_hint={"center_y": 0.5},
        )
        self.hex_input.bind(on_text_validate=self.on_hex_enter)
        self.hex_input.bind(focus=self.on_hex_enter)
        right.add_widget(self.hex_input)

        btn_row = MDBoxLayout(size_hint=(1, 0.18), spacing=dp(10))
        ok_btn = MDFillRoundFlatButton(text="OK", md_bg_color=btn, text_color=(1,1,1,1), pos_hint={"center_y": 0.5}, on_release=self.confirm)
        cancel_btn = MDFillRoundFlatButton(text="Cancel", md_bg_color=menubg, text_color=(1,1,1,1), pos_hint={"center_y": 0.5}, on_release=self.cancel)
        btn_row.add_widget(MDBoxLayout(size_hint=(1, 1))); btn_row.add_widget(ok_btn); btn_row.add_widget(cancel_btn)

        self.color_select_area.add_widget(self.sv_area)
        self.color_select_area.add_widget(self.hue_slider)
        self.add_widget(self.color_select_area)
        self.add_widget(self.opacity_slider)
        self.add_widget(right)
        self.add_widget(btn_row)

        # Responsive cho mobile/desktop
        Window.bind(size=self._apply_responsive)
        Clock.schedule_once(self._apply_responsive, 0)
        Clock.schedule_once(lambda dt: self.update_color())

    def _apply_responsive(self, *args):
        w, h = Window.size
        if w < h:  # Mobile dọc
            self.width  = w * 0.92
            self.height = max(dp(380), h * 0.55)
            self.sv_area.width = self.width * 0.60
            self.hue_slider.width = dp(28)
        else:      # Desktop / ngang
            self.width  = min(dp(700), w * 0.75)
            self.height = min(dp(440), h * 0.7)
            self.sv_area.width = self.width * 0.58
            self.hue_slider.width = dp(32)

    # ===== API giữ nguyên =====
    def update_hue(self, h):
        self.hue = h
        self.sv_area.hue = h
        self.update_color()

    def update_sv(self, s, v):
        self.saturation = s
        self.value = v
        self.update_color()

    def update_alpha(self, instance, value):
        self.alpha = round(value, 2)
        self.opacity_slider.children[1].text = f"Độ trong suốt: {self.alpha}"
        self.update_color()

    def update_color(self):
        r, g, b = colorsys.hsv_to_rgb(self.hue, self.saturation, self.value)
        self.current_color = [r, g, b, self.alpha]
        self.preview.md_bg_color = self.current_color
        self.hex_input.text = get_hex_from_color(self.current_color)

    def on_hex_enter(self, instance, *args):
        try:
            color = get_color_from_hex(instance.text)
            r, g, b = color[:3]
            h, s, v = colorsys.rgb_to_hsv(r, g, b)
            self.hue, self.saturation, self.value = h, s, v
            self.sv_area.hue = h
            self.update_color()
        except Exception:
            pass

    def confirm(self, *args):
        if self.on_select:
            self.on_select(self.current_color)
        if self.parent: self.parent.parent.dismiss()

    def cancel(self, *args):
        if self.parent: self.parent.parent.dismiss()

class ProColorPickerPopup(ModalView):
    def __init__(self, on_select=None, **kwargs):
        super().__init__(size_hint=(1,1))
        self.background_color = (0, 0, 0, 0.4)

        self.anchor = MDAnchorLayout(anchor_x="center", anchor_y="center")
        super().add_widget(self.anchor)

        self.picker = ProColorPicker(on_select=on_select)
        self.anchor.add_widget(self.picker)

        Window.bind(size=self._update_size)
        Clock.schedule_once(self._update_size, 0)

    def _update_size(self, *args):
        w, h = Window.size

        if w < h:  # mobile dọc
            self.picker.width = w * 0.9
            self.picker.height = h * 0.55
        else:  # desktop / mobile ngang
            self.picker.width = min(dp(650), w * 0.75)
            self.picker.height = min(dp(420), h * 0.65)

# ---------- Utils ----------

def stroke_in_viewport(stroke, vp):
    min_x = min(p[0] for p in stroke["points"])
    max_x = max(p[0] for p in stroke["points"])
    min_y = min(p[1] for p in stroke["points"])
    max_y = max(p[1] for p in stroke["points"])

    vx1, vy1, vx2, vy2 = vp
    return not (max_x < vx1 or min_x > vx2 or max_y < vy1 or min_y > vy2)

# ---------- Draw Board ----------
class DrawCanvas(MDAnchorLayout):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)

        # stroke_id -> stroke
        self.strokes = {}

        self.current_stroke = None
        self.tool = "pen"

        self.pen_color = (0, 0, 0, 1)
        self.pen_width = 2.5
        self.eraser_radius = 2.5

        self.on_stroke_finished = None
        self.on_stroke_deleted = None
        self.bind(size=self._apply_flip, pos=self._apply_flip)
        Clock.schedule_once(self._apply_flip, 0)
        
    def _apply_flip(self, *args):
        self.canvas.before.clear()
        self.canvas.after.clear()

        with self.canvas.before:
            PushMatrix()
            Translate(0, self.height)
            Scale(1, -1, 1)
            
        with self.canvas.after:
            PopMatrix()

    # --------------------------------------------------
    # PEN
    # --------------------------------------------------

    def on_touch_down(self, touch):
        if not draw_mode: return False

        if not self.collide_point(*touch.pos):
            return False

        wx, wy = self.to_local(*touch.pos)
        wy = self.height - wy

        if self.tool == "pen":
            self._start_stroke(wx, wy)
            return True

        if self.tool == "eraser":
            self._erase_at(wx, wy)
            return True

        return False

    def on_touch_move(self, touch):
        if not draw_mode: return False

        if not self.collide_point(*touch.pos):
            return False

        wx, wy = self.to_local(*touch.pos)
        wy = self.height - wy

        if self.tool == "pen" and self.current_stroke:
            self._extend_stroke(wx, wy)
            return True

        if self.tool == "eraser":
            self._erase_at(wx, wy)
            return True

        return False

    def on_touch_up(self, touch):
        if not draw_mode: return False

        if self.tool == "pen" and self.current_stroke:
            if self.on_stroke_finished:
                self.on_stroke_finished(self.current_stroke)
        self.current_stroke = None
        return False

    def _start_stroke(self, x, y):
        stroke_id = norm_uuid_hyphen(str(uuid4().hex))

        group = InstructionGroup()
        group.add(Color(*self.pen_color))
        line = Line(
            points=[x, y],
            width=dp(self.pen_width),
            cap="round",
            joint="round"
        )
        group.add(line)

        stroke = {
            "id": stroke_id,
            "group": group,
            "line": line,
            "points": [(x, y)],
            "bbox": [x, y, x, y],  # minx, miny, maxx, maxy
        }

        self.strokes[stroke_id] = stroke
        self.canvas.add(group)
        self.current_stroke = stroke

    def _extend_stroke(self, x, y):
        st = self.current_stroke
        st["points"].append((x, y))
        st["line"].points += [x, y]

        bx = st["bbox"]
        bx[0] = min(bx[0], x)
        bx[1] = min(bx[1], y)
        bx[2] = max(bx[2], x)
        bx[3] = max(bx[3], y)

    # --------------------------------------------------
    # ERASER
    # --------------------------------------------------

    def _erase_at(self, cx, cy):
        r = self.eraser_radius

        # copy keys để remove an toàn
        for stroke_id in list(self.strokes.keys()):
            st = self.strokes[stroke_id]
            bx = st["bbox"]

            # 1) Lọc sớm bằng bbox
            if not self._circle_hits_bbox(cx, cy, r, bx):
                continue

            # 2) Kiểm tra chính xác với polyline
            pen_w = getattr(st["line"], "width", 1.0)
            if not self._circle_hits_polyline(cx, cy, r, st["points"], pen_w):
                continue

            # 3) Thật sự trúng → xoá stroke
            self._remove_stroke(stroke_id)

    def _remove_stroke(self, stroke_id):
        st = self.strokes.pop(norm_uuid_hyphen(stroke_id), None)
        if not st:
            return
        
        self.canvas.remove(st["group"])

        if hasattr(self, "on_stroke_deleted") and self.on_stroke_deleted:
            self.on_stroke_deleted(stroke_id)
            
    @staticmethod
    def _circle_hits_bbox(cx, cy, r, bbox):
        minx, miny, maxx, maxy = bbox
        nx = max(minx, min(cx, maxx))
        ny = max(miny, min(cy, maxy))
        dx = cx - nx
        dy = cy - ny
        return dx * dx + dy * dy <= r * r

    @staticmethod
    def _point_segment_dist2(px, py, x1, y1, x2, y2):
        """
        Bình phương khoảng cách từ điểm P(px, py) tới đoạn thẳng AB(x1, y1)-(x2, y2)
        """
        vx, vy = x2 - x1, y2 - y1
        wx, wy = px - x1, py - y1
        len2 = vx * vx + vy * vy
        if len2 == 0:
            # A trùng B: khoảng cách điểm-điểm
            dx, dy = px - x1, py - y1
            return dx * dx + dy * dy
        t = (wx * vx + wy * vy) / len2
        if t < 0:
            # gần A
            dx, dy = px - x1, py - y1
        elif t > 1:
            # gần B
            dx, dy = px - x2, py - y2
        else:
            # chiếu vuông góc xuống AB
            projx = x1 + t * vx
            projy = y1 + t * vy
            dx, dy = px - projx, py - projy
        return dx * dx + dy * dy

    @staticmethod
    def _circle_hits_polyline(cx, cy, r, points, pen_w=0.0):
        """
        Trả về True nếu vòng tròn eraser (cx, cy, r) chạm vào polyline 'points'.
        Có cộng thêm nửa bề rộng nét để cảm giác tẩy tự nhiên hơn.
        """
        if not points:
            return False
        # bán kính hiệu dụng
        eff_r = r + max(1.0, float(pen_w)) / 2.0
        r2 = eff_r * eff_r

        # kiểm từng đoạn
        for i in range(1, len(points)):
            x1, y1 = points[i - 1]
            x2, y2 = points[i]
            d2 = DrawCanvas._point_segment_dist2(cx, cy, x1, y1, x2, y2)
            if d2 <= r2:
                return True

        # kiểm luôn hai đầu mút (phòng vài stroke rất ngắn)
        dx, dy = cx - points[0][0], cy - points[0][1]
        if dx * dx + dy * dy <= r2:
            return True
        dx, dy = cx - points[-1][0], cy - points[-1][1]
        if dx * dx + dy * dy <= r2:
            return True

        return False

    # --------------------------------------------------
    # REALTIME API
    # --------------------------------------------------

    def draw_remote_stroke(self, payload):
        sid = norm_uuid_hyphen(payload["stroke_id"]) 

        if sid not in self.strokes:
            payload = dict(payload)
            payload["stroke_id"] = sid
            self._create_remote_stroke(payload)
            return

        st = self.strokes[sid]
        for x, y in payload["points"]:
            y = self.height - y
            st["points"].append((x, y))
            st["line"].points += [x, y]
            bx = st["bbox"]
            bx[0] = min(bx[0], x)
            bx[1] = min(bx[1], y)
            bx[2] = max(bx[2], x)
            bx[3] = max(bx[3], y)

    def _create_remote_stroke(self, payload):
        sid = norm_uuid_hyphen(payload["stroke_id"])
        pts = payload["points"]
        if not pts:
            return

        group = InstructionGroup()
        group.add(Color(*payload["color"]))
        fixed_pts = []
        for x, y in pts:
            fixed_pts.append((x, self.height - y))

        xs = [p[0] for p in fixed_pts]
        ys = [p[1] for p in fixed_pts]
        line = Line(
                points=[c for p in fixed_pts for c in p],
                width=dp(payload["width"]),
                cap="round",
                joint="round"
            )
        group.add(line)

        self.strokes[sid] = {
            "id": sid,
            "group": group,
            "line": line,
            "points": fixed_pts,
            "bbox": [min(xs), min(ys), max(xs), max(ys)],
        }

        self.canvas.add(group)

    def erase_remote_stroke(self, stroke_id):
        sid = norm_uuid_hyphen(stroke_id)
        if not sid:
            return
        self._remove_stroke(sid)

    def clear_all(self):
        # remove từng stroke khỏi canvas (KHÔNG canvas.clear)
        for st in list(self.strokes.values()):
            self.canvas.remove(st["group"])
        self.strokes.clear()
        self.current_stroke = None

class Whiteboard(MDFloatLayout):
    selected_widget_exists = BooleanProperty(False)
    def __init__(self, **kwargs):
        super().__init__(**kwargs)

        # stroke_id -> stroke
        self.strokes = {}

        self.current_stroke = None
        self.tool = "cursor"   # "pen" | "eraser"

        self.pen_color = (0, 0, 0, 1)
        self.pen_width = 2.5
        self.eraser_radius = 18
        self.md_bg_color='white'

        self.on_stroke_finished = None
        self.on_stroke_deleted = None

        self.selecting_widget = None

    # --- Selection helpers ---
    def is_widget_mode(self):
        return (self.tool == "cursor") and globals().get("todo_draw_mode", False)

    def set_selected_widget(self, widget):
        for child in self.children:
            if isinstance(child, DraggableResizableWidget): 
                if child is widget:
                    child.selected = True
                    self.selecting_widget = widget
                    self.selected_widget_exists = True
                    MDApp.get_running_app().set_widget_color_button.md_bg_color = child.md_bg_color
                    MDApp.get_running_app().set_widget_text_color_button.md_bg_color = child.text_color
                    MDApp.get_running_app().set_widget_line_color_button.md_bg_color = child.line_color
                    MDApp.get_running_app().set_text_size_slider.children[1].text=f"Cỡ chữ: {child.text_size:.1f}"
                    MDApp.get_running_app().set_text_size_slider.slider.value = child.text_size
                    MDApp.get_running_app().set_text_align_button.icon = f"format-align-{child.text_align}"
                else:
                    child.selected = False

    def deselect_all(self):
        if self.selected_widget_exists and self.selecting_widget:
            self.selected_widget_exists = False
            self.selecting_widget.selected = False
            self.selecting_widget = None
            MDApp.get_running_app().toolbar_return()
    # --------------------------------------------------
    # PEN / SELECTION
    # --------------------------------------------------

    def on_touch_down(self, touch):
        # Cho child xử lý trước (nếu click trúng một widget)
        if super().on_touch_down(touch):
            return True

        if self.is_widget_mode() and self.collide_point(*touch.pos):
            hit_any = False
            for child in self.children:
                if isinstance(child, DraggableResizableWidget) and child.collide_point(*touch.pos):
                    hit_any = True
                    break
            if not hit_any:
                self.deselect_all()
                return True  # chặn nổi bọt, hợp lý khi đang khóa scroll

        if not todo_draw_mode or self.tool == "cursor":
            return False

        if not self.collide_point(*touch.pos):
            return False

        wx, wy = self.to_local(*touch.pos)

        if self.tool == "pen":
            self._start_stroke(wx, wy)
            return True

        if self.tool == "eraser":
            self._erase_at(wx, wy)
            return True

        return False

    def on_touch_move(self, touch):        
        if not todo_draw_mode or self.tool == "cursor": return False
        
        if not self.collide_point(*touch.pos):
            return False

        wx, wy = self.to_local(*touch.pos)

        if self.tool == "pen" and self.current_stroke:
            self._extend_stroke(wx, wy)
            return True

        if self.tool == "eraser":
            self._erase_at(wx, wy)
            return True

        return False

    def on_touch_up(self, touch):
        if not todo_draw_mode or self.tool == "cursor": return False

        if self.tool == "pen" and self.current_stroke:
            if self.on_stroke_finished:
                self.on_stroke_finished(self.current_stroke)
        self.current_stroke = None
        return False

    def _start_stroke(self, x, y):
        stroke_id = norm_uuid_hyphen(str(uuid4().hex))

        group = InstructionGroup()
        group.add(Color(*self.pen_color))
        line = Line(
            points=[x, y],
            width=dp(self.pen_width),
            cap="round",
            joint="round"
        )
        group.add(line)

        stroke = {
            "id": stroke_id,
            "group": group,
            "line": line,
            "points": [(x, y)],
            "bbox": [x, y, x, y],  # minx, miny, maxx, maxy
        }

        self.strokes[stroke_id] = stroke
        self.canvas.add(group)
        self.current_stroke = stroke

    def _extend_stroke(self, x, y):
        st = self.current_stroke
        st["points"].append((x, y))
        st["line"].points += [x, y]

        bx = st["bbox"]
        bx[0] = min(bx[0], x)
        bx[1] = min(bx[1], y)
        bx[2] = max(bx[2], x)
        bx[3] = max(bx[3], y)

    # --------------------------------------------------
    # ERASER
    # --------------------------------------------------

    def _erase_at(self, cx, cy):
        r = self.eraser_radius

        for stroke_id in list(self.strokes.keys()):
            st = self.strokes[stroke_id]
            bx = st["bbox"]

            if not self._circle_hits_bbox(cx, cy, r, bx):
                continue

            pen_w = getattr(st["line"], "width", 1.0)
            if not self._circle_hits_polyline(cx, cy, r, st["points"], pen_w):
                continue

            self._remove_stroke(stroke_id)

    def _remove_stroke(self, stroke_id):
        st = self.strokes.pop(norm_uuid_hyphen(stroke_id), None)
        if not st:
            return
        
        self.canvas.remove(st["group"])

        if hasattr(self, "on_stroke_deleted") and self.on_stroke_deleted:
            self.on_stroke_deleted(stroke_id)
            
    @staticmethod
    def _circle_hits_bbox(cx, cy, r, bbox):
        minx, miny, maxx, maxy = bbox
        nx = max(minx, min(cx, maxx))
        ny = max(miny, min(cy, maxy))
        dx = cx - nx
        dy = cy - ny
        return dx * dx + dy * dy <= r * r

    @staticmethod
    def _point_segment_dist2(px, py, x1, y1, x2, y2):
        vx, vy = x2 - x1, y2 - y1
        wx, wy = px - x1, py - y1
        len2 = vx * vx + vy * vy
        if len2 == 0:
            dx, dy = px - x1, py - y1
            return dx * dx + dy * dy
        t = (wx * vx + wy * vy) / len2
        if t < 0:
            dx, dy = px - x1, py - y1
        elif t > 1:
            dx, dy = px - x2, py - y2
        else:
            projx = x1 + t * vx
            projy = y1 + t * vy
            dx, dy = px - projx, py - projy
        return dx * dx + dy * dy

    @staticmethod
    def _circle_hits_polyline(cx, cy, r, points, pen_w=0.0):
        if not points:
            return False
        eff_r = r + max(1.0, float(pen_w)) / 2.0
        r2 = eff_r * eff_r

        for i in range(1, len(points)):
            x1, y1 = points[i - 1]
            x2, y2 = points[i]
            d2 = Whiteboard._point_segment_dist2(cx, cy, x1, y1, x2, y2)
            if d2 <= r2:
                return True

        dx, dy = cx - points[0][0], cy - points[0][1]
        if dx * dx + dy * dy <= r2:
            return True
        dx, dy = cx - points[-1][0], cy - points[-1][1]
        if dx * dx + dy * dy <= r2:
            return True
        return False

    # --------------------------------------------------
    # REALTIME API
    # --------------------------------------------------

    def draw_remote_stroke(self, payload):
        sid = norm_uuid_hyphen(payload["stroke_id"]) 

        if sid not in self.strokes:
            payload = dict(payload)
            payload["stroke_id"] = sid
            self._create_remote_stroke(payload)
            return

        st = self.strokes[sid]
        for x, y in payload["points"]:
            st["points"].append((x, y))
            st["line"].points += [x, y]
            bx = st["bbox"]
            bx[0] = min(bx[0], x)
            bx[1] = min(bx[1], y)
            bx[2] = max(bx[2], x)
            bx[3] = max(bx[3], y)

    def _create_remote_stroke(self, payload):
        sid = norm_uuid_hyphen(payload["stroke_id"])
        pts = payload["points"]
        if not pts:
            return

        group = InstructionGroup()
        group.add(Color(*payload["color"]))
        fixed_pts = []
        for x, y in pts:
            fixed_pts.append((x, self.height - y))

        xs = [p[0] for p in fixed_pts]
        ys = [p[1] for p in fixed_pts]
        line = Line(
                points=[c for p in fixed_pts for c in p],
                width=dp(payload["width"]),
                cap="round",
                joint="round"
            )
        group.add(line)

        self.strokes[sid] = {
            "id": sid,
            "group": group,
            "line": line,
            "points": fixed_pts,
            "bbox": [min(xs), min(ys), max(xs), max(ys)],
        }

        self.canvas.add(group)

    def erase_remote_stroke(self, stroke_id):
        sid = norm_uuid_hyphen(stroke_id)
        if not sid:
            return
        self._remove_stroke(sid)

    def clear_all(self):
        # remove từng stroke khỏi canvas (KHÔNG canvas.clear)
        for st in list(self.strokes.values()):
            self.canvas.remove(st["group"])
        self.strokes.clear()
        self.current_stroke = None

    def on_widget_deleted(self, widget_id: str):
        # chuyển về ChatApp để xóa DB
        MDApp.get_running_app()._on_local_widget_deleted(widget_id)

class OverlayContainer(MDAnchorLayout):
    pass

class ToolButton(MDIconButton):
    tool = StringProperty('')

# --- ChatApp ---
class ChatApp(MDApp):
    def build(self):
        def _update_ref(*args):
            global REF_W, REF_H
            REF_W, REF_H = Window.size
        _update_ref()
        Window.bind(size=lambda *a: _update_ref())

        self.app_in_foreground = True

        self.icon="resources/img/Icon.png"
        self.title="luv"

        self.uid_button=MDFillRoundFlatButton(text="Menu", on_release=self.menu_open, md_bg_color=btn, text_color='white', pos_hint={"center_y": 0.5})
        self.last_date = None
        self.lookup = False
        self.lookup_date = datetime.strftime(datetime.now(), "%d/%m/%Y")
        self._reload_timer = None
        self._draw_queue = []
        self._draw_lock = threading.Lock()
        self._todo_draw_queue = []
        self._todo_draw_lock = threading.Lock()
        self.deleted_strokes = set()
        self.current_open_board=None
        # --- Widgets realtime state ---
        self.todo_widget_by_id = {}         # id (uuid str) -> DraggableResizableWidget
        self._widget_update_timers = {}     # id -> ClockEvent (debounce timers)
        self._suppress_widget_events = set()
        self.current_widget_format=None  # tạm tắt gửi PATCH khi đang "áp" sự kiện remote

        if os.path.exists("uid.txt"):
            with open("uid.txt", "r") as f:
                self.user_id = f.read().strip()
            self.uid_button.text = self.user_id
        else:
            self.user_id = None
            Clock.schedule_once(lambda dt: self.show_uid_dialog())

        layout = MDBoxLayout(orientation="vertical", padding=[dp(20), dp(10), dp(20), dp(35)], spacing=dp(10), md_bg_color=bg)
        todo_layout = MDBoxLayout(orientation="vertical", padding=[dp(20), dp(10), dp(20), dp(35)], spacing=dp(10), md_bg_color=bg)
        
        #-------------------------------------------------------------
        #                            Chat                            |
        #-------------------------------------------------------------

        self.top_bar = MDBoxLayout(size_hint=(1, None), height=dp(50), padding=dp(5), spacing=dp(10))
        self.top_icon = MDFillRoundFlatButton(
            text=format_text_with_fonts("\U0001F496 ngha và hmn", True),
            theme_text_color="Custom",
            text_color=primarycolor,
            md_bg_color=bg,
            on_release=self.update
        )
        self.top_label = MDFillRoundFlatButton(
            text="\u2600 <3 \u2B50",
            theme_text_color="Custom",
            line_color=btn,
            md_bg_color=boxbg,
            text_color=primarycolor,
            font_name="resources/fonts/seguiemj.ttf",
            on_release=self.change_text
        )
        self.top_bar.add_widget(self.top_icon)
        self.top_bar.add_widget(MDBoxLayout(size_hint=(1, 1)))
        self.top_bar.add_widget(self.top_label)
        self.top_bar.add_widget(self.uid_button)
        
        self.msg_scroll = ScrollView(do_scroll_x=False, size_hint=(1, 1))
        self.msg_list = MDBoxLayout(orientation="vertical", size_hint=(1, None), spacing=dp(10), padding=[0, dp(10), 0, dp(10)])
        self.container = OverlayContainer(size_hint=(1, None), anchor_y='top')
        self.draw_canvas = DrawCanvas()
        self.draw_canvas.size_hint = (None, None)
        self.draw_canvas.on_stroke_finished = self._on_local_stroke_finished
        self.draw_canvas.on_stroke_deleted = self._on_local_stroke_deleted
        self.msg_list.bind(minimum_height=self.msg_list.setter('height'))
        self.msg_list.bind(height=self.sync_overlay_height)
        self.msg_scroll.bind(scroll_y=self.on_scroll)
        self.container.add_widget(self.msg_list)
        self.container.add_widget(self.draw_canvas)
        self.msg_scroll.add_widget(self.container)
        
        self.input_card = MDCard(
            orientation="vertical",
            size_hint=(1, None),
            height=dp(70),
            padding=[dp(10), dp(10), dp(10), dp(10)],
            spacing=dp(10),
            radius=[dp(25), dp(25), dp(25), dp(25)],
            md_bg_color=boxbg,
            elevation=0
        )
        
        self.text_input = MDBoxLayout(size_hint=(1, None), height=dp(50), spacing=dp(5))
        self.text_input.input = LimitedTextField(
            hint_text="Viết lời iu thương vào đây nề <3",
            line_color_normal=boxbg,
            line_color_focus=boxbg,
            hint_text_color=[0.75 - i for i in primarycolor],
            hint_text_color_focus=primarycolor,
            text_color_focus=primarycolor,
            fill_color_normal=boxbg,
            mode="round",
            size_hint=(1, None),
            pos_hint={'center_y': 0.5},
            height=dp(30),
            multiline=False,
            font_name="resources/fonts/segoeui.ttf",
            on_text_validate=self.send_msg
        )
        
        self.text_input.button = MDIconButton(
            icon='send-variant',
            disabled=True,
            theme_icon_color="Custom",
            icon_color=btn,
            size_hint=(None, None),
            size=(dp(48), dp(48)),
            pos_hint={"right": 1, "bottom": 0},
            on_release=self.send_msg
        )

        self.text_input.add_widget(self.text_input.input)
        self.text_input.add_widget(self.text_input.button)
        self.input_card.add_widget(self.text_input)

        self.text_input.input.bind(text=self.on_text_change)

        self.noti=CustomMDBoxLayout(size_hint=(1, None), height=dp(0), padding=dp(5))
        self.noti.label=MDLabel(text="Có tin nhắn mới nề <3", pos_hint={"center_y": 0.5, "bottom": 0})
        self.noti.button=MDFillRoundFlatButton(text="Đọc thui", md_bg_color=btn, theme_text_color="Custom", text_color=bg, on_release=lambda instance: self.load_messages(instance=None), disabled=True)
        self.noti.add_widget(self.noti.label)
        self.noti.add_widget(self.noti.button)

        layout.add_widget(self.top_bar)
        layout.add_widget(MDBoxLayout(size_hint=(1, None), md_bg_color=btn, height=dp(2), pos_hint={"center_x": 0.5}))  # Spacer
        layout.add_widget(self.noti)    
        layout.add_widget(self.msg_scroll)
        layout.add_widget(self.input_card)

        #-------------------------------------------------------------
        #                           To-Do                            |
        #-------------------------------------------------------------

        self.todo_top_bar = MDBoxLayout(size_hint=(1, None), height=dp(50), padding=dp(5), spacing=dp(10))
        self.todo_top_icon = MDFillRoundFlatIconButton(
            icon="arrow-left",
            text=format_text_with_fonts("\U0001F496 ngha và hmn", True),
            theme_text_color="Custom",
            text_color=primarycolor,
            theme_icon_color="Custom",
            icon_color=primarycolor,
            md_bg_color=bg,
            on_release=lambda instance: setattr(self.sm, 'current', 'chat'),
            pos_hint={"center_y": 0.5}
        )
        self.todo_top_back = MDIconButton(
            icon="arrow-left",
            theme_icon_color="Custom",
            icon_color=primarycolor,
            md_bg_color=bg,
            on_release=self.load_todo_list,
            pos_hint={"center_y": 0.5}
        )
        self.todo_top_bar.add_widget(self.todo_top_icon)
        self.todo_top_bar.add_widget(MDBoxLayout(size_hint=(1, 1)))

        self.todo_new_whiteboard_button = MDFillRoundFlatIconButton(
            icon="plus",
            text="Thêm whiteboard mới",
            theme_text_color="Custom",
            text_color='white',
            theme_icon_color="Custom",
            icon_color='white',
            md_bg_color=btn,
            pos_hint={"center_x": 0.5},
            on_release=self.show_whiteboard_dialog
        )
        self.todo_scroll = ScrollView(size_hint=(1, 1), scroll_type=['bars', 'content'])
        self.todo_board = Whiteboard()
        self.todo_board.size_hint=(None, None)
        self.todo_board.height=dp(100000)
        self.todo_board.width=dp(100000)
        self.todo_board.on_stroke_finished = self._on_local_todo_stroke_finished
        self.todo_board.on_stroke_deleted = self._on_local_todo_stroke_deleted
        self.todo_board.bind(selected_widget_exists=self.format_widget_toolbar)
        self.todo_browse = MDBoxLayout(orientation="vertical", size_hint=(1, None), spacing=dp(10), padding=[0, dp(10), 0, dp(10)])
        self.todo_container = OverlayContainer(size_hint=(1, None), anchor_y='top')
        self.set_widget_color_button = MDCard(size_hint=(None, None), width=dp(20), height=dp(20), radius=dp(100), pos_hint={"center_y": 0.5}, line_width=dp(1.5), line_color=btn, on_release=lambda instance: self.open_color_picker(instance, "widget"))
        self.set_widget_text_color_button = MDCard(size_hint=(None, None), width=dp(20), height=dp(20), radius=dp(100), pos_hint={"center_y": 0.5}, line_width=dp(1.5), line_color=btn, on_release=lambda instance: self.open_color_picker(instance, "text"))
        self.set_widget_line_color_button = MDCard(size_hint=(None, None), width=dp(20), height=dp(20), radius=dp(100), pos_hint={"center_y": 0.5}, line_width=dp(1.5), line_color=btn, on_release=lambda instance: self.open_color_picker(instance, "line"))
        self.set_text_size_slider = MDBoxLayout(size_hint=(None, 1), width=dp(250))
        self.set_text_size_slider.slider = MDSlider(step=0.5, hint=False, color=boxbg, thumb_color_active=btn, thumb_color_inactive=btn, show_off=False, pos_hint={"center_y": 0.5}, min=8, max=120)
        self.set_text_size_slider.slider.bind(value=self.update_text_size_value)
        self.set_text_size_slider.add_widget(MDLabel(theme_text_color="Custom", text_color='white', size_hint=(None, 1), width=dp(100), font_style="Caption", halign="center", valign="center"))
